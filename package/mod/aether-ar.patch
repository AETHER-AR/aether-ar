+    void fighterList(const uint8_t *rdram, uint32_t &cnt, uint32_t &base)
+    {
+        const uint32_t l = rd32(rdram, 0x304270u - 0x575Cu) & 0x1FFFFFFFu;
+        const bool ok = l >= 0x100000u && l + 8u <= PS2_RAM_NATIVE_SIZE;
+        cnt = ok ? rd32(rdram, l) : 0u;
+        base = ok ? rd32(rdram, l + 4u) & 0x1FFFFFFFu : 0u;
