+def cross_function_reentries(modules: dict) -> dict:
+    """Every address a generated function leaves to with `ctx->pc = X; return;` that lies INSIDE another function
+    (not at its start) of any of the three modules and has no resume case there. The dispatcher enters such a
+    function at its START instead: a loop whose body runs on into a gap block and branches back into its truncated
+    predecessor restarts with its counters reset and never ends -- Sim Dragon hung that way at 0x36c5d0 (f_36c560 ->
+    gap f_36c610 -> back to 0x36c5d0, 26.10.) --, and a main function that branches forward into its gap block's
+    middle runs the block from its first instruction. Found by this scan, not by hand: 18 targets in the USA disc.
+    modules: stem -> lines. Returns stem -> sorted addresses (the module that holds each target)."""
+    import bisect
+    ranges = []   # (start, end, stem)
+    for stem in modules:
+        with open(HERE / f"{stem}.csv") as f:
+            for row in csv.DictReader(f):
+                ranges.append((int(row["start"], 16), int(row["end"], 16), stem))
+    ranges.sort()
+    starts = [r[0] for r in ranges]
+
+    def owner(a):
+        k = bisect.bisect_right(starts, a) - 1
+        return ranges[k] if k >= 0 and ranges[k][0] <= a < ranges[k][1] else None
+
+    cases = {}   # function start -> resume addresses in its switch
+    for tl in modules.values():
+        cur = None
+        for l in tl:
+            m = re.match(r"^void f_[0-9a-f]+_0x([0-9a-f]+)\(", l)
+            if m:
+                cur = int(m.group(1), 16); cases.setdefault(cur, set()); continue
+            c = re.search(r"case 0x([0-9a-f]+)u: goto", l)
+            if c and cur is not None:
+                cases[cur].add(int(c.group(1), 16))
+    found = {stem: set() for stem in modules}
+    for tl in modules.values():
+        cur = None
+        for k, l in enumerate(tl):
+            m = re.match(r"^void f_[0-9a-f]+_0x([0-9a-f]+)\(", l)
+            if m:
+                cur = int(m.group(1), 16); continue
+            m2 = re.match(r"^\s*ctx->pc = 0x([0-9A-Fa-f]+)u;\s*$", l)
+            if not m2 or k + 1 >= len(tl) or tl[k + 1].strip() != "return;":
+                continue
+            t = int(m2.group(1), 16)
+            o = owner(t)
+            if not o or t == o[0] or (cur is not None and o[0] <= cur < o[1]):
+                continue
+            if t not in cases.get(o[0], set()):
+                found[o[2]].add(t)
