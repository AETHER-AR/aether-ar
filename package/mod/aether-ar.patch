diff --git a/ps2xRuntime/src/lib/seamvk/arportal.frag b/ps2xRuntime/src/lib/seamvk/arportal.frag
new file mode 100644
index 0000000000000000000000000000000000000000..21137208d7a5bdb92d0121bdb8b99dc51b998e2e
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/arportal.frag
@@ -0,0 +1,108 @@
+#version 450
+// [arportal] The world takes the half of the room beyond the cut -- wall to wall, floor to ceiling -- the way the
+// Obelisk / Ra room infection does it (tools/unreal/obelisk_world/room_infection.hlsl, ported to metres): per pixel the
+// REAL shell of that half behind it (walls, floor, ceiling -- furniture is swallowed; its depth, uFar) is the canvas; a
+// front sweeps from the far wall towards the player, standing t.y metres beyond the cut. Ahead of it the real room (passthrough); in a 1.1 m band datamosh blocks of the new world
+// (30 cm far ahead, 6 cm at the front), scan lines, data traces and horizontal tears in Obelisk blue; behind it the
+// world, opaque. Along the cut itself a standing glitch edge stays (a third of the band). Fighters inside the real room
+// stay visible all along. From the world side (t.z = 1) the real room shows back through the cut.
+// Premultiplied, like the eye images.
+layout(push_constant) uniform PP { mat4 vp; vec4 src; vec4 t; vec4 org; vec4 plane; } p;   // t: time, radius m, far side, complete; org: point, units/m
+layout(std140, set = 0, binding = 4) uniform PU { mat4 inv; vec4 cam; } u;                 // this eye: clip -> game, its position
+layout(set = 0, binding = 0) uniform sampler2D uTex;     // the scene's colour
+layout(set = 0, binding = 1) uniform sampler2D uDepth;   // the scene's depth (reverse-Z: nearer = larger)
+layout(set = 0, binding = 2) uniform sampler2D uOcc;     // the player's half of the real room (depth)
+layout(set = 0, binding = 3) uniform sampler2D uFar;     // the world's half of the real room (depth)
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 o;
+
+void main()
+{
+    vec2 e = gl_FragCoord.xy * p.src.xy;      // eye image uv
+    vec2 s = e * p.src.zw;                    // the scene target's uv
+    float qd = gl_FragCoord.z;
+    float ds = texture(uDepth, s).r, dz = texture(uOcc, s).r, df = texture(uFar, s).r;
+    float upm = p.org.w;
+    if (p.t.z > 0.5)
+    {   // the player in the world: the arena between them and the cut stays as drawn; through it the real room
+        if (ds > qd + 1e-7) discard;
+        vec4 c = texture(uTex, s);
+        float a = ds > dz + 1e-7 ? 1.0 : 0.0;
+        a = max(a, clamp(max(c.r, max(c.g, c.b)) * 1.5, 0.0, 1.0));
+        o = vec4(c.rgb * a, a);
+        return;
+    }
+    if (qd <= dz)
+    {   // the player's half: a real surface in front of the cut. Near the cut the glitch spills onto it (walls, ceiling,
+        // floor of the real room, 0.7 m deep), once the front has reached the cut -- the seam is not only in the world
+        if (ds > dz + 1e-7 || dz <= 0.0) discard;   // a fighter in front of it
+        vec2 ndn = e * 2.0 - 1.0;
+        vec4 hn = u.inv * vec4(ndn, dz / 0.995, 1.0);
+        vec3 Pn = hn.xyz / hn.w, pn = Pn / upm;
+        float sideN = (dot(p.plane.xyz, Pn) + p.plane.w) / upm;   // < 0: metres in front of the cut
+        // 1.5 m deep with a ragged, crawling edge (coarse cells reach further now and then), densest at the cut
+        const float spill = 1.2;
+        float clockN = p.t.x, frameN = floor(clockN * 16.0);
+        vec3 cellN = floor(pn / 0.25);
+        float reach = fract(sin(dot(cellN + floor(clockN * 2.0) * 0.31, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
+        float k = clamp(1.0 + (sideN + reach * 0.45 - 0.1) / spill, 0.0, 1.0) * clamp(1.0 - p.t.y / 0.6, 0.0, 1.0);
+        if (k <= 0.0) discard;
+        float bsN = mix(0.14, 0.04, k * k);
+        float rndN = fract(sin(dot(floor(pn / bsN) + frameN * 0.173, vec3(4.31, 17.63, 83.27))) * 943.76);
+        float blocksN = step(1.0 - k * k * k * 0.9, rndN);   // dense at the cut, sparse further into the room
+        float edgeN = exp(sideN / 0.12);                                  // a bright seam right at the cut
+        float scanN = step(0.9, fract(pn.z * 21.0 - clockN * 2.6)) * k;
+        float traceN = step(0.95, fract((pn.x + pn.y) * 11.0 - clockN * 1.7)) * k;
+        float sparkN = edgeN * 0.9 + scanN * 0.35 + traceN * 0.5 + blocksN * 0.55;
+        vec3 tintN = mix(vec3(0.06, 0.5, 1.0), vec3(0.75, 0.92, 1.0), edgeN);
+        vec3 worldN = texture(uTex, s).rgb;
+        vec3 colN = blocksN > 0.5 && fract(rndN * 7.3) < 0.35 ? worldN * vec3(0.55, 0.85, 1.6) : tintN;   // some blocks carry the world
+        float aN = clamp(sparkN, 0.0, 1.0);
+        o = vec4(colN * aN, aN);
+        return;
+    }
+    if (ds > qd + 1e-7) discard;              // a fighter (or its effect) in front of the cut
+    if (df > 0.0 && ds > df * 1.03 && p.t.w < 0.5) discard;   // a fighter inside the real room beyond the cut: always seen
+    // the real point behind this pixel (game units): the world half's surface, or far along the ray if there is none
+    vec2 ndc = e * 2.0 - 1.0;
+    vec4 hq = u.inv * vec4(ndc, qd, 1.0);
+    vec3 onCut = hq.xyz / hq.w;
+    vec3 P;
+    if (df > 0.0) { vec4 h = u.inv * vec4(ndc, df, 1.0); P = h.xyz / h.w; }
+    else P = u.cam.xyz + normalize(onCut - u.cam.xyz) * 1000.0 * upm;
+    vec3 pm = P / upm;                        // metres (game axes)
+    float clock = p.t.x;
+    vec3 cell = floor(pm / 0.07);
+    float seed = fract(sin(dot(cell, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
+    float localDelay = seed * 0.24 + sin(pm.z * 4.9 + pm.x * 1.6 + pm.y * 2.3) * 0.12;
+    float side = (dot(p.plane.xyz, P) + p.plane.w) / upm;   // metres beyond the cut
+    // the front sweeps from the far wall towards the player: it stands t.y metres beyond the cut; deeper is the world
+    float front = p.t.w > 0.5 ? 1000000.0 : side - p.t.y - localDelay;
+    front = min(front, (side - seed * 0.08) * 3.0);          // the standing glitch edge along the cut
+    const float band = 1.1;
+    float ahead = clamp((front + band) / band, 0.0, 1.0);    // 0 far ahead of the front .. 1 at the front
+    float bs = mix(0.30, 0.06, ahead);                        // block size shrinks as the world resolves
+    float frame = floor(clock * 16.0);
+    vec3 bc = floor(pm / bs);
+    float rnd = fract(sin(dot(bc + frame * 0.173, vec3(4.31, 17.63, 83.27))) * 943.76);
+    float inBand = step(-band, front) * step(front, 0.0);
+    float blocks = inBand * step(1.0 - ahead * ahead * 0.85, rnd);   // datamosh: denser towards the front
+    float solid = smoothstep(-0.01, 0.02, front);
+    float fill = clamp(solid + blocks, 0.0, 1.0);
+    float edge = exp(-abs(front) / 0.14);
+    float scan = step(0.9, fract(pm.z * 21.0 - clock * 2.6)) * inBand;
+    float trace = step(0.95, fract((pm.x + pm.y) * 11.0 + seed - clock * 1.7)) * inBand;
+    float tear = step(0.82, fract(sin(floor(pm.z / 0.18) + frame * 7.1) * 91.7)) * inBand * (1.0 - ahead * 0.5);
+    float spark = edge * 0.9 + scan * 0.35 + trace * 0.5 + tear * 0.25 + blocks * 0.18;
+    vec3 tint = mix(vec3(0.06, 0.5, 1.0), vec3(0.75, 0.92, 1.0), edge);
+    vec3 world = texture(uTex, s).rgb;
+    if (ds <= 0.0 && max(world.r, max(world.g, world.b)) < 0.03)
+    {   // nothing of the arena here: its sky dome sits around the GAME camera and leaves gaps seen from the player --
+        // the arena's sky gradient by the ray's elevation (game up = -y)
+        float up = clamp(-normalize(onCut - u.cam.xyz).y, 0.0, 1.0);
+        world = mix(vec3(0.62, 0.78, 0.95), vec3(0.08, 0.27, 0.78), pow(up, 0.6));
+    }
+    vec3 sceneTint = world * mix(vec3(0.55, 0.85, 1.6), vec3(1.0), solid);   // fresh blocks still read digital
+    float alpha = clamp(fill + spark * (1.0 - fill), 0.0, 1.0);
+    o = vec4(sceneTint * fill + tint * spark * (1.0 - fill * 0.6), alpha);
+}
