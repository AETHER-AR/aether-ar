+# Report a problem: what a helper needs, in one ZIP on the desktop -- testers had to find build\ps2xRuntime\logs
+# themselves (audit 01.11.)
+function Save-Report {
+    $zip = Join-Path ([Environment]::GetFolderPath('Desktop')) ("AETHER-AR-report-{0}.zip" -f (Get-Date -Format 'yyyy-MM-dd'))
+    $stage = Join-Path $env:TEMP "AETHER-AR-report-$PID"
+    Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
+    New-Item -ItemType Directory -Force -Path $stage | Out-Null
+    $logs = Join-Path $root 'build\ps2xRuntime\logs'
+    $files = [ordered]@{ 'status.txt' = $statusFile; 'config.json' = $cfgPath; 'install.log' = $installLog; 'setup.log' = (Join-Path $root 'build\setup.log')
+                         'bt3.log' = (Join-Path $logs 'bt3.log'); 'bt3.prev.log' = (Join-Path $logs 'bt3.prev.log'); 'ar-error.txt' = $gameErr; 'launcher-error.txt' = $launcherErr
+                         'wincrash.txt' = (Join-Path $logs 'wincrash.txt') }   # (the game's own crash record: module, offset, call stack)
+    foreach ($name in $files.Keys) {
+        $src = $files[$name]; if (-not (Test-Path -LiteralPath $src -PathType Leaf)) { continue }
+        # (copied with sharing: the running game keeps bt3.log open for writing)
+        try {
+            $in = [IO.File]::Open($src, 'Open', 'Read', 'ReadWrite')
+            try { $out = [IO.File]::Create((Join-Path $stage $name)); try { $in.CopyTo($out) } finally { $out.Dispose() } } finally { $in.Dispose() }
+        } catch { }
+    }
+    # what this window shows right now
+    $os = $(try { (Get-CimInstance Win32_OperatingSystem -ErrorAction Stop | ForEach-Object { "$($_.Caption) $($_.Version)" }) } catch { '' })
+    # (the edge fix as Link sees it: the user variable and when Link's server started)
+    $e = Edge-State
+    $edgeRaw = $(if ($e) { "Link edge variable (user): $(if ($null -eq $e.Value) { 'not set' } else { "'$($e.Value)'" }); set by AETHER AR: $(if ($e.SetAt) { $e.SetAt.ToString('o') } else { 'no' }); OVRServer_x64 started: $(if ($e.ServerStart) { $e.ServerStart.ToString('o') } elseif ($e.Running) { 'running, time unknown' } else { 'not running' }); restart tried: $($e.Tried)" } else { 'Link edge variable: cannot be read' })
+    $lines = @("AETHER AR $version", "Report made $(Get-Date -Format 'yyyy-MM-dd HH:mm')", "Windows: $os", "OpenXR runtime: $(OpenXR-Runtime)",
+               $lblDisc.Text, $lblLink.Text, $lblEdge.Text, $edgeRaw, $hs.Text, "Status: $($runState.Text)", "Mode: $($mode.Text)", "Quick start: $($quick.Checked)", "Boundary off: $($bound.Checked)", "Edge fix option: $($edgeFix.Checked)")
+    [IO.File]::WriteAllText((Join-Path $stage 'window.txt'), (($lines -join "`r`n") + "`r`n"))
+    # [report] the PC around the game (1.0.15: a crash on other graphics cards could not be told apart without them):
+    # graphics cards + drivers, processor, memory, the crashes Windows recorded for the game, the headset model and Link's
+    # own measurements (picked fields only -- no machine or session ids). Each part on its own: one that fails is said.
+    $pc = New-Object System.Collections.Generic.List[string]
+    try { foreach ($v in @(Get-CimInstance Win32_VideoController -ErrorAction Stop)) { $pc.Add("Graphics: $($v.Name), driver $($v.DriverVersion)$(if ($v.DriverDate) { ' (' + $v.DriverDate.ToString('yyyy-MM-dd') + ')' })") } } catch { $pc.Add("Graphics: cannot be read ($($_.Exception.Message))") }
+    try { foreach ($c in @(Get-CimInstance Win32_Processor -ErrorAction Stop)) { $pc.Add("Processor: $($c.Name.Trim())") } } catch { $pc.Add('Processor: cannot be read') }
+    try { $pc.Add(('Memory: {0:0} GB' -f ((Get-CimInstance Win32_ComputerSystem -ErrorAction Stop).TotalPhysicalMemory / 1GB))) } catch { $pc.Add('Memory: cannot be read') }
+    try {
+        $lg = Get-ChildItem -LiteralPath (Join-Path $env:LOCALAPPDATA 'Oculus') -Filter 'Service_*.txt' -ErrorAction Stop | Sort-Object LastWriteTime -Descending | Select-Object -First 1
+        if ($lg) {
+            $pc.Add("Link service log: $($lg.Name)")
+            $hmd = Select-String -LiteralPath $lg.FullName -Pattern 'product name:' | Select-Object -Last 1
+            $pc.Add('Headset: ' + $(if ($hmd) { ($hmd.Line -replace '.*product name:\s*', '').Trim() } else { 'not in the log' }))
+            $keys = 'connected_hmd_type', 'transmission_type', 'codec', 'encode_width', 'encode_height', 'network_rtt_ms_p50', 'network_rtt_ms_p99', 'total_network_video_goodput_Mbps', 'num_lost_or_late_pc_presented_frames_with_high_cpu', 'pc_present_late'
+            foreach ($s in @(Select-String -LiteralPath $lg.FullName -Pattern 'oculus_pc_xrs_stats_event' | Select-Object -Last 6)) {
+                $vals = foreach ($k in $keys) { $m = [regex]::Match($s.Line, "[{ ,]$k=([^,}]*)"); if ($m.Success) { "$k=$($m.Groups[1].Value)" } }
+                $pc.Add("Link stats $(($s.Line -split ' ')[1]): $($vals -join ' ')")
+            }
+        } else { $pc.Add('Link service log: none found') }
+    } catch { $pc.Add("Link service log: cannot be read ($($_.Exception.Message))") }
+    try {
+        $ev = @(Get-WinEvent -FilterHashtable @{ LogName = 'Application'; ProviderName = 'Application Error'; StartTime = (Get-Date).AddDays(-30) } -MaxEvents 400 -ErrorAction Stop | Where-Object { $_.Message -match 'ps2EntryRunner' } | Select-Object -First 5)
+        $pc.Add("Windows crash records for the game (last 30 days): $($ev.Count)")
+        foreach ($x in $ev) { $pc.Add("--- $($x.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss'))"); $pc.Add(($x.Message -replace "`r", '').Trim()) }
+    } catch { $pc.Add('Windows crash records for the game (last 30 days): none') }
+    [IO.File]::WriteAllLines((Join-Path $stage 'pc.txt'), [string[]]$pc)
+    Remove-Item -LiteralPath $zip -Force -ErrorAction SilentlyContinue
+    Add-Type -AssemblyName System.IO.Compression.FileSystem
+    [IO.Compression.ZipFile]::CreateFromDirectory($stage, $zip)
+    Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
+    return $zip
+}
