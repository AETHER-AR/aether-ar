diff --git a/ps2xRuntime/src/lib/seamvk/gs.vert b/ps2xRuntime/src/lib/seamvk/gs.vert
index b245238b20bdc6a4d8c7ad3c0ed5a9a1423e4a84..7ef33a90c7067052ff15b5f30f889de500ea30d7 100644
--- a/ps2xRuntime/src/lib/seamvk/gs.vert
+++ b/ps2xRuntime/src/lib/seamvk/gs.vert
@@ -6,6 +6,13 @@ layout(location = 2) in vec4 inCol;   // rgba bytes / 255
 layout(location = 3) in float inFog;
 layout(location = 4) in uvec2 inRect;   // [spriterect] packed texel rect of the sprite (0 = none)
 #include "pc.glsl"
+// [arcam] EE-built 3D effects (trails, billboards, beams): the GS vertex (pixel x/y incl. XYOFFSET, GS z) is taken back
+// to the world through the game camera's inverse screen matrix and drawn through the AR camera. p.x = on, p.yz = the
+// displayed region in target pixels, q.xy = XYOFFSET in GS pixels.
+// [arportal] p.w = 1: distant scenery of the arena, drawn only behind the portal's cut (pl as in seam.vert)
+layout(std140, set = 0, binding = 5) uniform ArGs { vec4 inv[4]; vec4 vp[4]; vec4 p; vec4 q; vec4 pl[6]; } ar;
+out float gl_ClipDistance[6];
+vec4 arXf(vec4 r[4], vec4 v) { return r[0] * v.x + r[1] * v.y + r[2] * v.z + r[3] * v.w; }
 layout(location = 0) out vec4 vColor;
 layout(location = 1) out vec3 vTex;   // (s, t, q) or (u, v, 1)
 layout(location = 2) out float vLit;
@@ -20,6 +27,15 @@ void main()
     // position, so its depth-mask pass is one row off from this; nothing visible depends on that row.)
     vec2 ndc = vec2(inPos.x / pc.view.z * 2.0 - 1.0, inPos.y / pc.view.w * 2.0 - 1.0);
     gl_Position = vec4(ndc, inPos.z, 1.0);
+    for (int k = 0; k < 6; ++k) gl_ClipDistance[k] = 1.0;
+    if (ar.p.x > 0.5)
+    {
+        vec4 h = arXf(ar.inv, vec4(inPos.x + ar.q.x, inPos.y + ar.q.y, inPos.z * 16777216.0, 1.0));
+        vec4 cl = arXf(ar.vp, vec4(h.xyz / h.w, 1.0));
+        vec2 tpx = (cl.xy * 0.5 + 0.5 * cl.w) * ar.p.yz;
+        gl_Position = vec4(tpx / pc.view.zw * 2.0 - cl.w, cl.z, cl.w);
+        if (ar.p.w > 0.5) for (int k = 0; k < 4; ++k) gl_ClipDistance[k] = dot(ar.pl[k].xyz, h.xyz / h.w) + ar.pl[k].w;
+    }
     vColor = inCol;
     vTex = ((pc.fA.x & 2) != 0) ? vec3(inTex.z, inTex.w, 1.0) : vec3(inTex.x, inTex.y, inPos.w);
     vLit = 1.0;
