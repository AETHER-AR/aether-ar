+function Run-Install([bool]$repair) {
+    # (-LiteralPath: "Dragon Ball Z [SLUS-21678].iso" is a file name, not a wildcard -- release audit 31.10.; quotes and
+    # spaces around it go: Windows' "Copy as path" pastes it in quotes)
