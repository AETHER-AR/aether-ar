diff --git a/ps2xRuntime/src/lib/ps2_stepcensus.cpp b/ps2xRuntime/src/lib/ps2_stepcensus.cpp
index c086d76b6247e280a0864bb6bc17ff9c57071866..a000c4c2ca0a80ca4b604b5c171d2b980139a011 100644
--- a/ps2xRuntime/src/lib/ps2_stepcensus.cpp
+++ b/ps2xRuntime/src/lib/ps2_stepcensus.cpp
@@ -7,6 +7,7 @@
 // g_bt3FrameCount. The table is a direct-mapped array over the EE code range, so the per-store cost is a few
 // loads; expect the guest to run several times slower while it is on.
 #include "ps2_runtime.h"
+#include <algorithm>
 #include <atomic>
 #include <cmath>
 #include <cstdio>
@@ -743,3 +744,69 @@ void ps2HalfStepFrame(const R5900Context *ctx)
                      (unsigned long long)g_hsOneShot.exchange(0));
     }
 }
+
+// [readwatch] PS2X_READWATCH=<lo>:<hi>[,<lo>:<hi>..]: who LOADS from these guest ranges. Per (range, last-branch pc,
+// $ra) a count and the touched address span; every 300 frames the busiest sites of that window are printed and the
+// counts reset (a site's first appearance is flagged NEW). Found the stage-collision readers this way.
+std::atomic<uint32_t> g_ps2ReadWatchOn{0};
+namespace
+{
+    struct RwStat { uint64_t n = 0; uint32_t lo = 0xFFFFFFFFu, hi = 0; bool printed = false; };
+    uint32_t g_rwRange[4][2] = {}; int g_rwN = 0;
+    std::mutex g_rwMtx;
+    std::unordered_map<uint64_t, RwStat> g_rw;
+}
+void ps2ReadWatchEnable(const char *spec)
+{
+    std::string t(spec); size_t p0 = 0;
+    while (p0 < t.size() && g_rwN < 4)
+    {
+        size_t p1 = t.find(',', p0); if (p1 == std::string::npos) p1 = t.size();
+        std::string r = t.substr(p0, p1 - p0); size_t c = r.find(':');
+        if (c != std::string::npos)
+        {
+            g_rwRange[g_rwN][0] = (uint32_t)std::strtoul(r.c_str(), nullptr, 16) & 0x1FFFFFFFu;
+            g_rwRange[g_rwN][1] = (uint32_t)std::strtoul(r.c_str() + c + 1, nullptr, 16) & 0x1FFFFFFFu;
+            std::fprintf(stderr, "[readwatch] range %d: 0x%x..0x%x\n", g_rwN, g_rwRange[g_rwN][0], g_rwRange[g_rwN][1]);
+            ++g_rwN;
+        }
+        p0 = p1 + 1;
+    }
+    if (g_rwN) g_ps2ReadWatchOn.store(1u, std::memory_order_relaxed);
+}
+void ps2ReadWatchHit(uint32_t guestAddr, uint32_t size, const R5900Context *ctx)
+{
+    const uint32_t a = guestAddr & 0x1FFFFFFFu;
+    for (int r = 0; r < g_rwN; ++r)
+    {
+        if (a + size <= g_rwRange[r][0] || a >= g_rwRange[r][1]) continue;
+        const uint32_t pc = ctx ? ctx->pc : 0u, ra = ctx ? (uint32_t)ctx->r[31][0] : 0u;
+        const uint64_t key = ((uint64_t)pc << 32) | ((uint64_t)r << 30) | (ra & 0x3FFFFFFFu);
+        std::lock_guard<std::mutex> lk(g_rwMtx);
+        RwStat &s = g_rw[key];
+        ++s.n; if (a < s.lo) s.lo = a; if (a > s.hi) s.hi = a;
+        return;
+    }
+}
+void ps2ReadWatchFrame()
+{
+    if (!g_ps2ReadWatchOn.load(std::memory_order_relaxed)) return;
+    const uint64_t fr = g_bt3FrameCount.load(std::memory_order_relaxed);
+    static uint64_t s_last = 0;
+    if (fr - s_last < 300u) return;
+    s_last = fr;
+    std::vector<std::pair<uint64_t, RwStat *>> v;
+    std::lock_guard<std::mutex> lk(g_rwMtx);
+    for (auto &kv : g_rw) if (kv.second.n) v.push_back({ kv.first, &kv.second });
+    std::sort(v.begin(), v.end(), [](const auto &x, const auto &y) { return x.second->n > y.second->n; });
+    std::fprintf(stderr, "[readwatch] frame %llu: %zu sites\n", (unsigned long long)fr, v.size());
+    for (size_t i = 0; i < v.size(); ++i)
+    {
+        if (i >= 40 && v[i].second->printed) continue;   // beyond the top 40: only sites never reported before
+        RwStat &s = *v[i].second; const uint64_t k = v[i].first;
+        std::fprintf(stderr, "[readwatch]   r%u pc=0x%06x ra=0x%06x n=%llu span 0x%x..0x%x%s\n", (unsigned)((k >> 30) & 3u), (unsigned)(k >> 32), (unsigned)(k & 0x3FFFFFFFu),
+                     (unsigned long long)s.n, s.lo, s.hi, s.printed ? "" : " NEW");
+        s.printed = true;
+    }
+    for (auto &kv : g_rw) { kv.second.n = 0; kv.second.lo = 0xFFFFFFFFu; kv.second.hi = 0; }
+}
