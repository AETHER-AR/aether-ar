+function Read-Cfg { if (Test-Path $cfgPath) { try { return Get-Content $cfgPath -Raw | ConvertFrom-Json } catch {} }; return $null }
+function Set-Cfg([hashtable]$changes) {
+    $c = Read-Cfg; if (-not $c) { return }
+    foreach ($k in $changes.Keys) { if ($c.PSObject.Properties.Name -contains $k) { $c.$k = $changes[$k] } else { $c | Add-Member -NotePropertyName $k -NotePropertyValue $changes[$k] } }
+    $c | ConvertTo-Json | Set-Content -Encoding UTF8 $cfgPath
+}
+function Opt($c, $name, $default) { if ($c -and $c.PSObject.Properties.Name -contains $name -and $null -ne $c.$name -and "$($c.$name)" -ne '') { return $c.$name }; return $default }
+# a real adb.exe: not in the temp folder, and no file description (Google ships none; a program merely named adb.exe
+# -- a test dummy was ping.exe, "TCP/IP Ping Command" -- has one)
+function Is-RealAdb($p) {
+    if (-not $p -or -not (Test-Path -LiteralPath $p -PathType Leaf)) { return $false }
+    foreach ($tmp in @([IO.Path]::GetTempPath(), $env:TEMP)) { if ($tmp -and $p.StartsWith($tmp.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) { return $false } }
+    try { return -not [Diagnostics.FileVersionInfo]::GetVersionInfo($p).FileDescription } catch { return $false }
+}
+function Find-Adb {
+    # an adb server that already runs first: a client of another version restarts the server and cuts off every
+    # other program using it (Android Studio, Unity, SideQuest). Ours (config / ar\platform-tools) before any other,
+    # and no adb.exe that is not one (01.11.: a dummy adb.exe froze the window)
+    $c = Read-Cfg
+    $own = @(@($(if ($c) { "$($c.adb)" }), (Join-Path $ar 'platform-tools\adb.exe')) | Where-Object { $_ })
+    $run = @(Get-Process adb -ErrorAction SilentlyContinue | Where-Object { $_.Path } | ForEach-Object { $_.Path } | Select-Object -Unique)
+    foreach ($p in $run) { if ($own -contains $p -and (Is-RealAdb $p)) { return $p } }
+    foreach ($p in $run) { if (Is-RealAdb $p) { return $p } }
+    foreach ($p in $own) { if (Is-RealAdb $p) { return $p } }
+    $g = Get-Command adb -ErrorAction SilentlyContinue | Select-Object -First 1; if ($g -and (Is-RealAdb $g.Source)) { return $g.Source }
+    return $null
+}
+# a program run hidden with a time limit: its output, or $null when it did not finish in time (then killed). Every adb
+# call goes through it -- the status tick ran "& adb" on the window's thread with no limit, and a hung adb server, a
+# stalled Wi-Fi connection or a wrong adb.exe froze the whole window (01.11.)
+function Run-Exe([string]$file, [string[]]$a, [int]$ms) {
+    $psi = New-Object System.Diagnostics.ProcessStartInfo($file)
+    $psi.Arguments = (@($a | ForEach-Object { if ($_ -eq '' -or $_ -match '[\s"]') { '"' + ($_ -replace '"', '\"') + '"' } else { $_ } })) -join ' '
+    $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true; $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true
+    $p = $null
+    try {
+        $p = [System.Diagnostics.Process]::Start($psi)
+        $out = $p.StandardOutput.ReadToEndAsync(); $null = $p.StandardError.ReadToEndAsync()
+        if (-not $p.WaitForExit([Math]::Max(1, $ms))) { try { $p.Kill() } catch { }; return $null }
+        if (-not $out.Wait(1000)) { return '' }   # (a server it started that holds the pipe: never waited for)
+        return (@($out.Result -split "`r?`n") | Where-Object { $_ -ne '' }) -join "`n"
+    } catch { return '' } finally { if ($p) { $p.Dispose() } }
+}
+# adb with a limit (3 s by default); after a call that did not answer, adb is left alone for 20 s (else every tick
+# froze the window for the full limit) -- -Force for Stop's boundary reset
+$script:adbQuietUntil = [datetime]::MinValue
+function Adb([string[]]$a, [int]$ms = 3000, [switch]$Force) {
+    if (-not $Force -and [datetime]::UtcNow -lt $script:adbQuietUntil) { return '' }
+    $adb = Find-Adb; if (-not $adb) { return '' }
+    $r = Run-Exe $adb $a $ms
+    if ($null -eq $r) { $script:adbQuietUntil = [datetime]::UtcNow.AddSeconds(20); return '' }
+    return $r
+}
+function Adb-NoAnswer { return [datetime]::UtcNow -lt $script:adbQuietUntil }
+# the headsets adb sees ("device", not "unauthorized" / "offline")
+function Adb-Devices([switch]$Force) { @(((Adb @('devices') -Force:$Force) -split "`n") | Where-Object { $_ -match "`tdevice$" } | ForEach-Object { ($_ -split "`t")[0] }) }
+function Installed { return (Test-Path $exe) -and (Test-Path (Join-Path $root 'games\bt3\work\SLUS_216.78')) -and (Read-Cfg) }
+function Game-Procs { Get-Process ps2EntryRunner -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq $exe } }
+# the start script of THIS install (it waits for the headset before the game appears: a second Start then started a
+# second game -- release audit 31.10.)
+function Start-Procs { @(Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -and $_.CommandLine.Contains("$ar\start-ar.ps1") }) }
+function Is-Active { return [bool](@(Start-Procs).Count -or @(Game-Procs).Count) }
+# The PC's active OpenXR runtime must be Meta's Link: with SteamVR / Virtual Desktop / none the headset showed a black
+# void and no room, without a word (release audit 31.10.). The PC app is "Meta Horizon Link" since 2026 (formerly Meta
+# Quest Link; the labels below are the ones its 1.115 shows).
+function OpenXR-Runtime { try { return "$((Get-ItemProperty 'HKLM:\SOFTWARE\Khronos\OpenXR\1' -ErrorAction Stop).ActiveRuntime)" } catch { return '' } }
+# what to do, or '' when it is fine
+function OpenXR-Problem {
+    $rt = OpenXR-Runtime
+    if (-not $rt) { return "No OpenXR runtime is set up on this PC. Install the Meta Horizon Link app (formerly Meta Quest Link; meta.com/quest/setup), open it, and make it the OpenXR runtime: Settings > General > OpenXR Runtime > Set Meta Horizon Link as active. Then press Start again." }
+    if ($rt -notmatch 'oculus|meta') { return "The PC's active OpenXR runtime is`n$rt`n`nAETHER AR needs Meta Horizon Link: in the Meta Horizon Link app on this PC (formerly Meta Quest Link) open Settings > General > OpenXR Runtime > Set Meta Horizon Link as active. Then press Start again." }
+    return ''
+}
+# The Link app's Beta settings, read on this PC before Start: with one of them off the game quit seconds after Start,
+# its reason in a box on this monitor while the player was already in the headset (audit 01.11.). The app keeps them as
+# DWORDs, missing = never turned on: ExperimentalExtensions = "Developer runtime features", PassthroughOverLink,
+# SpatialDataOverLink (that one only for the room mode). Its service must run too. A box, not a lock: a renamed value in
+# a later Link version must never keep anyone from playing ("Start anyway?").
+function Link-Problems([bool]$room) {
+    $k = $null; try { $k = Get-ItemProperty 'HKCU:\Software\Oculus VR, LLC\Oculus' -ErrorAction Stop } catch { }
+    $want = [ordered]@{ ExperimentalExtensions = 'Developer runtime features'; PassthroughOverLink = 'Passthrough over Meta Horizon Link' }
+    if ($room) { $want.SpatialDataOverLink = 'Spatial data over Meta Horizon Link' }
+    $off = @(); foreach ($n in $want.Keys) { $v = $null; if ($k) { $v = $k.$n }; if ("$v" -ne '1') { $off += $want[$n] } }
+    $svc = Get-Service OVRService -ErrorAction SilentlyContinue
+    return [pscustomobject]@{ Off = $off; NotRunning = (-not $svc -or $svc.Status -ne 'Running') }
+}
