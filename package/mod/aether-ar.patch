+    // [armenu] the floating game screen: a swapchain of the game's output size, made on first use
+    Vulkan::ImageView *acquireMenu(uint32_t w, uint32_t h, bool hud)
+    {
+        if (!g.inFrame || !g.frame.shouldRender || !g.viewsValid || !g.dev) return nullptr;
+        if (hud != g.menuHud) { g.menuHud = hud; g.menuLastShown = 0; g.menuHasImage = false; }   // place the other panel anew
+        // the swapchain is sized in steps of 64 px and the shown rect inside it is the requested size: the HUD region
+        // wobbles by a pixel (511/512) and recreated the swapchain every other frame (21.10.)
+        g.menuRectW = w; g.menuRectH = h;
+        w = (w + 63u) & ~63u; h = (h + 63u) & ~63u;
+        if (!g.menuSc || g.menuW != w || g.menuH != h)
+        {
+            if (g.menuSc) { g.menuViews.clear(); g.menuImg.clear(); xrDestroySwapchain(g.menuSc); g.menuSc = XR_NULL_HANDLE; }
+            g.menuHasImage = false;
+            XrSwapchainCreateInfo ci{ XR_TYPE_SWAPCHAIN_CREATE_INFO };
+            ci.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT | XR_SWAPCHAIN_USAGE_MUTABLE_FORMAT_BIT;
+            ci.format = g.scFormat; ci.sampleCount = 1; ci.width = w; ci.height = h; ci.faceCount = 1; ci.arraySize = 1; ci.mipCount = 1;
+            if (!check(xrCreateSwapchain(g.session, &ci, &g.menuSc), "xrCreateSwapchain (menu screen)")) { g.menuSc = XR_NULL_HANDLE; return nullptr; }
+            uint32_t ni = 0; xrEnumerateSwapchainImages(g.menuSc, 0, &ni, nullptr);
+            std::vector<XrSwapchainImageVulkan2KHR> im(ni, { XR_TYPE_SWAPCHAIN_IMAGE_VULKAN2_KHR });
+            xrEnumerateSwapchainImages(g.menuSc, ni, &ni, reinterpret_cast<XrSwapchainImageBaseHeader *>(im.data()));
+            for (const auto &i : im)
+            {
+                Vulkan::ImageCreateInfo info = Vulkan::ImageCreateInfo::render_target(w, h, VkFormat(g.scFormat));
+                info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT; info.initial_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+                info.misc |= Vulkan::IMAGE_MISC_MUTABLE_SRGB_BIT;
