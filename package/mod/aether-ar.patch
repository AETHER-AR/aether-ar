+    # install: a European disc, a CHD or a zipped image went straight to the game (release audit 31.10.)
+    $c = Read-Cfg
+    $iso.Text = $iso.Text.Trim().Trim('"').Trim()   # (pasted with "Copy as path": in quotes)
+    # (-LiteralPath: [ ] in the ISO's name are no wildcards -- release audit 31.10.)
+    if ($iso.Text -and (Test-Path -LiteralPath $iso.Text -PathType Leaf) -and $iso.Text -ne $c.iso) { if (-not (Use-Iso $iso.Text)) { return } }
+    elseif ($iso.Text -and $iso.Text -ne $c.iso) {   # (a mistyped path: not quietly the old ISO instead)
+        Say-Box "There is no file '$($iso.Text)'. Press Change disc... and pick your ISO, then press Start." | Out-Null; $iso.Text = "$($c.iso)"; return
+    }
+    $isoNow = (Read-Cfg).iso
+    if (-not $isoNow -or -not (Test-Path -LiteralPath $isoNow -PathType Leaf)) { Say-Box "Your ISO is not at '$isoNow' any more. Press Change disc... and pick it (or plug its drive in), then press Start." | Out-Null; return }
+    # the Link passthrough edge fix read by Link before the game starts: once per change, after every other check (no
+    # Link restart for a start that stops at the disc)
