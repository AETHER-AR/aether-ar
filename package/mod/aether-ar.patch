+    struct V3 { float x, y, z; };
+    V3 sub(V3 a, V3 b) { return { a.x - b.x, a.y - b.y, a.z - b.z }; }
+    V3 cross(V3 a, V3 b) { return { a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x }; }
+    float dot(V3 a, V3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
+    // room (metres, y up) -> game: centred on the origin, turned about up, scaled, (x, y, z) -> (x, -y, -z)
+    V3 toGameP(V3 p, V3 origin, float cy, float sy, float s) { const V3 r{ p.x - origin.x, p.y - origin.y, p.z - origin.z }; return { (cy * r.x + sy * r.z) * s, -r.y * s, -(-sy * r.x + cy * r.z) * s }; }
