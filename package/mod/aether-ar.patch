+    $need = 8; foreach ($r in $rows) { if ($r[1]) { $need += $r[0].Height } }
+    Fit-Window $need
+    $y = $f.AutoScrollPosition.Y
+    foreach ($r in $rows) { $r[0].Visible = $r[1]; if ($r[1]) { $r[0].Top = $y; $y += $r[0].Height } }
+}
