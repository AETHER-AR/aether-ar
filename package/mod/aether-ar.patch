+void arRoomAddMesh(const float *roomTris, size_t count)
+{
+    std::vector<V3> m; m.reserve(count * 3);
+    for (size_t i = 0; i < count * 3; ++i) m.push_back({ roomTris[i * 3], roomTris[i * 3 + 1], roomTris[i * 3 + 2] });
+    // the room's code wants every triangle wound counter-clockwise seen from the open side (floor normals up); the
+    // mesh's own winding is not documented, so it is read off the floor: the lowest flat triangles must face up
+    float minY = 1e9f; for (const V3 &p : m) minY = std::min(minY, p.y);
+    double up = 0.0;
+    for (size_t t = 0; t + 2 < m.size(); t += 3)
+    {
+        const V3 n = cross(sub(m[t + 1], m[t]), sub(m[t + 2], m[t])); const float l = std::sqrt(dot(n, n));
+        if (!(l > 0.0f) || std::fabs(n.y / l) < 0.9f || (m[t].y + m[t + 1].y + m[t + 2].y) / 3.0f > minY + 0.15f) continue;
+        up += n.y / l;
+    }
+    const bool flip = up < 0.0;
+    if (flip) for (size_t t = 0; t + 2 < m.size(); t += 3) std::swap(m[t + 1], m[t + 2]);
+    {   // the mesh came tilted against the Space Setup planes (6.6 deg, floor and ceiling alike, 26.10.: fighters stood
+        // 25 cm under the real floor in one corner): its own floor -- the lowest large flat layer, fitted as a plane
+        // y = a x + c z + d -- is turned level about its middle. The yaw and the shift are fitted to the walls later.
+        struct F { float x, y, z, w; }; std::vector<F> f;
+        for (size_t t = 0; t + 2 < m.size(); t += 3)
+        {
+            const V3 n = cross(sub(m[t + 1], m[t]), sub(m[t + 2], m[t])); const float l = std::sqrt(dot(n, n));
+            if (!(l > 0.0f) || n.y / l < 0.9f) continue;
+            const float y = (m[t].y + m[t + 1].y + m[t + 2].y) / 3.0f; if (y > minY + 1.0f) continue;
+            f.push_back({ (m[t].x + m[t + 1].x + m[t + 2].x) / 3.0f, y, (m[t].z + m[t + 1].z + m[t + 2].z) / 3.0f, l * 0.5f });
+        }
+        double a = 0, c = 0, d = minY; bool ok = false;
+        for (int it = 0; it < 5 && f.size() > 50; ++it)
+        {
+            double S[3][4] = {};
+            for (const F &q : f)
+            {
+                if (it && q.y - (a * q.x + c * q.z + d) > 0.08) continue;   // above the floor layer: furniture, the rug's edge
+                const double v[3] = { q.x, q.z, 1.0 };
+                for (int i = 0; i < 3; ++i) { S[i][3] += q.w * v[i] * q.y; for (int j = 0; j < 3; ++j) S[i][j] += q.w * v[i] * v[j]; }
+            }
+            for (int i = 0; i < 3; ++i)
+            {
+                int p = i; for (int k = i + 1; k < 3; ++k) if (std::fabs(S[k][i]) > std::fabs(S[p][i])) p = k;
+                for (int j = 0; j < 4; ++j) std::swap(S[i][j], S[p][j]);
+                if (std::fabs(S[i][i]) < 1e-9) { ok = false; break; }
+                for (int k = 0; k < 3; ++k) if (k != i) { const double r = S[k][i] / S[i][i]; for (int j = 0; j < 4; ++j) S[k][j] -= r * S[i][j]; }
+                ok = true;
+            }
+            if (!ok) break;
+            a = S[0][3] / S[0][0]; c = S[1][3] / S[1][1]; d = S[2][3] / S[2][2];
+        }
+        const float tilt = float(std::atan(std::sqrt(a * a + c * c)));
+        if (ok && tilt > 0.008f && tilt < 0.35f)   // 0.5 .. 20 deg
+        {
+            float cx = 0, cz = 0, sw = 0; for (const F &q : f) { cx += q.x * q.w; cz += q.z * q.w; sw += q.w; } cx /= sw; cz /= sw;
+            const V3 piv{ cx, float(a * cx + c * cz + d), cz };
+            V3 n{ float(-a), 1.0f, float(-c) }; { const float l = std::sqrt(dot(n, n)); n = { n.x / l, n.y / l, n.z / l }; }
+            V3 ax = cross(n, V3{ 0, 1, 0 }); const float sn = std::sqrt(dot(ax, ax)), cs = n.y; ax = { ax.x / sn, ax.y / sn, ax.z / sn };
+            for (V3 &p : m)
+            {   // Rodrigues: p' = piv + v cos + (k x v) sin + k (k.v)(1 - cos)
+                const V3 v = sub(p, piv), kv = cross(ax, v); const float kd = dot(ax, v);
+                p = { piv.x + v.x * cs + kv.x * sn + ax.x * kd * (1 - cs), piv.y + v.y * cs + kv.y * sn + ax.y * kd * (1 - cs), piv.z + v.z * cs + kv.z * sn + ax.z * kd * (1 - cs) };
+            }
+            std::fprintf(stderr, "[armesh] the mesh's floor was tilted %.1f deg -- levelled\n", tilt * 57.29578f);
+        }
+    }
+    std::fprintf(stderr, "[armesh] room mesh in: %zu triangles, floor at %.2f m, winding %s\n", count, minY, flip ? "flipped (floor faced down)" : "as is");
+    std::lock_guard<std::mutex> l(g_layoutMx);
+    g_mesh.swap(m); g_meshNew = true;
+}
