+# ---- the state, every 3 s (and right after a click)
+function Status-Color($s) {
+    if ($s -match '^(Not running|The game has ended|Stopped)') { return $silver }
+    if ($s -match '^(Starting|Stopping|Checking|Waiting|Restarting|The game is starting|The headset is there|New settings|The headset session was lost -- starting)') { return $orange }
+    if ($s -match '^Playing') { return $green }
+    return $salmon   # the game's stop reasons and the start script's boxes
+}
+function Update-Status {
+    # the start script's / the game's line (ar\status.txt)
+    $s = ''; $sT = [datetime]::MinValue
+    if (Test-Path -LiteralPath $statusFile) { try { $s = [IO.File]::ReadAllText($statusFile).Trim(); $sT = (Get-Item -LiteralPath $statusFile).LastWriteTimeUtc } catch { } }
+    $games = @(Game-Procs); $starts = @(Start-Procs); $active = [bool]($games.Count -or $starts.Count)
+    if (-not $active -and ($s -eq '' -or $s -match '^(Playing|The game is starting|Waiting|Starting|Stopping|The headset is there)')) { $s = 'Not running. Press Start to play.' }
+    # the game's own stop reason (build\ps2xRuntime\ar-error.txt) when it is newer than this line: a start from the
+    # headset's Link library, with no start script to pass it on (31.10.). The start script removes the file at each
+    # start and says what is in it, which makes status.txt the newer one.
+    if (-not $active -and (Test-Path -LiteralPath $gameErr)) {
+        $eT = (Get-Item -LiteralPath $gameErr).LastWriteTimeUtc
+        if ($eT -gt $sT) { $e = ''; try { $e = (Get-Content -LiteralPath $gameErr -Raw -ErrorAction Stop).Trim() } catch { }; if ($e) { $s = "The game stopped: $e"; $sT = $eT } }
+    }
+    # yesterday's error is no news: it greeted the player as if it had just happened (audit 01.11.)
+    if (-not $active -and $sT -lt [datetime]::UtcNow.AddHours(-2)) { $s = 'Not running. Press Start to play.' }
+    # a game started without this window (from the headset's Link library): no start script, the line is older than it
+    if ($games.Count -and -not $starts.Count) { try { if ($sT -lt $games[0].StartTime.ToUniversalTime()) { $s = 'Playing -- the game is running. Press Stop in this window when you are done.' } } catch { } }
+    if ($script:pendingRestart) { if ($active) { $s = 'New settings apply at the next start -- press Restart.' } else { $script:pendingRestart = $false } }
+    if ($script:stopping) { $s = 'Stopping the game ...' }
+    # (the timer ticks on while Start waits for Link to come back: this line, not "Not running")
+    if ($script:linkRestarting) { $s = 'Restarting the Meta Horizon Link app once for the passthrough edge fix -- a few seconds ...' }
+    if ($runState.Text -ne $s) {
+        $runState.Text = $s; $runTip.SetToolTip($runState, (($s -replace '(.{1,90})(\s+|$)', "`$1`n").Trim()))
+        $h = [Math]::Min(120, [Math]::Max(44, $runState.GetPreferredSize((New-Object System.Drawing.Size(660, 0))).Height))
+        if ($runState.Height -ne $h) { $runState.Height = $h; Place-Play; Update-Layout }
+    }
+    $runState.ForeColor = Status-Color $s
+    # the buttons say what can be done now: Start while nothing runs, Stop (or Restart after a change) while it runs
+    $busy = [bool]($script:installProc -and -not $script:installProc.HasExited)
+    $start.Enabled = -not $active -and -not $busy -and -not $script:stopping -and -not $script:linkRestarting
+    $start.Text = $(if ($active) { 'Running...' } else { 'Start' })
+    $restart.Enabled = $active -and -not $script:stopping; $stop.Enabled = $active -and -not $script:stopping
+    Set-Accent $start (Installed); Set-Accent $restart $script:pendingRestart; Set-Accent $stop (-not $script:pendingRestart)
+    $install.Enabled = -not $busy; $repairB.Enabled = -not $busy
+    # this window over the game's own PC window while the game runs (it opened over it and hid the status line and
+    # Stop -- audit 01.11.), and in front once it has ended, with the result line
+    $running = [bool]$games.Count
+    if ($f.TopMost -ne $running) { $f.TopMost = $running }
+    if ($script:wasRunning -and -not $running -and -not $script:stopping) { $f.Activate() }
+    $script:wasRunning = $running
+}
+$script:wasRunning = $false
+function Update-Install {
+    if ($script:installProc) {
+        if (Test-Path $installLog) { try { $lines = Get-Content $installLog -Tail 12 -ErrorAction Stop; $log.Text = ($lines -join "`r`n"); $log.SelectionStart = $log.Text.Length; $log.ScrollToCaret() } catch {} }
+        if ($script:installProc.HasExited) {
+            $ok = $script:installProc.ExitCode -eq 0 -and (Installed)
+            $script:installFailed = -not $ok; $script:installProc = $null
+            if ($ok) { $instState.Text = 'installed -- ready to play'; $instState.ForeColor = $green }
+        }
+    }
+    $what = $(if ($script:repairing) { 'Repair' } else { 'Install' })
+    if ($script:installProc) {
+        $instState.Text = 'installing ... (the log is below)'; $instState.ForeColor = $orange
+        $logHead.Text = "$what running -- 30-60 min the first time, Windows may ask for permission. What it is doing:"; $logHead.ForeColor = $orange
+    } elseif ($script:installFailed) {
+        if (-not $log.Text -and (Test-Path $installLog)) { try { $log.Text = ((Get-Content $installLog -Tail 12 -ErrorAction Stop) -join "`r`n"); $log.SelectionStart = $log.Text.Length; $log.ScrollToCaret() } catch {} }
+        $instState.Text = 'install failed -- see the log below (ar\install.log)'; $instState.ForeColor = $salmon
+        $logHead.Text = "$what failed -- the log is below (all of it: ar\install.log). Press $what again, or Report a problem."; $logHead.ForeColor = $salmon
+    } elseif (-not (Installed)) { $instState.Text = 'not installed yet'; $instState.ForeColor = $silver }
+}
+$script:discTick = 0
+function Update-Ready {
+    $c = Read-Cfg
+    $lblInst.Text = "Installed: $title in $root"; $readyTip.SetToolTip($lblInst, $root)
+    # the disc every 15 s (a disconnected network path can take seconds to answer)
+    if ($script:discTick % 5 -eq 0) {
+        $isoP = "$(if ($c) { $c.iso })"; $name = $(try { [IO.Path]::GetFileName($isoP) } catch { $isoP })
+        if ($isoP -and (Test-Path -LiteralPath $isoP -PathType Leaf)) { $lblDisc.Text = "Game disc: $name -- OK"; $lblDisc.ForeColor = $green }
+        elseif ($isoP) { $lblDisc.Text = "Game disc: $name is missing (moved, deleted or its drive unplugged) -- plug it in or press Change disc..."; $lblDisc.ForeColor = $salmon }
+        else { $lblDisc.Text = 'Game disc: none chosen -- press Change disc...'; $lblDisc.ForeColor = $salmon }
+        $readyTip.SetToolTip($lblDisc, $isoP)
+    }
+    $script:discTick++
+    # the PC's Link app: the OpenXR runtime, its service, the Beta settings (Link-Problems)
+    $todo = @(); $rt = OpenXR-Runtime
+    if (-not $rt) { $todo += 'not found -- install it (meta.com/quest/setup), then make it the OpenXR runtime' }
+    else {
+        if ($rt -notmatch 'oculus|meta') { $todo += 'make it the OpenXR runtime (Settings > General > OpenXR Runtime > Set Meta Horizon Link as active)' }
+        $lp = Link-Problems ($mode.SelectedIndex -eq 0)
+        if ($lp.NotRunning) { $todo += 'not running -- open it' }
+        if ($lp.Off.Count) { $todo += "Settings > Beta > turn on $(($lp.Off | ForEach-Object { "'$_'" }) -join ', ')" }
+    }
+    $lblLink.Text = 'Meta Horizon Link app (formerly Meta Quest Link) on this PC: ' + $(if ($todo.Count) { $todo -join '; ' } else { 'ready' })
+    $lblLink.ForeColor = $(if ($todo.Count) { $salmon } else { $green })
+    Update-EdgeLine   # (the Link passthrough edge fix, under the Link line)
+    # a longer line (what to do) wraps: the lines as tall as their text, the row as tall as all three
+    $hD = [Math]::Max(22, $lblDisc.GetPreferredSize((New-Object System.Drawing.Size(660, 0))).Height)
+    $hL = [Math]::Max(22, $lblLink.GetPreferredSize((New-Object System.Drawing.Size(660, 0))).Height)
+    $hE = [Math]::Max(22, $lblEdge.GetPreferredSize((New-Object System.Drawing.Size(660, 0))).Height)
+    if ($lblDisc.Height -ne $hD -or $lblLink.Height -ne $hL -or $lblEdge.Height -ne $hE) {
+        $lblDisc.Height = $hD; $lblLink.Top = $lblDisc.Bottom + 2; $lblLink.Height = $hL
+        $lblEdge.Top = $lblLink.Bottom + 2; $lblEdge.Height = $hE; $pReady.Height = $lblEdge.Bottom + 8
+    }
+}
+function Update-Headset {
+    # optional: adb sees the headset only with developer mode + USB debugging (most players: no) -- said as optional,
+    # not as a fault before the first start (audit 01.11.)
+    $none = 'Headset details: not available (optional, needs USB debugging) -- the game works without it.'
+    # at most ~3 s of this window's thread per tick: every call gets only what is left of that (01.11.: adb froze it)
+    $t0 = [datetime]::UtcNow
+    $devs = @(); $all = @()
+    if (Find-Adb) { $all = @((Adb @('devices') 3000) -split "`n"); $devs = @($all | Where-Object { $_ -match "`tdevice$" } | ForEach-Object { ($_ -split "`t")[0] }) }
+    if (Adb-NoAnswer) {
+        $bound.Enabled = $false; $bound.Text = "$boundText (adb does not answer right now)"
+        $hs.ForeColor = $silver; $hs.Text = 'Headset details: no answer from adb right now -- trying again shortly (optional, the game works without it).'
+        return
+    }
+    $bound.Enabled = [bool]$devs.Count
+    $bound.Text = $(if ($devs.Count) { $boundText } else { "$boundText (not available: needs developer mode / USB debugging, see Help)" })
+    if (-not $devs.Count) {
+        $hs.ForeColor = $silver
+        $hs.Text = $(if ($all -match "`tunauthorized") { 'Headset details: put the headset on and allow USB debugging there ("Always allow") -- optional, the game works without it.' } else { $none })
+        $script:hsSerial = ''; return
+    }
+    $serial = ($devs | Where-Object { $_ -match ':\d+$' } | Select-Object -First 1); if (-not $serial) { $serial = $devs[0] }
+    # the details (three more calls) every second tick, or at once for a headset just seen
+    $script:hsTick++
+    if ($serial -eq $script:hsSerial -and $script:hsTick % 2) { return }
+    $ask = { param($cmd) $ms = [int](3000 - ([datetime]::UtcNow - $t0).TotalMilliseconds); if ($ms -lt 300) { return $null }; $r = Adb @('-s', $serial, 'shell', $cmd) $ms; if (Adb-NoAnswer) { return $null }; return $r }
+    $awake = & $ask 'dumpsys power | grep mWakefulness='; if ($null -eq $awake) { return }
+    $link = & $ask 'pidof com.oculus.xrstreamingclient com.meta.pclinkservice.server'; if ($null -eq $link) { return }   # (renamed by a Quest update, 31.10.)
+    $bat = & $ask 'dumpsys battery | grep " level"'; if ($null -eq $bat) { return }
+    $awake = $awake -match 'Awake'; $link = "$link".Trim(); $bat = "$bat" -replace '\D', ''
+    $low = $bat -match '^\d+$' -and [int]$bat -lt 20
+    $hs.Text = "Headset: $(if ($serial -match ':') { 'over Wi-Fi' } else { 'on the cable' }), $(if ($awake) { 'in use' } else { 'asleep (put it on)' }), $(if ($link) { 'Link running' } else { 'Link not started' }), battery $bat %$(if ($low) { ' -- charge the headset' })"
+    $hs.ForeColor = $(if ($low) { $salmon } else { $white })
+    $script:hsSerial = $serial
+}
+$script:hsTick = 0; $script:hsSerial = ''
+# the rows the state needs, one under the other; the window as tall as they are, or as the screen (then it scrolls --
+# a 1080p screen at 150 % or a 768p laptop cut off the bottom rows, release audit 31.10.)
+function Fit-Window([int]$need) {
+    $wa = $(if ($f.Visible) { [System.Windows.Forms.Screen]::FromControl($f).WorkingArea } else { [System.Windows.Forms.Screen]::FromPoint([System.Windows.Forms.Cursor]::Position).WorkingArea })
+    $chrome = $f.Height - $f.ClientSize.Height
+    if ($need + $chrome -gt $wa.Height) {
+        # (wider by the scroll bar, so no sideways one)
+        $sz = New-Object System.Drawing.Size(($W + [System.Windows.Forms.SystemInformation]::VerticalScrollBarWidth), ($wa.Height - $chrome))
+        if (-not $f.AutoScroll) { $f.AutoScroll = $true }
+    } else {
+        $sz = New-Object System.Drawing.Size($W, $need)
+        if ($f.AutoScroll) { $f.AutoScrollPosition = New-Object System.Drawing.Point(0, 0); $f.AutoScroll = $false }
+    }
+    if ($f.ClientSize -ne $sz) { $f.ClientSize = $sz }
+    if ($f.Visible -and $f.Bottom -gt $wa.Bottom) { $f.Top = [Math]::Max($wa.Top, $wa.Bottom - $f.Height) }
+}
+function Update-Layout {
+    $busy = [bool]($script:installProc -and -not $script:installProc.HasExited)
+    $inst = [bool](Installed) -or ($busy -and $script:repairing)   # (a repair may remove the old .exe: no jump to 1-2-3)
+    $playHead.Text = $(if ($inst) { 'Play' } else { '3  Play' })
+    $rows = @(@($pHead, $true), @($pIso, (-not $inst)), @($pInst, (-not $inst)), @($pReady, $inst), @($pLog, ($busy -or $script:installFailed)),
