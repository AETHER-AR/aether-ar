+// ---- [arplace] the spawn point picked with the controller: the room moves so that point becomes the arena centre
+// (game origin), where the fighters start. The renderer asks for it (any thread); the game thread applies it at the
+// top of its next collision frame. g_placeMx guards the room triangles against the renderer's raycast / occluder.
+namespace
+{
+    std::mutex g_placeMx;
+    bool g_placePending = false; V3 g_placeAt{ 0, 0, 0 };
+    std::atomic<uint32_t> g_roomGen{ 1 };   // bumped whenever the room's game-space triangles move
+    std::mutex &placeMx() { return g_placeMx; }
+    std::atomic<uint32_t> &roomGen() { return g_roomGen; }
+    // [arportal] the cut for the renderer (game space): p, n (into the world), t (along the cut), u0, u1, h (game
+    // units along t / up from p), the cut's generation; valid once a cut exists and the room is built around it
+    float g_portalOut[13] = {}; std::atomic<bool> g_portalValid{ false };
+
+    V3 gameToRoomPoint(V3 p)
+    {
+        const float s = g_room.scale, cy = std::cos(g_room.yaw), sy = std::sin(g_room.yaw);
+        return { (cy * p.x + sy * p.z) / s + g_room.origin.x, -p.y / s + g_room.origin.y, (sy * p.x - cy * p.z) / s + g_room.origin.z };
+    }
+    // (a pure shift keeps the arena's turn; a pick now rebuilds instead, to turn the start points away from the walls)
+    [[maybe_unused]] void shiftRoom(V3 h)   // h (game space, old origin) becomes the new game origin; holds g_placeMx
+    {
+        const V3 room = gameToRoomPoint(h);
+        for (V3 &v : g_room.verts) v = sub(v, h);
+        for (V3 &c : g_room.cen) c = sub(c, h);
+        for (auto &b : g_room.box) { b[0] -= h.x; b[1] -= h.y; b[2] -= h.z; b[3] -= h.x; b[4] -= h.y; b[5] -= h.z; }
+        for (Tri &t : g_room.tris) t.d -= dot(t.n, h);
+        for (auto &pl : g_shell) pl.second -= dot(pl.first, h);
+        g_room.mn[0] -= h.x; g_room.mn[1] -= h.y; g_room.mn[2] -= h.z; g_room.mx[0] -= h.x; g_room.mx[1] -= h.y; g_room.mx[2] -= h.z;
+        for (Node &n : g_walls.nodes) { n.mn[0] -= h.x; n.mn[1] -= h.y; n.mn[2] -= h.z; n.mx[0] -= h.x; n.mx[1] -= h.y; n.mx[2] -= h.z; }
+        for (FighterTrack &tk : g_track) tk.have = false;   // their last positions were in the old frame
+        g_room.origin = room;
+        g_room.written = 0;   // re-link the cell meshes on the next frame
+        g_roomGen.fetch_add(1);
+        std::fprintf(stderr, "[arplace] arena centre moved to room (%.3f %.3f %.3f) m\n", room.x, room.y, room.z);
+    }
+}
