+        Say-Box $m 'Information' | Out-Null; return
+    }
+    if ($script:installProc -and -not $script:installProc.HasExited) { return }
+    # (the build's last step replaces the game's .exe: it fails while the game runs)
+    if (Is-Active) { Say-Box 'Press Stop first: the game must not run while AETHER AR is installed again.' 'Information' | Out-Null; return }
+    $msg = "The installer will set up what is missing (Python, CMake, Ninja, the compiler tools, Android platform-tools) and build the game from your ISO.`n`nWindows may ask for permission a few times. Continue?"
+    if ($repair) { $msg = "Repair builds AETHER AR again from your disc. Only needed if something is broken -- it takes 30-60 min.`n`n$msg" }
+    if ((Say-Box $msg 'Question' 'YesNo') -ne 'Yes') { return }
+    Remove-Item $installLog -ErrorAction SilentlyContinue
+    # the paths inside '...' with their quotes doubled (an ISO "Goku's BT3.iso" broke the command) -- PowerShell takes
+    # the typographic ones (U+2018/2019/201A/201B, as in a copied "Goku's") for ' too --, and the whole command as one
