+    bool roomLog() { static const bool s = [](){ const char *v = std::getenv("PS2X_AR_ROOMLOG"); return v && v[0] == '1'; }(); return s; }
+    bool g_deskFound = false;   // [ardesk] findDesk found a table-high surface (else its point is not a desk)
+    // [ardesk] the middle of the room's upward triangles from 'first' on (the Space Setup floor): where the fight starts
+    // in a room with no table -- on the floor, not in the air (release audit 31.10.: a bedroom without a table started
+    // the fight 0.55 m up, at the frame's origin, possibly behind a wall)
+    bool floorCentre(const std::vector<V3> &pts, size_t first, V3 &out)
+    {
+        V3 sum{ 0, 0, 0 }; float w = 0.0f;
+        for (size_t t = first; t + 2 < pts.size(); t += 3)
+        {
+            const V3 nn = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t])); const float l = std::sqrt(dot(nn, nn));
+            if (!(l > 0.0f) || nn.y / l < 0.9f) continue;
+            const float lowest = std::min({ pts[t].y, pts[t + 1].y, pts[t + 2].y });
+            if (g_haveScanFloor && lowest > g_scanFloorH + 0.1f) continue;   // floors only, not the tops of furniture
+            for (int k = 0; k < 3; ++k) { sum.x += pts[t + k].x * l; sum.y += pts[t + k].y * l; sum.z += pts[t + k].z * l; }
+            w += 3.0f * l;
+        }
+        if (!(w > 0.0f)) return false;
+        out = { sum.x / w, sum.y / w, sum.z / w };
+        return true;
+    }
+    // [ardesk] the most open spot of the floor near 'centre': inside the walls (the Space Setup planes from 'first' on;
+    // four-ray parity, an L-shaped room's middle can be outside) and as far as possible from every wall and every piece of
+    // furniture (boxes of 11 floats, see arRoomAddFurniture) -- the start points stand ~1.3 m either side of it. The
+    // middle of the floor's rectangle could be outside the room or inside a solid object.
+    bool openFloorSpot(const std::vector<V3> &pts, size_t first, const std::vector<float> &furn, const V3 &centre, V3 &out, float &clear)
+    {
+        struct Seg { float ax, az, bx, bz; };
+        std::vector<Seg> segs;
+        {   // the walls' foot lines: the vertical triangles, merged per plane, as their extent along the wall
+            struct Acc { float nx, nz, d, t0, t1; };
+            std::vector<Acc> acc;
+            for (size_t t = first; t + 2 < pts.size(); t += 3)
+            {
+                const V3 nn = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t])); const float l = std::sqrt(nn.x * nn.x + nn.z * nn.z);
+                if (!(l > 1e-6f) || std::fabs(nn.y) > 0.5f * std::sqrt(dot(nn, nn))) continue;
+                const float nx = nn.x / l, nz = nn.z / l, d = nx * pts[t].x + nz * pts[t].z;
+                float t0 = 1e9f, t1 = -1e9f;
+                for (int k = 0; k < 3; ++k) { const float u = -nz * pts[t + k].x + nx * pts[t + k].z; t0 = std::min(t0, u); t1 = std::max(t1, u); }
+                bool merged = false;
+                for (Acc &a : acc)
+                    if (std::fabs(a.nx - nx) < 0.02f && std::fabs(a.nz - nz) < 0.02f && std::fabs(a.d - d) < 0.03f) { a.t0 = std::min(a.t0, t0); a.t1 = std::max(a.t1, t1); merged = true; break; }
