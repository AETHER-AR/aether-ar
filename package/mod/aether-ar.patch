--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/arscan.vert
@@ -0,0 +1,6 @@
+#version 450
+// [arscan] the room's mesh (game space) for the scan wave at the start of a fight, straight into an eye image
+layout(location = 0) in vec3 inPos;
+layout(push_constant) uniform PScan { mat4 vp; vec4 t; vec4 c; } p;   // t: time s, speed m/s, units/m, strength; c: centre xyz
+layout(location = 0) out vec3 vPos;
+void main() { vPos = inPos; gl_Position = p.vp * vec4(inPos, 1.0); }
