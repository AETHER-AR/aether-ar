+        // .NET Guid text ("47fe64e5-0936-22dd-...") -> both byte orders (System.Guid keeps the first three groups
+        // little-endian; the canonical order is big-endian): the anchor is asked for under both
+        bool uuidFromText(const char *s, uint8_t canon[16], uint8_t dotnet[16])
+        {
+            uint8_t b[16]; int n = 0;
+            for (const char *p = s; *p && n < 16; )
+            {
+                if (*p == '-') { ++p; continue; }
+                auto hex = [](char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; };
+                const int hi = hex(p[0]), lo = p[1] ? hex(p[1]) : -1; if (hi < 0 || lo < 0) return false;
+                b[n++] = uint8_t(hi * 16 + lo); p += 2;
+            }
+            if (n != 16) return false;
+            std::memcpy(canon, b, 16);
+            static const int order[16] = { 3, 2, 1, 0, 5, 4, 7, 6, 8, 9, 10, 11, 12, 13, 14, 15 };
+            for (int i = 0; i < 16; ++i) dotnet[i] = b[order[i]];
+            return true;
+        }
