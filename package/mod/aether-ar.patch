diff --git a/ar/check-iso.ps1 b/ar/check-iso.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..2ddf5373ec48e6b953df3a5a26293c1698be54f4
--- /dev/null
+++ b/ar/check-iso.ps1
@@ -0,0 +1,66 @@
+# AETHER AR -- is this ISO the original USA disc of Budokai Tenkaichi 3 (SLUS-21678)? Throws a plain message that says
+# what to do when it is not. Shared by ar\install.ps1 and the release installer, which runs it from the package's
+# setup\ folder before git and the build: a wrong disc was found only after the whole toolchain was installed (release
+# audit 31.10.).
+#   check-iso.ps1 -Iso <iso> -Work <folder for the check, removed afterwards; not %TEMP%, which can be a path tar cannot use>
+param([string]$Iso, [string]$Work)
+$ErrorActionPreference = 'Stop'
+# -LiteralPath: "Dragon Ball Z [SLUS-21678].iso" is a file name, not a wildcard; .ProviderPath: a \\NAS\ path without
+# PowerShell's "FileSystem::" prefix, which tar cannot open
+$Iso = "$Iso".Trim().Trim('"').Trim()   # (Windows' "Copy as path" pastes it in quotes)
+if (-not $Iso -or -not (Test-Path -LiteralPath $Iso -PathType Leaf)) { throw "ISO not found: $Iso" }
+$Iso = (Resolve-Path -LiteralPath $Iso).ProviderPath
+# only a *.iso: the build (setup.py) takes anything else for a bare game file, and failed 30+ minutes later with a
+# misleading hash message (31.10.)
+$ext = [IO.Path]::GetExtension($Iso).ToLowerInvariant(); $name = [IO.Path]::GetFileName($Iso)
+if ($ext -ne '.iso') {
+    if ($ext -in '.zip', '.7z', '.rar', '.gz', '.xz', '.bz2', '.zst', '.lz4', '.tar', '.tgz') { throw "the disc image is packed ('$name') -- unpack it first, then pick the .iso inside" }
+    if ($ext -in '.chd', '.cso', '.zso', '.cue') { throw "'$name' is not a plain PS2 .iso (CHD / CSO / BIN+CUE do not work) -- convert it to .iso first, then run this again" }
+    throw "the disc image has to end in .iso -- rename '$name' so it ends in .iso (if it is a plain PS2 disc image), then run this again"
+}
+# a plain ISO 9660 image has 'CD001' at byte 0x8001: tar would also read a packed image renamed to .iso, which the game
+# cannot (review 31.10.)
+$fs = [IO.File]::OpenRead($Iso)
+try { $sig = New-Object byte[] 5; $null = $fs.Seek(0x8001, 'Begin'); $got = $fs.Read($sig, 0, 5) } finally { $fs.Dispose() }
+if ($got -ne 5 -or [Text.Encoding]::ASCII.GetString($sig) -ne 'CD001') { throw "'$name' is not a plain PS2 .iso (packed or converted?) -- unpack / convert it to a plain .iso first, then run this again" }
+if (-not $Work) { throw "check-iso.ps1 needs -Work (a folder for the check)" }
+$tar = "$env:SystemRoot\System32\tar.exe"
+if (-not (Test-Path -LiteralPath $tar)) { throw "Windows' tar.exe is missing -- Windows 10 version 1803 or newer is needed" }
+
+Remove-Item -LiteralPath $Work -Recurse -Force -ErrorAction SilentlyContinue
+New-Item -ItemType Directory -Force $Work | Out-Null
+try {
+    # tar's notes on stderr are no error here (see Run-Winget in install.ps1): its exit code and its words decide
+    $old = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+    $out = @(& $tar -tf $Iso 2>&1); $code = $LASTEXITCODE
+    $ErrorActionPreference = $old
+    $list = @($out | Where-Object { $_ -isnot [System.Management.Automation.ErrorRecord] } | ForEach-Object { "$_" })
+    $err = (@($out | Where-Object { $_ -is [System.Management.Automation.ErrorRecord] } | ForEach-Object { "$_" }) -join ' ').Trim()
+    # tar opens files by their ANSI name: a path with characters outside it (e.g. Japanese in a Western Windows) comes
+    # back as "Failed to open '...??...'" -- that is the path, not the disc. ("Error opening archive: Unrecognized
+    # archive format" is tar reading a file that is no ISO, so 'Error opening' alone says nothing.)
+    if ($code -ne 0 -and $err -match 'Failed to open|Can.t open') { throw "Windows' tar cannot open the ISO at this path ($Iso) -- move it to a plain folder such as C:\ISO\bt3.iso and run this again" }
+    if ($code -ne 0 -or -not $list.Count) { throw "'$Iso' is not a plain PS2 .iso (CHD / CSO / BIN+CUE do not work) -- convert it to .iso first, then run this again" }
+    if ($list -notcontains 'SLUS_216.78') {
+        $id = $list | Where-Object { $_ -match '^(SLES|SCES|SLPS|SLPM|SCPS|SLKA|SLUS)_\d{3}\.\d{2}' } | Select-Object -First 1
+        throw "this disc is $(if ($id) { $id } else { 'not Budokai Tenkaichi 3' }) -- only the USA release of Budokai Tenkaichi 3 (SLUS-21678) works. Pick that ISO and run this again"
+    }
+    if ($list -notcontains 'BIN/DBZP.BIN') { throw "BIN/DBZP.BIN is missing from this ISO -- the image is incomplete; use a clean dump of the USA disc" }
+    # the game file out into the work folder, as tar's current folder (no -C: tar would take that path by its ANSI
+    # name too)
+    Push-Location -LiteralPath $Work
+    try {
+        $ErrorActionPreference = 'Continue'
+        $xout = @(& $tar -xf $Iso SLUS_216.78 2>&1)
+        $ErrorActionPreference = $old
+    } finally { Pop-Location }
+    $elf = Join-Path $Work 'SLUS_216.78'
+    if (-not (Test-Path -LiteralPath $elf -PathType Leaf)) {
+        $why = (@($xout | ForEach-Object { "$_" }) -join ' ').Trim()
+        throw "the game file could not be taken out of the ISO for the check$(if ($why) { " ($why)" }) -- make sure the drive of $Work has free space and your antivirus does not block it, then run this again"
+    }
+    $h = (Get-FileHash -LiteralPath $elf -Algorithm SHA256).Hash
+    if ($h -ne '811188BA9B416500D921CD4D9514DF0CBF42F3A41A99CF5AAC5A3DA37171BF99') { throw "this USA ISO's game file differs from the original release (a modded or bad dump) -- use a clean dump of SLUS-21678" }
+} finally {
+    Remove-Item -LiteralPath $Work -Recurse -Force -ErrorAction SilentlyContinue
+}
diff --git a/ar/controls-page.ps1 b/ar/controls-page.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..1f16a5b2debed29a74afb29a9044602ddaf2ad49
--- /dev/null
+++ b/ar/controls-page.ps1
@@ -0,0 +1,326 @@
+Add-Type -AssemblyName System.Windows.Forms, System.Drawing
+[System.Windows.Forms.Application]::EnableVisualStyles()
+Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+public static class AetherControlPageNative {
+    [DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();
+    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
+}
+'@
+$console = [AetherControlPageNative]::GetConsoleWindow()
+if ($console -ne [IntPtr]::Zero) { [void][AetherControlPageNative]::ShowWindow($console, 0) }
+
+$dark = [System.Drawing.Color]::FromArgb(24, 26, 32)
+$panel = [System.Drawing.Color]::FromArgb(36, 39, 48)
+$white = [System.Drawing.Color]::FromArgb(242, 244, 247)
+$muted = [System.Drawing.Color]::FromArgb(177, 183, 193)
+$orange = [System.Drawing.Color]::FromArgb(255, 140, 0)
+$cyan = [System.Drawing.Color]::FromArgb(90, 205, 220)
+
+$form = New-Object System.Windows.Forms.Form
+$form.Text = 'AETHER AR - Help'
+$form.StartPosition = 'CenterScreen'
+$form.ClientSize = New-Object System.Drawing.Size(1016, 690)
+$form.FormBorderStyle = 'FixedDialog'
+$form.MaximizeBox = $false
+$form.MinimizeBox = $false
+$form.BackColor = $dark
+$form.ForeColor = $white
+$form.Font = New-Object System.Drawing.Font('Segoe UI', 9)
+
+function Add-Label($parent, $text, $x, $y, $w, $h, $size, $bold, $color) {
+    $label = New-Object System.Windows.Forms.Label
+    $label.Text = $text
+    $label.Location = New-Object System.Drawing.Point($x, $y)
+    $label.Size = New-Object System.Drawing.Size($w, $h)
+    $label.Font = New-Object System.Drawing.Font('Segoe UI', $size, $(if ($bold) { [System.Drawing.FontStyle]::Bold } else { [System.Drawing.FontStyle]::Regular }))
+    $label.ForeColor = $color
+    $parent.Controls.Add($label)
+    return $label
+}
+
+function Draw-Button($graphics, $x, $y, $text, $accent) {
+    $fill = New-Object System.Drawing.SolidBrush($panel)
+    $edge = New-Object System.Drawing.Pen($accent, 2)
+    $font = New-Object System.Drawing.Font('Segoe UI', 8, [System.Drawing.FontStyle]::Bold)
+    $sf = New-Object System.Drawing.StringFormat
+    $sf.Alignment = [System.Drawing.StringAlignment]::Center
+    $sf.LineAlignment = [System.Drawing.StringAlignment]::Center
+    $graphics.FillEllipse($fill, $x - 13, $y - 13, 26, 26)
+    $graphics.DrawEllipse($edge, $x - 13, $y - 13, 26, 26)
+    $graphics.DrawString($text, $font, [System.Drawing.Brushes]::White, [System.Drawing.RectangleF]::new($x - 13, $y - 13, 26, 26), $sf)
+    $sf.Dispose(); $font.Dispose(); $edge.Dispose(); $fill.Dispose()
+}
+
+function Draw-PSButton($graphics, $symbol) {
+    $graphics.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
+    $color = switch ($symbol) {
+        'Cross' { [System.Drawing.Color]::FromArgb(75, 153, 255); break }
+        'Circle' { [System.Drawing.Color]::FromArgb(239, 83, 94); break }
+        'Square' { [System.Drawing.Color]::FromArgb(225, 108, 184); break }
+        'Triangle' { [System.Drawing.Color]::FromArgb(91, 202, 133); break }
+        default { $white }
+    }
+    $pen = New-Object System.Drawing.Pen($color, 2.5)
+    switch ($symbol) {
+        'Cross' {
+            $graphics.DrawLine($pen, 5, 5, 21, 21)
+            $graphics.DrawLine($pen, 21, 5, 5, 21)
+        }
+        'Circle' { $graphics.DrawEllipse($pen, 4, 4, 18, 18) }
+        'Square' { $graphics.DrawRectangle($pen, 5, 5, 16, 16) }
+        'Triangle' {
+            $points = [System.Drawing.Point[]]@(
+                [System.Drawing.Point]::new(13, 3),
+                [System.Drawing.Point]::new(23, 21),
+                [System.Drawing.Point]::new(3, 21))
+            $graphics.DrawPolygon($pen, $points)
+        }
+    }
+    $pen.Dispose()
+}
+
+function Draw-Controller($graphics, $side) {
+    $graphics.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
+    $shell = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(68, 73, 83))
+    $edge = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(164, 171, 182), 2.5)
+    $inner = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(105, 112, 124), 1.5)
+    $accent = if ($side -eq 'Left') { $orange } else { $cyan }
+    $accentBrush = New-Object System.Drawing.SolidBrush($accent)
+    $labelFont = New-Object System.Drawing.Font('Segoe UI', 8, [System.Drawing.FontStyle]::Bold)
+
+    if ($side -eq 'Left') {
+        $grip = [System.Drawing.Point[]]@(
+            [System.Drawing.Point]::new(53, 128), [System.Drawing.Point]::new(112, 124),
+            [System.Drawing.Point]::new(126, 214), [System.Drawing.Point]::new(106, 252),
+            [System.Drawing.Point]::new(72, 247), [System.Drawing.Point]::new(48, 177))
+    } else {
+        $grip = [System.Drawing.Point[]]@(
+            [System.Drawing.Point]::new(58, 124), [System.Drawing.Point]::new(117, 128),
+            [System.Drawing.Point]::new(122, 177), [System.Drawing.Point]::new(98, 247),
+            [System.Drawing.Point]::new(64, 252), [System.Drawing.Point]::new(44, 214))
+    }
+    $graphics.FillPolygon($shell, $grip)
+    $graphics.DrawPolygon($edge, $grip)
+    $graphics.FillEllipse($shell, 31, 35, 116, 112)
+    $graphics.DrawEllipse($edge, 31, 35, 116, 112)
+    $graphics.DrawEllipse($inner, 40, 44, 98, 94)
+
+    if ($side -eq 'Left') {
+        $stickX = 62; $faceX = 114
+        Draw-Button $graphics $faceX 76 'X' $accent
+        Draw-Button $graphics $faceX 112 'Y' $accent
+        $graphics.FillRectangle($accentBrush, 45, 154, 42, 17)
+        $graphics.DrawString('MENU', $labelFont, [System.Drawing.Brushes]::Black, 48, 155)
+        $graphics.DrawString('L1', $labelFont, $accentBrush, 112, 22)
+        $graphics.DrawString('L2', $labelFont, $accentBrush, 108, 193)
+    } else {
+        $stickX = 116; $faceX = 64
+        Draw-Button $graphics $faceX 76 'A' $accent
+        Draw-Button $graphics $faceX 112 'B' $accent
+        $graphics.DrawString('R1', $labelFont, $accentBrush, 111, 22)
+        $graphics.DrawString('R2', $labelFont, $accentBrush, 108, 193)
+    }
+    $stickFill = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(32, 35, 41))
+    $graphics.FillEllipse($stickFill, $stickX - 14, 82, 30, 30)
+    $graphics.DrawEllipse($inner, $stickX - 14, 82, 30, 30)
+    $graphics.FillEllipse($accentBrush, $stickX - 4, 92, 10, 10)
+    $graphics.DrawString('STICK', $labelFont, [System.Drawing.Brushes]::White, 55, 266)
+
+    $labelFont.Dispose(); $stickFill.Dispose(); $accentBrush.Dispose(); $inner.Dispose(); $edge.Dispose(); $shell.Dispose()
+}
+
+function Add-ControlRow($parent, $y, $key, $description, $accent, $psSymbol = '') {
+    $badge = New-Object System.Windows.Forms.Panel
+    $badge.Location = New-Object System.Drawing.Point(0, $y)
+    $badge.Size = New-Object System.Drawing.Size(68, 30)
+    $badge.BackColor = $dark
+    $parent.Controls.Add($badge)
+    $keyLabel = Add-Label $badge $key 0 0 68 30 8 $true $accent
+    $keyLabel.TextAlign = [System.Drawing.ContentAlignment]::MiddleCenter
+    $textX = 78; $textWidth = 218
+    if ($psSymbol) {
+        Add-Label $parent '>' 70 ($y + 4) 14 22 9 $true $muted | Out-Null
+        $icon = New-Object System.Windows.Forms.PictureBox
+        $icon.Location = New-Object System.Drawing.Point(88, ($y + 3))
+        $icon.Size = New-Object System.Drawing.Size(26, 26)
+        $icon.BackColor = $panel
+        $icon.Tag = $psSymbol
+        $icon.Add_Paint({ param($sender, $eventArgs) Draw-PSButton $eventArgs.Graphics ([string]$sender.Tag) })
+        $parent.Controls.Add($icon)
+        $textX = 120; $textWidth = 176
+    }
+    $text = Add-Label $parent $description $textX ($y + 1) $textWidth 34 8.5 $false $white
+    $text.AutoEllipsis = $false
+}
+
+$header = New-Object System.Windows.Forms.Panel
+$header.Location = New-Object System.Drawing.Point(0, 0)
+$header.Size = New-Object System.Drawing.Size(1000, 82)
+$header.BackColor = $dark
+$form.Controls.Add($header)
+Add-Label $header 'CONTROLLER GUIDE' 24 12 400 34 21 $true $orange | Out-Null
+Add-Label $header 'Quest controls mapped to Budokai Tenkaichi 3 (PS2)' 26 48 600 22 10 $false $muted | Out-Null
+
+function New-ControllerColumn($x, $side, $title, $accent, $rows) {
+    $column = New-Object System.Windows.Forms.Panel
+    $column.Location = New-Object System.Drawing.Point($x, 94)
+    $column.Size = New-Object System.Drawing.Size(466, 388)
+    $column.BackColor = $panel
+    $form.Controls.Add($column)
+    Add-Label $column $title 16 12 220 24 11 $true $accent | Out-Null
+
+    $art = New-Object System.Windows.Forms.PictureBox
+    $art.Location = New-Object System.Drawing.Point(12, 48)
+    $art.Size = New-Object System.Drawing.Size(158, 292)
+    $art.BackColor = $panel
+    $art.Tag = $side
+    $art.Add_Paint({ param($sender, $eventArgs) Draw-Controller $eventArgs.Graphics ([string]$sender.Tag) })
+    $column.Controls.Add($art)
+
+    $map = New-Object System.Windows.Forms.Panel
+    $map.Location = New-Object System.Drawing.Point(178, 48)
+    $map.Size = New-Object System.Drawing.Size(276, 292)
+    $map.BackColor = $panel
+    $column.Controls.Add($map)
+    for ($i = 0; $i -lt $rows.Count; $i++) {
+        $symbol = if ($rows[$i].Count -gt 2) { $rows[$i][2] } else { '' }
+        Add-ControlRow $map ($i * 40) $rows[$i][0] $rows[$i][1] $accent $symbol
+    }
+    return $column
+}
+
+$leftRows = @(
+    @('LEFT STICK', 'Left analog; D-pad in menus'),
+    @('L3', 'Click left stick'),
+    @('X', 'Square action in combat', 'Square'),
+    @('Y', 'Triangle action in combat', 'Triangle'),
+    @('L1', 'Trigger; place when ray is visible'),
+    @('L2', 'Grip input'),
+    @('MENU', "START; pause`nHold 3 s for Space Setup")
+)
+$rightRows = @(
+    @('R STICK', 'Right analog'),
+    @('R3', 'Click right stick'),
+    @('A', 'Confirm menus', 'Cross'),
+    @('B', 'Back / cancel menus', 'Circle'),
+    @('R1', 'Trigger; place when ray is visible'),
+    @('R2', 'Grip input'),
+    @('SELECT', 'Not mapped on Quest controllers')
+)
+$leftColumn = New-ControllerColumn 24 'Left' 'LEFT CONTROLLER' $orange $leftRows
