+        $col = $silver
+    }
+    elseif ($script:edgeError) { $t = "Link passthrough edge fix: could not be turned on ($($script:edgeError)) -- press Report a problem"; $col = $salmon }
+    elseif (-not $e.On) { $t = 'Link passthrough edge fix: not on yet -- close this window and open AETHER AR again'; $col = $salmon }
+    elseif ($e.RestartDue) { $t = 'Link passthrough edge fix: on -- Link restarts once when you press Start'; $col = $orange }
+    elseif ($e.Stale) { $t = 'Link passthrough edge fix: on -- it takes effect after the next PC restart (Link could not be restarted)'; $col = $orange }
+    else { $t = 'Link passthrough edge fix: on (no black shadow behind the fighters)'; $col = $green }
+    if ($lblEdge.Text -ne $t) { $lblEdge.Text = $t }
