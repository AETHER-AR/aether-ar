+void arRoomRequestCentre(const float gameHit[3]);
+// [arlayout] the headset's Space Setup walls / floor / ceiling, room-space triangles (xyz x3 each), added to the scan
+void arRoomAddLayout(const float *roomTris, size_t count);
+// [armesh] the headset's own room mesh (Space Setup scan, read over Link), room space like the layout: without a
+// detailed scan (PS2X_AR_SCAN) it is the room -- its flat tops and floor, and the arena's placement surface
+void arRoomAddMesh(const float *roomTris, size_t count);
