+            const double dt = std::min(0.25, std::chrono::duration<double>(now - s_last).count()); s_last = now;
+            if (needRoom() && !g.haveFrozen)
+            {
+                if (g.layoutStage == 4) { std::fprintf(stderr, "[arfail] the room read is over and no room came\n"); fail(msg::kNoRoom); }
+                if (g.layoutStage != 0 && g.viewsValid) g.roomReadSec += dt;
+                if (g.roomReadSec > 180.0) { std::fprintf(stderr, "[arfail] the room read hangs\n"); fail(msg::kNoRoom); }
+            }
+        }
