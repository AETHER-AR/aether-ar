diff --git a/ps2xRuntime/src/lib/seamvk/arportal.vert b/ps2xRuntime/src/lib/seamvk/arportal.vert
new file mode 100644
index 0000000000000000000000000000000000000000..c64c74e2cd79231a439f348352276f0562ba51f6
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/arportal.vert
@@ -0,0 +1,12 @@
+#version 450
+// [arportal] The portal's cut plane, drawn straight into an eye image (game space -> that eye's clip space, the AR
+// camera's reverse-Z: its depth compares with the scene's and the room occluders'). uv: metres along the cut / up.
+layout(location = 0) in vec3 inPos;
+layout(location = 1) in vec2 inUv;
+layout(push_constant) uniform PP { mat4 vp; vec4 src; vec4 t; vec4 org; vec4 plane; } p;
+layout(location = 0) out vec2 vUv;
+void main()
+{
+    gl_Position = p.vp * vec4(inPos, 1.0);
+    vUv = inUv;
+}
