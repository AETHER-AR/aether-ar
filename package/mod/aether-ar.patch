+    // Mario's raw fused depth scan (mario-room-detail.bin, version 3: int version, .NET string anchor, float alignShift,
+    // int count, count * 3 Unity anchor-local points) -- the play export above holds only the cleaned PLAY surfaces
+    // (floor, desk, monitor top); the room's walls, ceiling and furniture sides exist only here. Converted like Mario's
+    // own export (Unity -> OpenXR anchor-local: negate x, swap winding), the same anchor-up alignment shift applied, and
+    // only steep (|n.y| < 0.3) or downward-facing (ceiling, undersides) triangles kept: the floors' fusion noise would
+    // otherwise become phantom walls. Appended to pts (room space, y up).
+    bool loadRawWalls(const char *path, std::vector<V3> &pts)
+    {
+        std::ifstream in(path, std::ios::binary);
+        if (!in.good()) { std::fprintf(stderr, "[arroom] cannot open %s\n", path); return false; }
+        int32_t version = 0; in.read(reinterpret_cast<char *>(&version), 4);
+        if (version != 3) { std::fprintf(stderr, "[arroom] %s: version %d, need the raw fused scan (3)\n", path, version); return false; }
+        uint32_t len = 0; for (int sh = 0; sh < 35; sh += 7) { uint8_t b = 0; in.read(reinterpret_cast<char *>(&b), 1); len |= uint32_t(b & 0x7F) << sh; if (!(b & 0x80)) break; }
+        std::string anchor(len, '\0'); in.read(anchor.data(), len);
+        float shift = 0; int32_t count = 0; in.read(reinterpret_cast<char *>(&shift), 4); in.read(reinterpret_cast<char *>(&count), 4);
+        if (count <= 0 || count > 4000000) return false;
+        std::vector<float> raw(size_t(count) * 9); in.read(reinterpret_cast<char *>(raw.data()), std::streamsize(raw.size() * 4));
+        if (!in) { std::fprintf(stderr, "[arroom] %s is truncated\n", path); return false; }
+        const char *up = std::getenv("PS2X_AR_ANCHOR_UP"); const bool zUp = !(up && up[0] == 'y');
+        size_t kept = 0;
+        for (int32_t t = 0; t < count; ++t)
+        {
+            V3 v[3];
+            static const int order[3] = { 0, 2, 1 };
+            for (int k = 0; k < 3; ++k)
+            {
+                const float *s = &raw[size_t(t) * 9 + size_t(order[k]) * 3];
+                const V3 a{ -s[0], s[1], s[2] };                         // Unity -> OpenXR anchor-local
+                v[k] = zUp ? V3{ a.x, a.z + shift, -a.y } : V3{ a.x, a.y + shift, a.z };   // -> room space (y up), aligned
+            }
+            V3 n = cross(sub(v[1], v[0]), sub(v[2], v[0])); const float l = std::sqrt(dot(n, n));
+            if (!(l > 1e-9f)) continue;
+            const float ny = n.y / l;
+            if (std::fabs(ny) < 0.3f || ny < -0.7f) { pts.push_back(v[0]); pts.push_back(v[1]); pts.push_back(v[2]); ++kept; }
+        }
+        std::fprintf(stderr, "[arroom] walls from %s: %zu of %d fused triangles (anchor %s, shift %.3f m)\n", path, kept, count, anchor.c_str(), shift);
+        return true;
+    }
+
+    // The desk: the heaviest horizontal, upward-facing surface 0.55..1.0 m above the floor (the lowest heavy level).
+    V3 findDesk(const std::vector<V3> &pts)
+    {
+        std::vector<std::pair<float, float>> lv;   // height, area
+        for (size_t t = 0; t + 2 < pts.size(); t += 3)
+        {
+            V3 n = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t]));
+            const float a2 = std::sqrt(dot(n, n)); if (a2 <= 0.0f) continue;
+            if (n.y / a2 < 0.9f) continue;
+            lv.push_back({ (pts[t].y + pts[t + 1].y + pts[t + 2].y) / 3.0f, a2 * 0.5f });
+        }
+        auto heaviest = [&](float lo, float hi) {
+            float best = 0, bestH = lo;
+            for (float h = lo; h < hi; h += 0.02f)
+            {
+                float s = 0; for (auto &e : lv) if (e.first >= h && e.first < h + 0.04f) s += e.second;
+                if (s > best) { best = s; bestH = h + 0.02f; }
+            }
+            return std::make_pair(bestH, best);
+        };
+        float lo = 1e9f; for (auto &e : lv) lo = std::min(lo, e.first);
+        const float floorH = heaviest(lo - 0.01f, lo + 0.5f).first;
+        const auto desk = heaviest(floorH + 0.55f, floorH + 1.0f);
+        V3 c{ 0, desk.first, 0 }; float w = 0;
+        for (size_t t = 0; t + 2 < pts.size(); t += 3)
+        {
+            V3 n = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t]));
+            const float a2 = std::sqrt(dot(n, n)); if (a2 <= 0.0f || n.y / a2 < 0.9f) continue;
+            const float h = (pts[t].y + pts[t + 1].y + pts[t + 2].y) / 3.0f;
+            if (std::fabs(h - desk.first) > 0.03f) continue;
+            c.x += (pts[t].x + pts[t + 1].x + pts[t + 2].x) / 3.0f * a2; c.z += (pts[t].z + pts[t + 1].z + pts[t + 2].z) / 3.0f * a2; w += a2;
+        }
+        if (w > 0) { c.x /= w; c.z /= w; }
+        g_deskFound = desk.second > 0.0f && w > 0.0f;
+        if (roomLog()) std::fprintf(stderr, "[arroom] floor %.3f m, desk %.3f m (%.2f m2), arena centre (%.3f %.3f %.3f)%s\n", floorH, desk.first, desk.second, c.x, c.y, c.z,
+                     g_deskFound ? "" : " -- NO table-high surface: the fight starts on the floor"); else std::fprintf(stderr, "[arroom] table-high surface: %s\n", g_deskFound ? "found" : "none -- the fight starts on the floor");
+        g_scanFloorH = floorH; g_haveScanFloor = true;
+        return c;
+    }
+
+    // [arlayout] Fit the scan (pts[0, layoutFirst)) onto the Space Setup planes (pts[layoutFirst, end), two triangles
+    // per plane, normal into the room): p' = Ry(yaw) (p - c) + c + t.
+    //   start: t.y from the floors (scan floor level vs the Space Setup floor), t.xz from each wall's strongest band
+    //          of scan wall surface facing the same way (5 cm histogram), least squares over the walls;
+    //   then:  8 Gauss-Newton steps on the point-to-plane distances of the scan triangles within 15 cm of a plane
+    //          they face along (|cos| > 0.8), area-weighted, solving t and yaw.
+    struct Align { V3 c{ 0, 0, 0 }, t{ 0, 0, 0 }; float yaw = 0.0f; };
+    // [armesh] the headset's room mesh onto its own Space Setup: it comes close (its walls half on the real ones) but a
+    // few degrees / centimetres off, and tilted (levelled in arRoomAddMesh). alignScanToLayout searched far (a scan's
+    // anchor drifted metres) and only had the flat tops to go by -- it put the mesh metres off. Here: the floor's height
+    // from the flat tops onto the Space Setup floor, then a LOCAL search (yaw
+    // +-10 deg, shift +-0.6 m, coarse then fine) of the mesh's SIDES against the Space Setup walls.
+    bool fitMeshToLayout(const std::vector<V3> &pts, size_t layoutFirst, const std::vector<V3> &sideTris, Align &al)
+    {
+        struct W { float nx, nz, d; }; std::vector<W> walls; float layFloor = 1e9f;
+        V3 wc{ 0, 0, 0 }; int wn = 0;
+        for (size_t t = layoutFirst; t + 2 < pts.size(); t += 3)
+        {
+            const V3 n = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t])); const float l = std::sqrt(dot(n, n)); if (!(l > 0.0f)) continue;
+            if (n.y / l > 0.9f) { layFloor = std::min(layFloor, pts[t].y); continue; }
+            if (std::fabs(n.y / l) > 0.3f || l * 0.5f < 0.5f) continue;   // walls (no door / window frames)
+            const float hx = n.x / l, hz = n.z / l, hl = std::sqrt(hx * hx + hz * hz);
+            walls.push_back({ hx / hl, hz / hl, (hx * pts[t].x + hz * pts[t].z) / hl });
+            for (int k = 0; k < 3; ++k) { wc.x += pts[t + k].x; wc.z += pts[t + k].z; ++wn; }
+        }
+        if (walls.size() < 2 || layFloor > 1e8f) return false;
+        wc = { wc.x / wn, 0.0f, wc.z / wn };
+        // the mesh's floor: the lowest height with at least 1 m2 of flat tops within 5 cm above it
+        std::vector<std::pair<float, float>> tops;
+        for (size_t t = 0; t + 2 < layoutFirst; t += 3)
+        {
+            const V3 n = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t])); const float l = std::sqrt(dot(n, n));
+            if (l > 0.0f && n.y / l > 0.9f) tops.push_back({ (pts[t].y + pts[t + 1].y + pts[t + 2].y) / 3.0f, l * 0.5f });
+        }
+        std::sort(tops.begin(), tops.end());
+        float meshFloor = tops.empty() ? layFloor : tops.front().first;
+        for (size_t i = 0, j = 0; i < tops.size(); ++i)
+        {
+            float a = 0.0f; for (j = i; j < tops.size() && tops[j].first < tops[i].first + 0.05f; ++j) a += tops[j].second;
+            if (a >= 1.0f) { meshFloor = tops[i].first + 0.025f; break; }
+        }
+        // the sides: the 4000 largest, as (x, z, area)
+        struct S { float x, z, w; }; std::vector<S> sd;
+        for (size_t t = 0; t + 2 < sideTris.size(); t += 3)
+        {
+            const V3 n = cross(sub(sideTris[t + 1], sideTris[t]), sub(sideTris[t + 2], sideTris[t])); const float l = std::sqrt(dot(n, n));
+            if (l > 0.0f && std::fabs(n.y / l) < 0.3f) sd.push_back({ (sideTris[t].x + sideTris[t + 1].x + sideTris[t + 2].x) / 3.0f, (sideTris[t].z + sideTris[t + 1].z + sideTris[t + 2].z) / 3.0f, l * 0.5f });
+        }
+        if (sd.size() < 100) return false;
+        if (sd.size() > 4000) { std::nth_element(sd.begin(), sd.begin() + 4000, sd.end(), [](const S &p, const S &q) { return p.w > q.w; }); sd.resize(4000); }
+        auto score = [&](float yaw, float sx, float sz) {
+            const float ca = std::cos(yaw), sa = std::sin(yaw); double hit = 0.0;
+            for (const S &q : sd)
+            {
+                const float rx = q.x - wc.x, rz = q.z - wc.z, px = ca * rx + sa * rz + wc.x + sx, pz = -sa * rx + ca * rz + wc.z + sz;
+                for (const W &w : walls) if (std::fabs(w.nx * px + w.nz * pz - w.d) < 0.08f) { hit += q.w; break; }
+            }
+            return hit; };
+        double total = 0.0; for (const S &q : sd) total += q.w;
+        float by = 0.0f, bx = 0.0f, bz = 0.0f; double best = score(0.0f, 0.0f, 0.0f); const double before = best;
+        for (int yd = -10; yd <= 10; yd += 2) for (int ix = -6; ix <= 6; ++ix) for (int iz = -6; iz <= 6; ++iz)
+        { const double sc = score(yd * 0.0174533f, ix * 0.1f, iz * 0.1f); if (sc > best) { best = sc; by = yd * 0.0174533f; bx = ix * 0.1f; bz = iz * 0.1f; } }
+        const float cy0 = by, cx0 = bx, cz0 = bz;
+        for (int yd = -4; yd <= 4; ++yd) for (int ix = -5; ix <= 5; ++ix) for (int iz = -5; iz <= 5; ++iz)
+        {
+            const float y = cy0 + yd * 0.0043633f, x = cx0 + ix * 0.02f, z = cz0 + iz * 0.02f;   // 0.25 deg, 2 cm
+            const double sc = score(y, x, z); if (sc > best) { best = sc; by = y; bx = x; bz = z; }
+        }
+        al.c = wc; al.yaw = by; al.t = { bx, layFloor - meshFloor, bz };
+        std::fprintf(stderr, "[armesh] mesh fitted onto the Space Setup: floor %+.2f m, yaw %+.1f deg, shift %+.2f %+.2f m; sides on the walls %.0f%% -> %.0f%%\n",
+                     al.t.y, by * 57.29578f, bx, bz, 100.0 * before / total, 100.0 * best / total);
+        return true;
+    }
+    bool alignScanToLayout(const std::vector<V3> &pts, size_t layoutFirst, Align &al)
+    {
+        struct Plane { V3 n; float d; };
+        std::vector<Plane> planes;
+        for (size_t t = layoutFirst; t + 2 < pts.size(); t += 6)
+        {
+            V3 n = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t])); const float l = std::sqrt(dot(n, n)); if (!(l > 0.0f)) continue;
+            n = { n.x / l, n.y / l, n.z / l }; planes.push_back({ n, dot(n, pts[t]) });
+        }
+        const Plane *floorP = nullptr; for (const Plane &p : planes) if (p.n.y > 0.9f) floorP = &p;
+        if (!floorP || planes.size() < 3 || !g_haveScanFloor) { std::fprintf(stderr, "[arlayout] no fit: the Space Setup room has no floor or too few planes\n"); return false; }
+        // scan triangles: centroid, unit normal, area
+        struct S { V3 p, n; float a; };
+        std::vector<S> sc; sc.reserve(layoutFirst / 3);
+        V3 c{ 0, 0, 0 }; float ca = 0;
+        for (size_t t = 0; t + 2 < layoutFirst; t += 3)
+        {
+            V3 n = cross(sub(pts[t + 1], pts[t]), sub(pts[t + 2], pts[t])); const float l = std::sqrt(dot(n, n)); if (!(l > 1e-9f)) continue;
+            const V3 p{ (pts[t].x + pts[t + 1].x + pts[t + 2].x) / 3, (pts[t].y + pts[t + 1].y + pts[t + 2].y) / 3, (pts[t].z + pts[t + 1].z + pts[t + 2].z) / 3 };
+            sc.push_back({ p, { n.x / l, n.y / l, n.z / l }, l * 0.5f });
+            c = { c.x + p.x * l, c.y + p.y * l, c.z + p.z * l }; ca += l;
+        }
+        if (sc.empty() || !(ca > 0)) return false;
+        al.c = { c.x / ca, c.y / ca, c.z / ca };
+        al.t = { 0, floorP->d - g_scanFloorH, 0 }; al.yaw = 0;
+        {   // walls: strongest band of same-facing scan surface
+            float A[2][2] = {}, b[2] = {};
+            for (const Plane &pl : planes)
+            {
+                if (std::fabs(pl.n.y) > 0.3f) continue;
+                std::unordered_map<int, float> hist;
+                // only scan surface facing the same way (into the room): with |cos| the opposite wall's surface,
+                // when larger, won the peak for both walls of a pair and the start was 2.3 m off (21.10., new scan)
+                for (const S &s : sc) if (dot(s.n, pl.n) > 0.8f) hist[int(std::floor(dot(pl.n, s.p) / 0.05f))] += s.a;
+                int best = 0; float bw = -1; for (auto &kv : hist) if (kv.second > bw) { bw = kv.second; best = kv.first; }
+                if (bw <= 0) continue;
+                const float delta = pl.d - (best + 0.5f) * 0.05f;
+                A[0][0] += pl.n.x * pl.n.x; A[0][1] += pl.n.x * pl.n.z; A[1][1] += pl.n.z * pl.n.z;
+                b[0] += pl.n.x * delta; b[1] += pl.n.z * delta;
+            }
+            A[1][0] = A[0][1];
+            const float det = A[0][0] * A[1][1] - A[0][1] * A[1][0];
+            if (std::fabs(det) > 1e-6f) { al.t.x = (b[0] * A[1][1] - A[0][1] * b[1]) / det; al.t.z = (A[0][0] * b[1] - A[1][0] * b[0]) / det; }
+            std::fprintf(stderr, "[arlayout] fit start: shift (%.3f %.3f %.3f) m\n", al.t.x, al.t.y, al.t.z);
+        }
+        // two starts -- the wall estimate and "the anchor was right" (no horizontal shift) -- each refined; the one
+        // whose result lies on more surface (inlier area within 15 cm) wins
+        const Align startEst = al;
+        Align startId = al; startId.t.x = 0; startId.t.z = 0;
+        double bestW = -1; Align bestAl = al; float bestRms = 0; size_t bestUsed = 0;
+        for (int start = 0; start < 2; ++start)
+        {
+        al = start == 0 ? startEst : startId;
+        double lastW = 0;
+        float rms = 0; size_t used = 0;
+        for (int it = 0; it < 9; ++it)
+        {
+            double H[4][4] = {}, g4[4] = {}; double e2 = 0, w = 0; used = 0;
+            const float cyw = std::cos(al.yaw), syw = std::sin(al.yaw);
+            for (const S &s : sc)
+            {
+                const V3 r = sub(s.p, al.c);
+                const V3 q{ cyw * r.x + syw * r.z, r.y, -syw * r.x + cyw * r.z };   // rotated offset from c
+                const V3 p{ q.x + al.c.x + al.t.x, q.y + al.c.y + al.t.y, q.z + al.c.z + al.t.z };
+                const V3 n{ cyw * s.n.x + syw * s.n.z, s.n.y, -syw * s.n.x + cyw * s.n.z };
+                for (const Plane &pl : planes)
+                {
+                    if (std::fabs(dot(n, pl.n)) < 0.8f) continue;
+                    const float res = dot(pl.n, p) - pl.d;
+                    if (std::fabs(res) > 0.15f) continue;
+                    // d(res)/d(yaw) = n . (dR/dyaw r) = n . (q.z, 0, -q.x)
+                    const double J[4] = { pl.n.x, pl.n.y, pl.n.z, pl.n.x * q.z - pl.n.z * q.x };
+                    for (int i = 0; i < 4; ++i) { g4[i] += s.a * J[i] * res; for (int j = 0; j < 4; ++j) H[i][j] += s.a * J[i] * J[j]; }
+                    e2 += s.a * res * res; w += s.a; ++used;
+                }
+            }
+            if (used < 50 || w <= 0) break;
+            rms = float(std::sqrt(e2 / w)); lastW = w;
+            if (it == 8) break;   // the last pass only measures
+            for (int i = 0; i < 4; ++i) H[i][i] += 1e-6 + H[i][i] * 1e-3;
+            // solve H x = -g (Gauss-Jordan, 4x4)
+            double M[4][5]; for (int i = 0; i < 4; ++i) { for (int j = 0; j < 4; ++j) M[i][j] = H[i][j]; M[i][4] = -g4[i]; }
+            bool ok = true;
+            for (int col = 0; col < 4 && ok; ++col)
+            {
+                int piv = col; for (int r = col + 1; r < 4; ++r) if (std::fabs(M[r][col]) > std::fabs(M[piv][col])) piv = r;
+                if (std::fabs(M[piv][col]) < 1e-12) { ok = false; break; }
+                for (int j = 0; j < 5; ++j) std::swap(M[col][j], M[piv][j]);
+                for (int r = 0; r < 4; ++r) if (r != col) { const double f = M[r][col] / M[col][col]; for (int j = col; j < 5; ++j) M[r][j] -= f * M[col][j]; }
+            }
+            if (!ok) break;
+            al.t.x += float(M[0][4] / M[0][0]); al.t.y += float(M[1][4] / M[1][1]); al.t.z += float(M[2][4] / M[2][2]); al.yaw += float(M[3][4] / M[3][3]);
+        }
+        std::fprintf(stderr, "[arlayout]   start %s: shift (%.3f %.3f %.3f) m, yaw %.2f deg, %.2f m2 of scan on the planes, rest %.1f cm\n",
+                     start == 0 ? "wall estimate" : "no shift", al.t.x, al.t.y, al.t.z, al.yaw * 57.29578f, lastW, rms * 100.0f);
+        if (lastW > bestW) { bestW = lastW; bestAl = al; bestRms = rms; bestUsed = used; }
+        }
+        al = bestAl; const float rms = bestRms; const size_t used = bestUsed;
+        std::fprintf(stderr, "[arlayout] scan fitted onto the Space Setup room: shift (%.3f %.3f %.3f) m, yaw %.2f deg, rest %.1f cm over %zu surface matches\n",
+                     al.t.x, al.t.y, al.t.z, al.yaw * 57.29578f, rms * 100.0f, used);
+        if (used < 50) { std::fprintf(stderr, "[arlayout] too few matches -- scan NOT moved\n"); return false; }
+        return true;
+    }
+
+    // Median-split BVH over idx[lo, hi); a leaf holds one triangle, stored as its position in the mesh's own triangle
+    // table (local[] maps a room triangle to that position).
+    int build(std::vector<int> &idx, int lo, int hi, const std::vector<std::array<float, 6>> &box, const std::vector<V3> &cen, const std::vector<int> &local)
+    {
+        const int me = int(g_room.nodes.size()); g_room.nodes.push_back({});
+        Node n{}; for (int k = 0; k < 3; ++k) { n.mn[k] = 1e30f; n.mx[k] = -1e30f; }
+        for (int i = lo; i < hi; ++i) for (int k = 0; k < 3; ++k) { n.mn[k] = std::min(n.mn[k], box[idx[i]][k]); n.mx[k] = std::max(n.mx[k], box[idx[i]][3 + k]); }
+        if (hi - lo == 1) { n.a = local[idx[lo]]; n.b = -1; g_room.nodes[me] = n; return me; }
+        float cmn[3] = { 1e30f, 1e30f, 1e30f }, cmx[3] = { -1e30f, -1e30f, -1e30f };
+        for (int i = lo; i < hi; ++i) { const float c[3] = { cen[idx[i]].x, cen[idx[i]].y, cen[idx[i]].z }; for (int k = 0; k < 3; ++k) { cmn[k] = std::min(cmn[k], c[k]); cmx[k] = std::max(cmx[k], c[k]); } }
+        int ax = 0; for (int k = 1; k < 3; ++k) if (cmx[k] - cmn[k] > cmx[ax] - cmn[ax]) ax = k;
+        const int mid = (lo + hi) / 2;
+        auto key = [&](int t) { return ax == 0 ? cen[t].x : ax == 1 ? cen[t].y : cen[t].z; };
+        std::nth_element(idx.begin() + lo, idx.begin() + mid, idx.begin() + hi, [&](int p, int q) { return key(p) < key(q); });
+        n.a = build(idx, lo, mid, box, cen, local);
+        n.b = build(idx, mid, hi, box, cen, local);
+        g_room.nodes[me] = n;
+        return me;
+    }
+
+    bool prepare()
+    {
+        g_room.tried = true;
+        const char *path = std::getenv("PS2X_AR_SCAN");
