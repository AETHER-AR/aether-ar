+                    { s_warned = tn; std::fprintf(stderr, "[arxr] %s LINK PACING: this frame is predicted %.0f ms ahead (normal here: %.0f ms) -- Link is falling behind; the picture lags and judders\n", stamp(), lead, base); }
+                }
+            }
+        }
