+        // runs f on its own thread and waits for it at most 'sec' seconds: OpenXR calls that close things never returned
+        // over Link at times (xrDestroySession, 21.10.) and froze the whole game. true = it came back.
+        template <class F> bool within(int sec, F f)
+        {
+            auto done = std::make_shared<std::atomic<bool>>(false);
+            std::thread([f, done]() { f(); done->store(true); }).detach();
+            const auto t0 = std::chrono::steady_clock::now();
+            while (!done->load() && std::chrono::steady_clock::now() - t0 < std::chrono::seconds(sec)) std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            return done->load();
+        }
