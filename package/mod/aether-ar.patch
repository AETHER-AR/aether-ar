diff --git a/ps2xRuntime/src/lib/seamvk/occl.vert b/ps2xRuntime/src/lib/seamvk/occl.vert
new file mode 100644
index 0000000000000000000000000000000000000000..43d317203785543d176c1b3796085881ad2325f3
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/occl.vert
@@ -0,0 +1,12 @@
+#version 450
+// [arocc] The real room as an invisible occluder: the scan's triangles (game space) through the AR camera, depth only,
+// drawn into the scene buffer before the fighters. Same clip -> target mapping as seam.vert's AR path; the depth is
+// pushed a hair back so a fighter standing on the desk is not cut off at the soles.
+layout(location = 0) in vec3 inPos;
+layout(push_constant) uniform POcc { mat4 vp; vec4 region; vec4 view; } p;   // region.xy: displayed px; view.zw: target logical size
+void main()
+{
+    vec4 cl = p.vp * vec4(inPos, 1.0);
+    vec2 tpx = (cl.xy * 0.5 + 0.5 * cl.w) * p.region.xy;
+    gl_Position = vec4(tpx / p.view.zw * 2.0 - cl.w, cl.z * 0.995, cl.w);
+}
