+        // game -> stage (the inverse of the eye's view; used by eyeVP and to bring the controller ray into game space)
+        bool stageFromGame(float out[4][4])
+        {
+            float gameToRoom[4][4];
+            if (!arRoomGameToRoom(gameToRoom)) return false;
+            float roomToAnchor[4][4] = {};
+            if (arRoomAnchorZUp()) { roomToAnchor[0][0] = 1; roomToAnchor[1][2] = 1; roomToAnchor[2][1] = -1; roomToAnchor[3][3] = 1; }
+            else { for (int k = 0; k < 4; ++k) roomToAnchor[k][k] = 1; }
+            float roomToStage[4][4];
+            if (g.haveLive) std::memcpy(roomToStage, g.liveRoomToStage, sizeof(roomToStage));
+            else if (g.haveFrozen) std::memcpy(roomToStage, g.frozenRoomToStage, sizeof(roomToStage));
+            else if (g.anchorValid) { float anchorToStage[4][4]; poseToMat(g.anchorPose, anchorToStage); mul(anchorToStage, roomToAnchor, roomToStage); }
+            else
+            {   // the anchor not located (yet): the room keeps the stage's axes, the arena centre 0.8 m ahead of and 0.5 m
+                // below the head at the first frame, so the fight is at least in front of the player
+                static float s_t[3]; static bool s_have = false;
+                if (!s_have)
+                {
+                    const XrVector3f &hp = g.views[0].pose.position;
+                    s_t[0] = hp.x - gameToRoom[3][0]; s_t[1] = hp.y - 0.5f - gameToRoom[3][1]; s_t[2] = hp.z - 0.8f - gameToRoom[3][2];
+                    s_have = true;
+                    std::fprintf(stderr, "[arxr] scan anchor not located: the desk is placed 0.8 m ahead, 0.5 m below the head (real walls will NOT line up)\n");
+                }
+                for (int c = 0; c < 4; ++c) for (int r = 0; r < 4; ++r) roomToStage[c][r] = c == r ? 1.0f : 0.0f;
+                roomToStage[3][0] = s_t[0]; roomToStage[3][1] = s_t[1]; roomToStage[3][2] = s_t[2];
+            }
+            mul(roomToStage, gameToRoom, out);
+            return true;
+        }
+        // inverse of an affine matrix (rotation * uniform scale + translation)
+        void invertAffine(const float m[4][4], float o[4][4])
+        {
+            const float a = m[0][0], b = m[1][0], c = m[2][0], d = m[0][1], e = m[1][1], f = m[2][1], gg = m[0][2], h = m[1][2], i = m[2][2];
+            const float det = a * (e * i - f * h) - b * (d * i - f * gg) + c * (d * h - e * gg);
+            const float id = det != 0.0f ? 1.0f / det : 0.0f;
+            float r[3][3] = { { (e * i - f * h) * id, (c * h - b * i) * id, (b * f - c * e) * id },
+                              { (f * gg - d * i) * id, (a * i - c * gg) * id, (c * d - a * f) * id },
+                              { (d * h - e * gg) * id, (b * gg - a * h) * id, (a * e - b * d) * id } };   // r[row][col]
+            for (int col = 0; col < 3; ++col) for (int row = 0; row < 3; ++row) o[col][row] = r[row][col];
+            for (int row = 0; row < 3; ++row) o[3][row] = -(r[row][0] * m[3][0] + r[row][1] * m[3][1] + r[row][2] * m[3][2]);
+            o[0][3] = o[1][3] = o[2][3] = 0.0f; o[3][3] = 1.0f;
+        }
