+    bool eyeVP(int eye, float vp[4][4])
+    {
+        if (!g.viewsValid) return false;
+        // game -> room -> anchor-local (room = (ax, az, -ay)) -> stage (the located anchor; see stageFromGame)
+        float a[4][4];
+        if (!stageFromGame(a)) return false;
+        float view[4][4]; poseToViewMat(g.views[eye].pose, view);
+        // OpenXR view space (x right, y up, -z forward) -> clip: x right, y DOWN, z = near, w = distance (reverse-Z)
+        const XrFovf &f = g.views[eye].fov;
+        const float tl = std::tan(f.angleLeft), tr = std::tan(f.angleRight), tu = std::tan(f.angleUp), td = std::tan(f.angleDown);
+        constexpr float kNear = 0.03f;
+        float P[4][4] = {};
+        P[0][0] = 2.0f / (tr - tl); P[2][0] = (tr + tl) / (tr - tl);
+        P[1][1] = -2.0f / (tu - td); P[2][1] = -(tu + td) / (tu - td);
+        P[3][2] = kNear;
+        P[2][3] = -1.0f;
+        float c[4][4];
+        mul(view, a, c);
+        mul(P, c, vp);
+        if (eye == 0)
+        {   // every ~600 frames: the head and the anchor in stage space, and where the desk point (game origin) lands on screen
+            static uint32_t s_n = 0;
+            if (++s_n % 600u == 1u)
+            {
+                const XrVector3f &hp = g.views[0].pose.position;
+                const XrQuaternionf &hq = g.views[0].pose.orientation;
+                float o[4]; for (int r = 0; r < 4; ++r) o[r] = vp[3][r];   // vp * (0,0,0,1)
+                {   // the head in the scan's room frame (metres, y up): where the scan thinks the headset is
+                    float gs[4][4], g2r[4][4]; invertAffine(a, gs);
+                    if (arRoomGameToRoom(g2r))
+                    {
+                        float gp[3], rp[3];
+                        for (int k = 0; k < 3; ++k) gp[k] = gs[0][k] * hp.x + gs[1][k] * hp.y + gs[2][k] * hp.z + gs[3][k];
+                        for (int k = 0; k < 3; ++k) rp[k] = g2r[0][k] * gp[0] + g2r[1][k] * gp[1] + g2r[2][k] * gp[2] + g2r[3][k];
+                        if (roomLog()) std::fprintf(stderr, "[arxr] head in the scan's room frame: (%.2f %.2f %.2f) m\n", rp[0], rp[1], rp[2]);
+                    }
+                }
+                if (roomLog()) std::fprintf(stderr, "[arxr] head (%.2f %.2f %.2f) q(%.2f %.2f %.2f %.2f); anchor %s (%.2f %.2f %.2f); desk point ndc (%.2f %.2f) w %.2f\n",
+                             hp.x, hp.y, hp.z, hq.x, hq.y, hq.z, hq.w, g.anchorValid ? "located" : "NOT located",
+                             g.anchorPose.position.x, g.anchorPose.position.y, g.anchorPose.position.z,
+                             o[3] != 0.0f ? o[0] / o[3] : 0.0f, o[3] != 0.0f ? o[1] / o[3] : 0.0f, o[3]);
+            }
+        }
+        return true;
+    }
+
+    Vulkan::ImageView *acquireEye(int eye, uint32_t &w, uint32_t &h)
+    {
+        if (!g.inFrame || !g.frame.shouldRender || !g.viewsValid) return nullptr;
+        XrSwapchainImageAcquireInfo ai{ XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO };
+        if (!check(xrAcquireSwapchainImage(g.sc[eye], &ai, &g.cur[eye]), "xrAcquireSwapchainImage")) return nullptr;
+        XrSwapchainImageWaitInfo wi{ XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO }; wi.timeout = XR_INFINITE_DURATION;
+        if (!check(xrWaitSwapchainImage(g.sc[eye], &wi), "xrWaitSwapchainImage")) return nullptr;
+        w = g.w[eye]; h = g.h[eye];
+        return g.views_[eye][g.cur[eye]].get();
+    }
+    void releaseEye(int eye)
+    {
+        XrSwapchainImageReleaseInfo ri{ XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO };
+        g.dev->external_queue_lock();
+        if (check(xrReleaseSwapchainImage(g.sc[eye], &ri), "xrReleaseSwapchainImage")) g.released[eye] = true;
+        g.dev->external_queue_unlock();
+    }
