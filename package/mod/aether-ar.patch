+function Stop-Game {
+    $script:stopping = $true; $script:pendingRestart = $false; Update-Status
+    try {
+        foreach ($p in (Start-Procs)) { try { Stop-Process -Id $p.ProcessId -Force } catch {} }   # (the waiting start script too)
+        foreach ($p in @(Game-Procs)) { try { $p.CloseMainWindow() | Out-Null } catch {} }
+        # up to 4 s for the game to close, with the window alive (a plain Start-Sleep 4 froze it: "Not responding")
+        for ($i = 0; $i -lt 8 -and @(Game-Procs).Count; $i++) { Start-Sleep -Milliseconds 500; [System.Windows.Forms.Application]::DoEvents() }
+        foreach ($p in @(Game-Procs)) { try { Stop-Process -Id $p.Id -Force } catch {} }
