+            else if (!g.anchorValid && (++g.locateFails % 300) == 1) std::fprintf(stderr, "[arxr] scan anchor not locatable yet (flags 0x%llx)\n", (unsigned long long)loc.locationFlags);
+        }
+        followRoom();
+        startLayoutQuery(); processPlanes(); startMeshQuery(); processMesh();
