+    // the part of every triangle (xyz x3) on one side of the plane dot(n, x - p) <= 0 (keepWorld: >= 0), fanned again
+    void clipTris(std::vector<V3> &tris, V3 p, V3 n, bool keepWorld)
+    {
+        std::vector<V3> out; out.reserve(tris.size());
+        for (size_t t = 0; t + 2 < tris.size(); t += 3)
