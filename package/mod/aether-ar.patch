+# Start: Link's server restarted once when it runs since before the setting was written -- said first, in plain words.
+# $false = do not start now (Link is not back; the box said what to do).
+$script:linkRestarting = $false
+function Restart-LinkForEdgeFix {
+    if (-not $edgeFix.Checked) { return $true }
+    $e = Edge-State
+    if (-not $e -or -not $e.RestartDue) { return $true }
+    Say-Box ("AETHER AR has turned on a Meta Horizon Link setting that removes the black shadow behind the fighters and the aiming ray in the headset.`n`n" +
+             "Link reads it only when it starts, so the Meta Horizon Link app on this PC restarts once now. It takes a few seconds.`n`n" +
+             "If Link is on in the headset, it drops out for a moment: afterwards turn Link on in the headset again if it asks (Quick Settings > Link).") 'Information' | Out-Null
