+        if ($lp.Off.Count) {
+            $app = $(if ($lp.NotRunning) { 'the Link app' } else { 'the Meta Horizon Link app on this PC (formerly Meta Quest Link)' })
+            $m += "In $app open Settings > Beta and turn on:`n$(($lp.Off | ForEach-Object { "    $_" }) -join "`n")`n`nWithout $(if ($lp.Off.Count -gt 1) { 'them' } else { 'it' }) the headset cannot hand the game its camera view or your room, and the game stops right after Start.`n`n"
+        }
+        $m += 'Start anyway?  (No = change it first, then press Start.)'
