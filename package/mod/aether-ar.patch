+        static bool s_trackingWarned = false;
+        auto noteTracking = [&](bool valid, XrResult locateResult, uint32_t viewCount, XrViewStateFlags flags)
+        {
+            const auto now = std::chrono::steady_clock::now();
+            if (!valid)
+            {
+                if (s_trackingSince == std::chrono::steady_clock::time_point{}) s_trackingSince = now;
+                if (!s_trackingWarned && now - s_trackingSince > std::chrono::seconds(3))
+                {
+                    s_trackingWarned = true;
+                    std::fprintf(stderr, "[arxr] waiting for headset tracking: shouldRender=%u, locateViews=%d, views=%u, flags=0x%llx\n",
+                                 unsigned(g.frame.shouldRender), int(locateResult), viewCount, (unsigned long long)flags);
+                    status("Waiting for headset tracking. Put the headset on, face into the lit room, and let it finish locating.");
+                }
+                return;
+            }
+            if (s_trackingWarned)
+            {
+                const double waited = std::chrono::duration<double>(now - s_trackingSince).count();
+                std::fprintf(stderr, "[arxr] headset tracking recovered after %.1f s\n", waited);
+                status("The headset is there -- starting.");
+            }
