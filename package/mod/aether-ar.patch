+            }
+            for (const Acc &a : acc)
+                segs.push_back({ a.nx * a.d - a.nz * a.t0, a.nz * a.d + a.nx * a.t0, a.nx * a.d - a.nz * a.t1, a.nz * a.d + a.nx * a.t1 });
+        }
+        if (segs.size() < 3) return false;
+        float mnx = 1e9f, mxx = -1e9f, mnz = 1e9f, mxz = -1e9f;
+        for (const Seg &s : segs) { mnx = std::min({ mnx, s.ax, s.bx }); mxx = std::max({ mxx, s.ax, s.bx }); mnz = std::min({ mnz, s.az, s.bz }); mxz = std::max({ mxz, s.az, s.bz }); }
