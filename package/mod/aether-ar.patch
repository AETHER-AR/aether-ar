+    bool postDevice(Vulkan::Device &dev)
+    {
+        if (!g.ok) return false;
+        g.ok = false;
+        g.dev = &dev;
+        // [arfail] no session: tried three times, 2 s apart (Link can refuse one while it is still starting, right after it
