+        // headset, or Link itself (release review 31.10.: every failure said "put the headset on").
+        for (int attempt = 1; !createSessionObjects(); ++attempt)
+        {
+            std::fprintf(stderr, "[arxr] no headset session (try %d, result %d)\n", attempt, int(g.lastCreate)); std::fflush(stderr);
+            for (int e = 0; e < 2; ++e) { g.views_[e].clear(); g.img[e].clear(); g.sc[e] = XR_NULL_HANDLE; }
+            if (g.session)
+            {
+                const XrSession old = g.session; g.session = XR_NULL_HANDLE;   // (fail() must not destroy it a second time)
+                if (!within(6, [old]() { xrDestroySession(old); })) fail(msg::kLink);
+            }
+            g.session = XR_NULL_HANDLE; g.stage = XR_NULL_HANDLE; g.passthrough = XR_NULL_HANDLE; g.ptLayer = XR_NULL_HANDLE;
+            g.aimSpace[0] = g.aimSpace[1] = XR_NULL_HANDLE; g.inputOk = false;
