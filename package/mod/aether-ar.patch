diff --git a/ps2xRuntime/src/lib/seamvk/arscan.frag b/ps2xRuntime/src/lib/seamvk/arscan.frag
new file mode 100644
index 0000000000000000000000000000000000000000..99da884efb74b88fb911b79b4fc645801513d40b
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/arscan.frag
@@ -0,0 +1,30 @@
+#version 450
+// [arscan] The scan wave: a front runs out from the fight's centre over the real room (t.y metres per second); where it
+// passes, the room's mesh lights up as a 10 cm grid in the Obelisk / Night City glitch blue -- datamosh blocks at the
+// front, scan lines behind it -- and fades within 1.6 s. The player sees the room as the fighters know it, and whether
+// it sits on the real one. Premultiplied, like the eye images.
+layout(location = 0) in vec3 vPos;
+layout(location = 0) out vec4 o;
+layout(push_constant) uniform PScan { mat4 vp; vec4 t; vec4 c; } p;
+void main()
+{
+    float upm = p.t.z;
+    vec3 m = vPos / upm;                                   // metres (game axes: y down)
+    float d = length((vPos - p.c.xyz) / upm);              // from the centre
+    float front = p.t.x * p.t.y;                           // the wave's radius
+    float behind = front - d;                              // metres since the front passed here
+    if (behind < 0.0) discard;
+    float age = behind / p.t.y;                            // seconds since
+    float fade = clamp(1.0 - age / 1.6, 0.0, 1.0);
+    if (fade <= 0.0) discard;
+    vec3 g = abs(fract(m * 10.0) - 0.5);                   // 10 cm grid on every axis
+    float line = smoothstep(0.44, 0.49, max(g.x, max(g.y, g.z)));   // near a grid line on any axis
+    float edge = exp(-behind / 0.10);                      // the bright front
+    vec3 cell = floor(m / 0.12);
+    float rnd = fract(sin(dot(cell + floor(p.t.x * 14.0) * 0.17, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
+    float blocks = step(0.78, rnd) * exp(-behind / 0.35);  // datamosh blocks just behind the front
+    float scan = step(0.86, fract(m.y * 18.0 - p.t.x * 3.0)) * 0.35;
+    vec3 tint = mix(vec3(0.06, 0.5, 1.0), vec3(0.75, 0.93, 1.0), edge);
+    float a = clamp(edge * 0.85 + line * 0.55 + blocks * 0.45 + scan * 0.3 + 0.06, 0.0, 1.0) * fade * p.t.w;
+    o = vec4(tint * a, a);
+}
