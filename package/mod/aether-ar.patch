+# of its own, and never in the way of the window.
+$scHelper = Join-Path $ar 'shortcuts.ps1'
+if (-not $env:DBAR_SNAPSHOT -and (Test-Path -LiteralPath $scHelper)) {
+    try { & { param($p, $a) . $p; Set-AetherShortcuts -ArDir $a -Repair } $scHelper $ar *> $null } catch { }
+}
