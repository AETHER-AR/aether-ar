+bool arRoomOwns(uint32_t guestAddr)
+{
+    const uint32_t a = guestAddr & 0x1FFFFFFFu;
+    return g_room.ready && a >= kMeshAddr && a < kMeshLimit;
+}
+
+// [arxr] game space -> room space (metres, y up): the inverse of prepare()'s mapping
+//   game = s * diag(1, -1, -1) * yaw * (room - origin)  =>  room = yaw^T * diag(1, -1, -1) * game / s + origin
+bool arRoomGameToRoom(float m[4][4])
+{
+    if (!g_room.ready) return false;
+    const float s = g_room.scale, cy = std::cos(g_room.yaw), sy = std::sin(g_room.yaw);
+    const float c[4][4] = { { cy / s, 0.0f, sy / s, 0.0f }, { 0.0f, -1.0f / s, 0.0f, 0.0f }, { sy / s, 0.0f, -cy / s, 0.0f },
+                            { g_room.origin.x, g_room.origin.y, g_room.origin.z, 1.0f } };   // column-major: m[col][row]
+    std::memcpy(m, c, sizeof(c));
+    return true;
+}
+const char *arRoomAnchor() { return g_room.anchor.c_str(); }
+bool arRoomAnchorZUp() { const char *up = std::getenv("PS2X_AR_ANCHOR_UP"); return !(up && up[0] == 'y'); }
+
+// [arocc] every room triangle (floors and walls) as a flat xyz soup in game space, for the renderer's depth occluder.
+// Built once when the room is ready; 0 until then.
+// The room's shell -- the Space Setup walls and ceiling -- hides a fighter only from kShellBackM behind the real surface
+// on: the collision holds two spheres on the body's axis off the walls, but a body flying head first or knocked away
+// reaches past them, and the real wall cut the part beyond it off -- fighters sank half into the ceiling and the walls
+// to keep fighters visible there. The fighters never leave the room, so a wall only has to hide what is
+// far behind it (around the corner of an L-shaped room). The floor and the furniture stay exact: a fighter behind the
+// desk is hidden as before.
+size_t arRoomOccluder(const float **xyz)
+{
+    static std::vector<float> s_soup;
+    static uint32_t s_gen = 0;
+    if (!g_room.ready) return 0;
+    if (s_gen != g_roomGen.load())
+    {
+        std::lock_guard<std::mutex> l(g_placeMx);
+        s_gen = g_roomGen.load();
+        s_soup.clear(); s_soup.reserve(g_room.tris.size() * 9);
+        // Nothing above the ceiling ever has to be hidden, so the ceiling hides nothing; the walls from 0.3 m behind them
+        // (more than a whole fighter: a body flying head first reaches past the collision's axis). Around the corner of
+        // an L-shaped room a wall still hides what is farther behind it.
+        constexpr float kShellBackM = 0.30f;
+        const float back = kShellBackM * g_room.scale;
+        size_t moved = 0, ceiling = 0;
+        for (const Tri &t : g_room.tris)
+            if (!t.stage && (!portalMode() || t.layout))   // [arportal] the arena's ground is drawn by the game; in portal mode only room surfaces hide anything
+            {
+                // a Space Setup wall goes back along its normal (which faces into the room); the ceiling (normal down,
+                // game down = +y) is left out
+                const bool shell = t.layout && !isFloor(t) && !portalMode();
+                if (shell && t.n.y > 0.5f) { ++ceiling; continue; }
+                const V3 off = shell ? V3{ -t.n.x * back, -t.n.y * back, -t.n.z * back } : V3{ 0, 0, 0 };
+                moved += shell ? 1u : 0u;
+                for (int k = 0; k < 3; ++k) { const V3 &v = g_room.verts[t.i[k]]; s_soup.push_back(v.x + off.x); s_soup.push_back(v.y + off.y); s_soup.push_back(v.z + off.z); }
+            }
+        std::fprintf(stderr, "[arocc] occluder: %zu room triangles; %zu walls hide a fighter only %.2f m behind the real wall, %zu ceiling triangles hide nothing\n",
+                     g_room.tris.size(), moved, kShellBackM, ceiling);
+    }
+    *xyz = s_soup.data();
+    return s_soup.size() / 3;
+}
+
+// [arscan] the room's whole mesh in game space (copied out when its generation changed) and the units per metre
+uint32_t arRoomScanMesh(std::vector<float> &out, uint32_t have, float *unitsPerM)
+{
+    const uint32_t gen = g_visGen.load();
+    if (unitsPerM) *unitsPerM = g_room.scale;
+    if (gen == have || !g_room.ready) return have;
+    std::lock_guard<std::mutex> l(g_placeMx);
+    out = g_vis;
+    return gen;
+}
+
+// ---- [arportal] the portal mode's entry points
+bool arRoomPortalMode() { return portalMode(); }
+// [arring] the room has replaced the arena's ground (in the portal mode too: the room half is the arena's floor there):
+// there is no ring to leave, so no fight may end by ring-out (game_overrides.cpp, the ring-out query)
+bool arRoomReplacesArena() { return g_room.ready && !g_room.noFloor && g_room.written != 0u; }
+// the world half of the real room (game-space xyz soup), copied when it changed since `gen`; returns the vertex count
+size_t arRoomFarCanvas(std::vector<float> &out, uint32_t &gen)
+{
+    std::lock_guard<std::mutex> l(g_portalMx);
+    if (gen != g_farCanvasGen) { out = g_farCanvas; gen = g_farCanvasGen; }
+    return out.size() / 3;
+}
+void arRoomRequestPortal(const float gameHit[3], const float gameDir[3])
+{
+    std::lock_guard<std::mutex> l(g_placeMx);
+    g_portalPickGame = { gameHit[0], gameHit[1], gameHit[2] }; g_portalPickDir = { gameDir[0], 0.0f, gameDir[2] }; g_portalPending = true;
+}
+// game space: p[3], n[3] (into the world), t[3] (along the cut), u0, u1, h (game units), generation
+bool arRoomPortalGeom(float out[13])
+{
+    if (!g_portalValid.load()) return false;
+    std::lock_guard<std::mutex> l(g_portalMx);
+    std::memcpy(out, g_portalOut, sizeof(g_portalOut));
+    return true;
+}
+
+// The arena is drawn by sub_00115DE0: six group tables in the stage model (count u16 at +0x2/+0xA/+0x12/+0x1A/+0x22/
+// +0x2A, record array at +0x4/+0xC/.../+0x2C of *(hdr+0x1C)), each record (16 bytes) a count (+2) and an item array
+// (+4, 16 bytes per item, +0 the item's index); an item is drawn only when its byte in the visibility table *(hdr+0x2C)
+// is set. The game fills that table from ITS camera's view, so from the player's head most of the world was missing
+// (23.10., desktop orbit test: ragged ground, holes, a cut sky). In the portal mode every item is drawn: its byte is
+// set for the call and put back afterwards (the table stays the game's for whatever else reads it).
+namespace
+{
+    PS2Runtime::RecompiledFunction g_orig115de0 = nullptr;
+    void hookStageDraw(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        static std::vector<uint32_t> s_set;
+        s_set.clear();
+        if (g_portalValid.load())
+        {
+            const uint32_t hdr = rd32(rdram, kGp - 0x5690u) & 0x1FFFFFFFu;
+            const uint32_t vis = hdr && hdr < PS2_RAM_NATIVE_SIZE ? rd32(rdram, hdr + 0x2Cu) & 0x1FFFFFFFu : 0u;
+            const uint32_t mdl = hdr && hdr < PS2_RAM_NATIVE_SIZE ? rd32(rdram, hdr + 0x1Cu) & 0x1FFFFFFFu : 0u;
+            if (vis && mdl && vis < PS2_RAM_NATIVE_SIZE && mdl + 0x30u < PS2_RAM_NATIVE_SIZE)
+                for (uint32_t off : { 0x2u, 0xAu, 0x12u, 0x1Au, 0x22u, 0x2Au, 0x32u })   // (+0x32/+0x34: the objects FUN_00115c98 draws -- trees, rocks; missing pieces 23.10.)
+                {
+                    uint16_t cnt; std::memcpy(&cnt, rdram + mdl + off, 2);
+                    const uint32_t arr = rd32(rdram, mdl + off + 2u) & 0x1FFFFFFFu;
+                    if (!cnt || cnt > 4096u || !arr || arr + cnt * 16u > PS2_RAM_NATIVE_SIZE) continue;
+                    for (uint32_t g = 0; g < cnt; ++g)
+                    {
+                        uint16_t n; std::memcpy(&n, rdram + arr + g * 16u + 2u, 2);
+                        const uint32_t items = rd32(rdram, arr + g * 16u + 4u) & 0x1FFFFFFFu;
+                        if (!n || n > 4096u || !items || items + n * 16u > PS2_RAM_NATIVE_SIZE) continue;
+                        for (uint32_t k = 0; k < n; ++k)
+                        {
+                            uint16_t idx; std::memcpy(&idx, rdram + items + k * 16u, 2);
+                            const uint32_t b = vis + idx;
+                            if (b < PS2_RAM_NATIVE_SIZE && rdram[b] == 0u) { rdram[b] = 1u; s_set.push_back(b); }
+                        }
+                    }
+                }
+            static uint32_t s_n = 0;
+            if (s_n++ % 1800u == 0u)
+            {
+                std::fprintf(stderr, "[arportal] the whole arena drawn: %zu parts the game camera left out; groups:", s_set.size());
+                if (mdl && mdl + 0x36u < PS2_RAM_NATIVE_SIZE)
+                    for (uint32_t off : { 0x2u, 0xAu, 0x12u, 0x1Au, 0x22u, 0x2Au, 0x32u }) { uint16_t c; std::memcpy(&c, rdram + mdl + off, 2); std::fprintf(stderr, " +0x%x=%u", off, c); }
+                std::fprintf(stderr, "\n");
+            }
+        }
+        g_orig115de0(rdram, ctx, runtime);
+        for (uint32_t b : s_set) rdram[b] = 0u;
+    }
+    // The placed objects (mountains, plateaus, rocks, trees) are drawn by FUN_00115478: list *(hdr+4) -> +8 count, +0xC
+    // entries of 0x40 bytes; +8 is the model set the entry belongs to (not a flag), and each entry is drawn only when
+    // func_241958(index) -- the GAME camera's view test -- passes, unless +4 has bit 0x40000000 ("always"). So the
+    // mountains came and went with the game camera while the player looked at the same spot (headset video 23.10.).
+    // In the portal mode every entry gets the bit for the call; it is put back afterwards.
+    PS2Runtime::RecompiledFunction g_orig115478 = nullptr;
+    void hookObjectDraw(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        static std::vector<uint32_t> s_set;
+        s_set.clear();
+        if (g_portalValid.load())
+        {
+            const uint32_t hdr = rd32(rdram, kGp - 0x5690u) & 0x1FFFFFFFu;
+            const uint32_t lst = hdr && hdr + 8u < PS2_RAM_NATIVE_SIZE ? rd32(rdram, hdr + 4u) & 0x1FFFFFFFu : 0u;
+            if (lst && lst + 0x10u < PS2_RAM_NATIVE_SIZE)
+            {
+                const uint32_t cnt = rd32(rdram, lst + 8u), arr = rd32(rdram, lst + 0xCu) & 0x1FFFFFFFu;
+                if (cnt && cnt < 4096u && arr && arr + cnt * 0x40u < PS2_RAM_NATIVE_SIZE)
+                    for (uint32_t k = 0; k < cnt; ++k)
+                    {
+                        const uint32_t a = arr + k * 0x40u + 4u, f = rd32(rdram, a);
+                        if (!(f & 0x40000000u)) { const uint32_t nf = f | 0x40000000u; std::memcpy(rdram + a, &nf, 4); s_set.push_back(a); }
+                    }
+                static uint32_t s_n = 0;
+                if (s_n++ % 1800u == 0u) std::fprintf(stderr, "[arportal] placed objects: %u, %zu the game camera's test would have left out are drawn\n", cnt, s_set.size());
+            }
+        }
+        g_orig115478(rdram, ctx, runtime);
+        for (uint32_t a : s_set) { const uint32_t f = rd32(rdram, a) & ~0x40000000u; std::memcpy(rdram + a, &f, 4); }
+    }
+}
+void arRoomInstallPortalHooks(PS2Runtime &runtime)
+{
+    if (!portalMode()) return;
+    g_orig115de0 = runtime.lookupFunction(0x00115de0u);
+    if (g_orig115de0) runtime.replaceFunction(0x00115de0u, &hookStageDraw);
+    g_orig115478 = runtime.lookupFunction(0x00115478u);
+    if (g_orig115478) runtime.replaceFunction(0x00115478u, &hookObjectDraw);
+    std::fprintf(stderr, "[arportal] portal mode: stage draw hook %s, object draw hook %s\n", g_orig115de0 ? "installed" : "MISSING", g_orig115478 ? "installed" : "MISSING");
+}
