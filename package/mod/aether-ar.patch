+    bool g_haveOriginOverride = false; V3 g_originOverride{ 0, 0, 0 }; bool g_overrideAligned = false; bool g_overridePicked = false;
+    bool g_haveScanFloor = false; float g_scanFloorH = 0.0f;   // the scan's floor level (room y), found once
