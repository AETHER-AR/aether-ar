+void arRoomInstallPortalHooks(PS2Runtime &runtime);
+void arRoomInstallHooks(PS2Runtime &runtime)
+{
+    arRoomInstallPortalHooks(runtime);   // [arportal]
+    g_orig1d7198 = runtime.lookupFunction(0x001d7198u);   // [arsync] the room holds each fighter before its draw
+    if (g_orig1d7198) runtime.replaceFunction(0x001d7198u, &hookFighterSync);
+    std::fprintf(stderr, "[arsync] fighters held before their draw: hook on 0x1d7198 %s\n", g_orig1d7198 ? "installed" : "MISSING");
+    g_orig1b1400 = runtime.lookupFunction(0x001b1400u);
+    if (g_orig1b1400 && std::getenv("PS2X_AR_TRACE")) runtime.replaceFunction(0x001b1400u, &hook1b1400);
+    g_orig2316d0b = runtime.lookupFunction(0x002316d0u);
+    if (g_orig2316d0b && std::getenv("PS2X_AR_TRACE")) runtime.replaceFunction(0x002316d0u, &hook2316d0);
+    const char *v = std::getenv("PS2X_AR_TRACE");
+    if (!(v && v[0] == '1')) return;
+    g_orig231768 = runtime.lookupFunction(0x00231768u);
+    if (g_orig231768) runtime.replaceFunction(0x00231768u, &hook231768);
+    std::fprintf(stderr, "[arroom] trace hooks %s\n", g_orig231768 ? "installed" : "MISSING");
