+        // OpenXR pose / matrix helpers (column-major m[col][row])
+        void quatToMat(const XrQuaternionf &q, float r[3][3])
+        {
+            const float x = q.x, y = q.y, z = q.z, w = q.w;
+            r[0][0] = 1 - 2 * (y * y + z * z); r[0][1] = 2 * (x * y + z * w);     r[0][2] = 2 * (x * z - y * w);
+            r[1][0] = 2 * (x * y - z * w);     r[1][1] = 1 - 2 * (x * x + z * z); r[1][2] = 2 * (y * z + x * w);
+            r[2][0] = 2 * (x * z + y * w);     r[2][1] = 2 * (y * z - x * w);     r[2][2] = 1 - 2 * (x * x + y * y);
+        }
+        void poseToMat(const XrPosef &p, float m[4][4])   // local -> parent
+        {
+            float r[3][3]; quatToMat(p.orientation, r);
+            for (int c = 0; c < 3; ++c) { for (int k = 0; k < 3; ++k) m[c][k] = r[c][k]; m[c][3] = 0; }
+            m[3][0] = p.position.x; m[3][1] = p.position.y; m[3][2] = p.position.z; m[3][3] = 1;
+        }
+        void poseToViewMat(const XrPosef &p, float m[4][4])   // parent -> local (inverse of a rigid pose)
+        {
+            float r[3][3]; quatToMat(p.orientation, r);
+            for (int c = 0; c < 3; ++c) for (int k = 0; k < 3; ++k) m[c][k] = r[k][c];
+            for (int c = 0; c < 3; ++c) m[c][3] = 0;
+            const float t[3] = { p.position.x, p.position.y, p.position.z };
+            for (int k = 0; k < 3; ++k) m[3][k] = -(r[k][0] * t[0] + r[k][1] * t[1] + r[k][2] * t[2]);
+            m[3][3] = 1;
+        }
+        void mul(const float a[4][4], const float b[4][4], float o[4][4])
+        {
+            float t[4][4];
+            for (int c = 0; c < 4; ++c) for (int r = 0; r < 4; ++r) { float s = 0; for (int k = 0; k < 4; ++k) s += a[k][r] * b[c][k]; t[c][r] = s; }
+            std::memcpy(o, t, sizeof(t));
+        }
