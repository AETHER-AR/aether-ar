+# AETHER AR -- the launcher window. Once installed it is a player window: the disc and the PC's Link app checked (and
+# Link's passthrough edge fix: no black shadow behind the fighters), the mode, Start / Restart / Stop, what the game is
+# doing, how to play (Options, Help, Report a problem below). Not installed yet (a fresh clone): 1 the ISO, 2 Install,
+# 3 Play, as before.
+# Started by the "AETHER AR" shortcut (desktop / Start menu) or "AETHER AR.cmd". Plain WinForms: nothing to install for
+# the window itself. The settings live in ar\config.json; start-ar.ps1 reads them (mode, room source, boundary, quick
+# start). Help opens the illustrated Quest-controller guide.
+#
+# QA only (inert otherwise): DBAR_SNAPSHOT=<png> shows the window for ~2 s (on a second screen if there is one), saves
+# it as a PNG and closes -- without the one-window lock and the shortcut repair; DBAR_SNAPSHOT_OPTIONS=1 opens Options
+# first. AETHER_DEV=1 shows the developer's detailed room scan as a Room choice.
+Add-Type -AssemblyName System.Windows.Forms, System.Drawing
+[System.Windows.Forms.Application]::EnableVisualStyles()
+$ar = $PSScriptRoot
+$root = Split-Path -Parent $ar
+# an adb server this window (or start-ar.ps1, which inherits it) starts has no mDNS discovery: it opened UDP 5353 on
+# every network, and a fresh PC asked "allow adb (Publisher: Unknown) on public and private networks?" the first time
+# the window opened (empty-PC test in a VM, 04.11.). Nothing here uses mDNS -- USB and adb tcpip/connect do not.
+$env:ADB_MDNS = '0'
+$launcherErr = Join-Path $ar 'launcher-error.txt'
+function Say-Box($m, $icon = 'Warning', $buttons = 'OK', $default = 'Button1') { return [System.Windows.Forms.MessageBox]::Show($m, 'AETHER AR', $buttons, $icon, $default) }
+
+try {   # (anything that goes wrong before the window shows: a plain box and ar\launcher-error.txt -- "I click it and
+        # nothing happens" is the worst dead end there is; the same pattern as the Setup window)
+# any error inside a click or a timer: a plain box, never .NET's "Unhandled exception" dialog
+[System.Windows.Forms.Application]::SetUnhandledExceptionMode('CatchException')
+[System.Windows.Forms.Application]::add_ThreadException({ param($s, $e)
+    try { [IO.File]::AppendAllText($launcherErr, "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') window error: $($e.Exception.Message)`r`n") } catch { }
+    Say-Box "Something went wrong in the AETHER AR window:`n`n$($e.Exception.Message)`n`nIf it happens again, press Report a problem and email the ZIP to contact@aether-xr.com." 'Error' | Out-Null })
+
+$version = $(try { (Get-Content (Join-Path $ar 'VERSION') -TotalCount 1 -ErrorAction Stop).Trim() } catch { '' })
+$title = "AETHER AR $version".Trim()
+# one launcher window: it takes a second or two to open with only a busy cursor, and a second double-click opened a
+# second window that polled adb too (audit 01.11.) -- a second start brings the first window to the front and ends
+$lock = $null
+if (-not $env:DBAR_SNAPSHOT) {
+    $lock = New-Object System.Threading.Mutex($false, 'Local\AetherAR-launcher')
+    $own = $false; try { $own = $lock.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $own = $true }
+    if (-not $own) {
+        try {   # (restored too when it is minimized: AppActivate alone leaves it in the taskbar)
+            Add-Type -Namespace AetherAR -Name Win -MemberDefinition @'
+[DllImport("user32.dll", CharSet = CharSet.Unicode)] public static extern IntPtr FindWindow(string cls, string title);
+[DllImport("user32.dll")] public static extern bool IsIconic(IntPtr h);
+[DllImport("user32.dll")] public static extern bool ShowWindowAsync(IntPtr h, int cmd);
+[DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr h);
+'@
+            # the window of this folder's launcher first (another install's window has the same title), else by title
+            $h = [IntPtr]::Zero
+            foreach ($lw in @(Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" -ErrorAction SilentlyContinue | Where-Object { $_.ProcessId -ne $PID -and $_.CommandLine -and $_.CommandLine.Contains("$ar\AetherAR.ps1") })) {
+                $wp = Get-Process -Id $lw.ProcessId -ErrorAction SilentlyContinue; if ($wp -and $wp.MainWindowHandle -ne [IntPtr]::Zero) { $h = $wp.MainWindowHandle; break }
+            }
+            if ($h -eq [IntPtr]::Zero) { $h = [AetherAR.Win]::FindWindow($null, $title) }
+            if ($h -ne [IntPtr]::Zero) { if ([AetherAR.Win]::IsIconic($h)) { [void][AetherAR.Win]::ShowWindowAsync($h, 9) }; [void][AetherAR.Win]::SetForegroundWindow($h) }
+        } catch { }
+        exit 0
+    }
+}
