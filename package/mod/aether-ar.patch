+function Read-Line([string]$line) {
+    # (the build's lines end in CR LF: split at the last CR only after dropping the line's own -- review 01.11.)
+    $line = ($line.TrimEnd("`r") -split "`r")[-1].TrimEnd(); $t = $line.Trim(); if (-not $t) { return }
+    if ($t -notmatch $noise) { Log-Write $line }
+    if ($t -match '^\[step\]\s+(\w+)') { Set-Step $matches[1]; return }
+    if ($t -match 'FAILED:\s*(.+)$') { $script:reason = $matches[1]; return }
+    if ($t -match '^\[(AETHER AR|install)\]\s+(.+)$') {
+        $msg = $matches[2]
+        # (an older ar\install.ps1 without step lines: its own words move the list)
+        if ($msg -match '^building --' -and $script:active -ne 'build') { Set-Step 'build' }
+        $detail.Text = Nice $msg; return
+    }
+    if ($t -match '^==\s+(.+)$') { $detail.Text = $matches[1]; return }
+    if ($t -match '^\[(\d+)/(\d+)\]\s+(.+)$') {
+        # the build runs several counters (122 recompiler steps, then ~1700 for the game): only the biggest one so far
+        $n = [int]$matches[2]
+        if ($script:active -eq 'build' -and $n -ge 200 -and $n -ge $script:bigN) {
+            if ($n -gt $script:bigN) { $script:bigN = $n; $script:frac = 0.0 }
+            $script:frac = [Math]::Max($script:frac, [int]$matches[1] / $n)
+        }
+        $detail.Text = ('Compiling {0} of {1}' -f $matches[1], $n); return
+    }
+    if ($t -match $noise) { return }   # (the compilers' warnings: not what the player should read as "what it is doing")
+    if (($t -replace '[^A-Za-z]', '').Length -ge 6) { $detail.Text = $t }
+}
+function Read-New {
+    if (-not (Test-Path -LiteralPath $raw)) { return }
+    try {
+        $fs = New-Object System.IO.FileStream($raw, 'Open', 'Read', 'ReadWrite, Delete')
+        try {
+            if ($fs.Length -le $script:pos) { return }
+            $null = $fs.Seek($script:pos, 'Begin'); $buf = New-Object byte[] ($fs.Length - $script:pos); $n = $fs.Read($buf, 0, $buf.Length); $script:pos += $n
+        } finally { $fs.Dispose() }
+    } catch { return }
+    $text = $script:rest + $script:enc.GetString($buf, 0, $n)
+    $lines = $text -split "`n"; $script:rest = $lines[-1]
+    for ($k = 0; $k -lt $lines.Count - 1; $k++) { Read-Line $lines[$k] }
+}
+function Start-Install {
+    if (($script:mode -in @('update', 'repair', 'continue')) -and (Running-In $script:dir)) {
+        $m = 'Close AETHER AR first (press Stop in its window, then close it).'
+        if ($env:AETHER_SETUP_AUTO -eq '1') { Show-Fail $m } else { Say-Box "$m`n`nThen press $($install.Text) again." 'Information' }
+        return
+    }
+    Show-Page $pgRun
+    foreach ($s in $steps) { $s.icon.Text = $sym.wait; $s.icon.ForeColor = $dim; $s.label.ForeColor = $dim; $s.label.Font = Font 11 }
+    $runTitle.Text = $(if ($script:mode -in 'update', 'repair') { 'Updating AETHER AR' } else { 'Installing AETHER AR' })
+    $script:active = ''; $script:sawDone = $false; $script:reason = ''; $script:frac = 0.0; $script:shown = 0.0; $script:bigN = 0; $script:pos = 0L; $script:rest = ''
+    $script:started = Get-Date; $detail.Text = 'Starting ...'; $permit.Text = ''
+    Remove-Item -LiteralPath $raw, $errLog -ErrorAction SilentlyContinue
+    Log-Close; Log-Open
+    Log-Write "AETHER AR $version Setup, $(Get-Date -Format 'yyyy-MM-dd HH:mm'), Windows $([Environment]::OSVersion.Version)"
+    Log-Write "disc: $($script:iso)"; Log-Write "folder: $($script:dir) ($($script:mode))"; Log-Write ''
+    $env:PYTHONUNBUFFERED = '1'        # (the build's own lines come as they happen, not in blocks)
+    $env:AETHER_SETUP_STEPS = '1'      # (the installers print their "[step]" lines only for this window)
+    $env:GIT_TERMINAL_PROMPT = '0'; $env:GCM_INTERACTIVE = 'never'   # (a git password prompt would wait unseen: it fails, and says so)
+    $a = "-NoProfile -ExecutionPolicy Bypass -File `"$installer`" -Iso `"$($script:iso)`" -Dir `"$($script:dir)`" -Yes -NoLaunch -NoTranscript"
+    if ($env:AETHER_SETUP_NOSHORTCUTS -eq '1') { $a += ' -NoShortcuts' }   # (QA: a test install keeps the player's desktop shortcut)
+    try { $script:proc = Start-Process powershell -ArgumentList $a -WindowStyle Hidden -PassThru -RedirectStandardOutput $raw -RedirectStandardError $errLog -ErrorAction Stop }
+    catch { Show-Fail "Windows did not start the installer: $($_.Exception.Message)"; return }
+    $null = $script:proc.Handle   # (without it Windows PowerShell reports no exit code later)
+    Keep-Awake $true
+    Set-Step 'check'; Update-Bar; $timer.Start()
+}
+function Fill-Done {
+    $iso = $script:iso
+    if ($iso -and $iso.StartsWith($pkg.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) {
+        $keepIso.ForeColor = $orange
+        $keepIso.Text = Nice "Your disc image ($([IO.Path]::GetFileName($iso))) is inside this Setup folder. AETHER AR reads it every time you play: move it e.g. to Documents before you delete this folder, then choose it again in the AETHER AR window."
+    } else {
+        $keepIso.ForeColor = $white
+        $keepIso.Text = Nice "Keep your disc image where it is ($iso): AETHER AR reads it every time you play. You can delete the ZIP and this Setup folder."
+    }
+    $tips.SetToolTip($keepIso, $keepIso.Text)
+    $startHere.Text = Nice "In $($script:dir), ""AETHER AR - START HERE.txt"" has all of this again, and how to update or remove AETHER AR (Settings > Apps)."
+}
+function Show-Fail([string]$m) {
+    $timer.Stop(); Keep-Awake $false
+    $m = Gui-Text $m; $why.Text = $m.Replace("`r`n", "`n").Replace("`n", "`r`n"); Show-Page $pgFail   # (a TextBox breaks lines only at CR LF)
+    Log-Write ''; Log-Write "RESULT: stopped -- $m"; Log-Close
+    if ($env:AETHER_SETUP_RESULT) { try { [IO.File]::WriteAllText($env:AETHER_SETUP_RESULT, "FAILED: $m") } catch { } }
+    if ($env:AETHER_SETUP_AUTO -eq '1') { $f.Close() }
+}
+function Finish {
+    $timer.Stop(); Read-New; if ($script:rest) { Read-Line $script:rest; $script:rest = '' }
+    # what went to stderr goes to the end of the log (git's and the tools' own words), without their progress lines
+    $errLines = @(); try { if (Test-Path -LiteralPath $errLog) { $errLines = @(Get-Content -LiteralPath $errLog | ForEach-Object { ($_.TrimEnd("`r") -split "`r")[-1].TrimEnd() } | Where-Object { $_.Trim() -and $_ -notmatch $noise }) } } catch { }
+    if ($errLines.Count) { Log-Write ''; Log-Write '---- error output ----'; foreach ($e in $errLines) { Log-Write $e } }
+    $code = $script:proc.ExitCode; $script:proc = $null
+    if ($code -eq 0 -and $script:sawDone) {
+        Keep-Awake $false; Update-Bar
+        $doneTitle.Text = $(if ($script:mode -in 'update', 'repair') { "AETHER AR is updated to $version." } else { 'AETHER AR is installed.' })
+        Log-Write ''; Log-Write 'RESULT: installed'; Log-Close
+        Fill-Done; Show-Page $pgDone
+        if ($env:AETHER_SETUP_RESULT) { try { [IO.File]::WriteAllText($env:AETHER_SETUP_RESULT, "OK $($script:dir)") } catch { } }
+        if ($env:AETHER_SETUP_AUTO -eq '1') { $f.Close() }
+        return
+    }
+    $m = $script:reason
+    if (-not $m -and $code -eq 3) { $m = 'Another AETHER AR install is already running. Let it finish (or close it), then press Try again.' }
+    if (-not $m) { $m = "The installer stopped (code $code) without saying why. Open the log to see the last thing it did." }
+    # the cause is often only in the tools' own words (git: "fatal: unable to access ... Could not resolve host")
+    $cause = $errLines | Where-Object { $_ -match '^(fatal|error|ERROR)[: ]' } | Select-Object -Last 1
+    if ($cause -match 'resolve host|Failed to connect|timed out|Connection (reset|refused)|early EOF|RPC failed|SSL|unable to access') {
+        $m = "No connection to GitHub (or it broke off) -- check the internet connection, then press Try again.`n`n($cause)"
+    } elseif ($cause) { $m = "$m`n`n($cause)" }
+    Show-Fail $m
+}
+$timer = New-Object System.Windows.Forms.Timer; $timer.Interval = 500
+$script:lastShot = Get-Date
+$timer.Add_Tick({
+    Read-New; Update-Bar
+    if ($env:AETHER_SETUP_SHOTS -and ((Get-Date) - $script:lastShot).TotalSeconds -ge 60) {   # (QA: the window once a minute)
+        $script:lastShot = Get-Date
+        try { $bmp = New-Object System.Drawing.Bitmap($f.Width, $f.Height); $g = [System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($f.Location, [System.Drawing.Point]::Empty, $f.Size); $g.Dispose()
+              $bmp.Save((Join-Path $env:AETHER_SETUP_SHOTS ('run-{0:HHmmss}.png' -f (Get-Date)))); $bmp.Dispose() } catch { }
+    }
+    if ($script:proc -and $script:proc.HasExited) { Finish }
+})
+function Stop-Install {   # true when it stopped (or nothing ran)
+    if (-not $script:proc -or $script:proc.HasExited) { return $true }
+    $a = [System.Windows.Forms.MessageBox]::Show("Stop the install now?`n`nWhat is done so far is kept: run Setup again later and it continues.", 'AETHER AR Setup', 'YesNo', 'Question')
+    if ($a -ne 'Yes') { return $false }
+    if (-not $script:proc -or $script:proc.HasExited) { return $true }   # (it finished while the question was open: its own result stands)
+    $timer.Stop()
+    $eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'   # (its words on stderr are no error)
+    try { & taskkill.exe /T /F /PID $script:proc.Id 2>&1 | Out-Null } catch { }
+    $ErrorActionPreference = $eap
+    $wasTools = $script:active -in 'git', 'tools'
+    $script:proc = $null
+    Show-Fail $('You stopped the install. Press Try again to continue it (what is already done is kept).' +
+                $(if ($wasTools) { "`n`nA Windows installer it had started (Git, Python, Visual Studio) may still be finishing in the background: wait a few minutes before Try again." } else { '' }))
+    return $true
+}
+
+$install.Add_Click({ if ($script:isoOk -and $script:dirOk) { Start-Install } })
+$cancel.Add_Click({ [void](Stop-Install) })
+$retry.Add_Click({ Show-Page $pgSetup; Check-Dir; Check-Link })
+foreach ($b in $openLog1, $openLog4) { $b.Add_Click({ if (Test-Path -LiteralPath $log) { Start-Process notepad.exe -ArgumentList "`"$log`"" } }) }
+foreach ($b in $close1, $close3, $close4) { $b.Add_Click({ $f.Close() }) }
+$startAr.Add_Click({
+    $launcher = Join-Path $script:dir 'ar\AetherAR.ps1'
+    # minimized outside, hidden inside: Windows 11 then hands no console to Windows Terminal (a hidden start alone
+    # left a "Windows PowerShell" terminal in the taskbar, and closing it closed the window -- review 01.11.)
+    if (Test-Path -LiteralPath $launcher) { Start-Process powershell -WindowStyle Minimized -ArgumentList "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$launcher`"" }
+    $f.Close()
+})
+$f.Add_FormClosing({ param($s, $e) if ($script:proc -and -not $script:proc.HasExited -and $env:AETHER_SETUP_AUTO -ne '1') { if (-not (Stop-Install)) { $e.Cancel = $true } } })
+
+# ---- start
+# the install Windows knows (written at install, ar\shortcuts.ps1): an update goes there, with its disc (S11) -- not a
+# second 4 GB install in C:\AETHER-AR next to one in D:\
+$known = $env:AETHER_SETUP_KNOWN
+if (-not $known) { try { $known = [string](Get-ItemProperty -LiteralPath 'HKCU:\Software\AETHER-AR' -Name InstallDir -ErrorAction Stop).InstallDir } catch { } }
+if ($known -and (Test-Path -LiteralPath (Join-Path $known 'ar\VERSION'))) { $dirBox.Text = $known }
+Show-Page $pgSetup; Check-Dir; Check-Link; Update-Install
+$f.Add_Shown({
+    $f.Activate()
+    if ($env:AETHER_SETUP_AUTO -eq '1' -or $env:AETHER_SETUP_SNAPSHOT) {   # (QA runs: on a second screen if there is one)
+        $scr2 = [System.Windows.Forms.Screen]::AllScreens | Where-Object { -not $_.Primary } | Select-Object -First 1
+        if ($scr2) { $f.Location = $scr2.WorkingArea.Location }
+    }
+    if ($env:AETHER_SETUP_ISO) { Set-Iso $env:AETHER_SETUP_ISO }
+    if ($env:AETHER_SETUP_DIR) { $dirBox.Text = $env:AETHER_SETUP_DIR }
+    if ($env:AETHER_SETUP_AUTO -eq '1') { if ($script:isoOk -and $script:dirOk) { Start-Install } else { Show-Fail "auto: not ready ($($isoState.Text) / $($dirState.Text))" } }
+    if ($env:AETHER_SETUP_SNAPSHOT) {   # QA: every page as a PNG, then closed
+        $script:shot = 0
+        $snap = New-Object System.Windows.Forms.Timer; $snap.Interval = 900
+        $snap.Add_Tick({ param($t)
+            $names = 'setup', 'run', 'done', 'fail'
+            if ($script:shot -eq 1) { Show-Page $pgRun; $script:started = (Get-Date).AddMinutes(-23); Set-Step 'tools'; $permit.Text = 'Windows is asking for permission now: click Yes. (No window? Click the flashing shield in the taskbar.)'; $detail.Text = 'Visual Studio 2022 Build Tools: installing (a few GB)'; $pct.Text = '31 %      23:00 min'; $fill.Width = 218 }
+            if ($script:shot -eq 2) { Fill-Done; Show-Page $pgDone }
+            if ($script:shot -eq 3) { $why.Text = Gui-Text "No connection to GitHub (or it broke off) -- check the internet connection, then press Try again.`n`n(fatal: unable to access 'https://github.com/z3xox/BT3-Recomp.git/': Could not resolve host: github.com)"; Show-Page $pgFail }
+            $f.Activate(); $f.Refresh(); Start-Sleep -Milliseconds 300
+            $bmp = New-Object System.Drawing.Bitmap($f.Width, $f.Height); $g = [System.Drawing.Graphics]::FromImage($bmp)
+            $g.CopyFromScreen($f.Location, [System.Drawing.Point]::Empty, $f.Size); $g.Dispose()
+            $bmp.Save((Join-Path $env:AETHER_SETUP_SNAPSHOT ("setup-{0}.png" -f $names[$script:shot]))); $bmp.Dispose()
+            $script:shot++; if ($script:shot -ge 4) { $t.Stop(); $f.Close() }
+        })
+        $snap.Start()
+    }
+})
+# a screen lower than the window: the window shrinks and scrolls
+$wa = [System.Windows.Forms.Screen]::FromPoint([System.Windows.Forms.Cursor]::Position).WorkingArea
+if ($f.Height -gt $wa.Height) { $f.AutoScroll = $true; $f.Height = $wa.Height }
+[void]$f.ShowDialog()
+Keep-Awake $false; Log-Close
+try { $guiLock.ReleaseMutex() } catch { }
+} catch {
+    $m = "$($_.Exception.Message)"
+    try { [IO.File]::WriteAllText((Join-Path $pkg 'setup-error.txt'), "AETHER AR Setup could not start: $m`r`n$($_.ScriptStackTrace)") } catch { }
+    Say-Box "AETHER AR Setup could not start:`n`n$m`n`n(The details are in setup-error.txt next to ""Install AETHER AR.cmd"".)" 'Error'
+    exit 1
+}
diff --git a/ar/shortcuts.ps1 b/ar/shortcuts.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..5f28365cde254764ec075058abf18cc67c4d1c71
--- /dev/null
+++ b/ar/shortcuts.ps1
@@ -0,0 +1,277 @@
+# AETHER AR -- its place in Windows: the "AETHER AR" shortcuts (desktop + Start menu), the entry in Settings > Apps,
+# and the Link passthrough edge fix (a user environment variable, see the end of this file). Dot-sourced, it only
+# defines functions:
+#   ar\install.ps1    Set-AetherShortcuts $ar; Register-AetherApp $ar      (at install; not under -NoShortcuts)
+#                     Enable-AetherLinkEdgeFix                             (at install, unless it is off in Options)
+#   ar\AetherAR.ps1   Set-AetherShortcuts $ar -Repair                      (at every start of the window)
+#                     Enable-/Disable-AetherLinkEdgeFix, Get-AetherLinkEdge, Restart-AetherLinkServer (its line, Start)
+#   (ar\uninstall.ps1 undoes the edge fix with its own copy of Disable-AetherLinkEdgeFix: it needs nothing from the
+#   folder it deletes)
+# All per user (HKCU, the user's own Start menu): no admin rights.
+# The -Desktop/-Programs/-RegName parameters exist for tests only: a test points them at a scratch folder and a test
+# key name, so the player's own shortcuts and entry are never touched. A test key name also moves the edge fix's
+# variable to a stand-in key (Get-AetherEnvKey): a test never changes the user's real environment.
+
+$script:AetherDescription = 'AETHER AR -- Budokai Tenkaichi 3 in your room (Meta Quest)'
+
+# A path inside the single quotes of a -Command: every ' doubled
+function Aether-Quote([string]$s) { return "'" + $s.Replace("'", "''") + "'" }
+
+# What the shortcut runs: powershell.exe always exists, so a shortcut to a moved or deleted folder used to do nothing at
+# all on a click. The guard says so in a box instead. (Minimized outside via the shortcut's WindowStyle 7, hidden
+# inside: Windows 11 then hands the console to no Windows Terminal window -- review 01.11.)
+function Get-AetherLaunchArgs([string]$ArDir) {
+    $root = Split-Path -Parent $ArDir
+    $msg = "AETHER AR is no longer in $root (moved or removed). Start it with AETHER AR.cmd in its new folder, or install it again with Install AETHER AR.cmd from the AETHER AR package."
+    $a = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command `"`$p=$(Aether-Quote (Join-Path $ArDir 'AetherAR.ps1')); " +
+         "if (Test-Path -LiteralPath `$p) { & `$p } else { Add-Type -AssemblyName System.Windows.Forms; " +
+         "[void][System.Windows.Forms.MessageBox]::Show($(Aether-Quote $msg),'AETHER AR') }`""
+    # (a shortcut's arguments end at 1024 characters; the install folder is at most 40, so this is far below -- the
+    # plain start is the safe side if it ever were not)
+    if ($a.Length -gt 1000) { $a = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$(Join-Path $ArDir 'AetherAR.ps1')`"" }
+    return $a
+}
+
+# The AetherAR.ps1 a shortcut starts ('' when it is no AETHER AR shortcut). Old shortcuts (-File "...") count too.
+function Get-AetherLinkTarget([string]$lnk) {
+    if (-not (Test-Path -LiteralPath $lnk -PathType Leaf)) { return '' }
+    try { $a = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk).Arguments } catch { return '' }
+    $m = [regex]::Match("$a", "(?i)[A-Za-z]:\\.*?\\AetherAR\.ps1")
+    if (-not $m.Success) { return '' }
+    return $m.Value.Replace("''", "'")
+}
+function Test-AetherSamePath([string]$a, [string]$b) {
+    if (-not $a -or -not $b) { return $false }
+    try { $a = [IO.Path]::GetFullPath($a).TrimEnd('\'); $b = [IO.Path]::GetFullPath($b).TrimEnd('\') } catch { }
+    return [string]::Equals($a, $b, [StringComparison]::OrdinalIgnoreCase)
+}
+
+function Write-AetherLink([string]$lnk, [string]$ArDir) {
+    $dir = Split-Path -Parent $lnk
+    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
+    $l = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)
+    $l.TargetPath = 'powershell.exe'
+    $l.Arguments = Get-AetherLaunchArgs $ArDir
+    $l.WorkingDirectory = $ArDir
+    $ico = Join-Path $ArDir 'aether-ar.ico'
+    $l.IconLocation = $(if (Test-Path -LiteralPath $ico) { "$ico,0" } else { "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe,0" })
+    $l.Description = $script:AetherDescription
+    $l.WindowStyle = 7   # (minimized: see Get-AetherLaunchArgs)
+    $l.Save()
+}
+
+# The folder Windows knows as the AETHER AR install (HKCU:\Software\AETHER-AR InstallDir), or ''
+function Get-AetherInstallDir([string]$RegName = 'AETHER-AR') {
+    try { return [string](Get-ItemProperty -LiteralPath "HKCU:\Software\$RegName" -Name InstallDir -ErrorAction Stop).InstallDir } catch { return '' }
+}
+
+# Without -Repair (install time): both shortcuts written for this folder.
+# With -Repair (the window, at every start): the Start-menu entry is put back when it is missing, or re-pointed when it
+# points to a folder that is gone (moved); the desktop one only re-pointed when it exists and points to a gone folder --
+# a desktop shortcut the player deleted stays deleted. Only for the install Windows knows (InstallDir), or when none is
+# known or that one is gone: a second, test install (installed with -NoShortcuts) never takes the player's entries.
+# A moved install also takes its Settings > Apps entry along. Never throws; returns what it wrote.
+function Set-AetherShortcuts([string]$ArDir, [switch]$Repair, [string]$Desktop, [string]$Programs, [string]$RegName = 'AETHER-AR') {
+    $done = @()
+    try {
+        $ArDir = [IO.Path]::GetFullPath($ArDir).TrimEnd('\')
+        if (-not $Desktop) { $Desktop = [Environment]::GetFolderPath('Desktop') }
+        if (-not $Programs) { $Programs = [Environment]::GetFolderPath('Programs') }
+        $deskLnk = Join-Path $Desktop 'AETHER AR.lnk'; $startLnk = Join-Path $Programs 'AETHER AR.lnk'
+        $me = Join-Path $ArDir 'AetherAR.ps1'
+        if (-not $Repair) {
+            foreach ($lnk in $startLnk, $deskLnk) { try { Write-AetherLink $lnk $ArDir; $done += $lnk } catch { } }
+            return $done
+        }
+        $known = Get-AetherInstallDir $RegName
+        $knownAlive = $known -and (Test-Path -LiteralPath (Join-Path $known 'ar\AetherAR.ps1'))
+        if ($knownAlive -and -not (Test-AetherSamePath $known (Split-Path -Parent $ArDir))) { return $done }   # (another install owns them)
+        $t = Get-AetherLinkTarget $startLnk
+        if (-not $t -or (-not (Test-AetherSamePath $t $me) -and -not (Test-Path -LiteralPath $t))) {
+            try { Write-AetherLink $startLnk $ArDir; $done += $startLnk } catch { }
+        }
+        $t = Get-AetherLinkTarget $deskLnk
+        if ($t -and -not (Test-AetherSamePath $t $me) -and -not (Test-Path -LiteralPath $t)) {
+            try { Write-AetherLink $deskLnk $ArDir; $done += $deskLnk } catch { }
+        }
+        # the folder was moved: Settings > Apps follows it (its Uninstall would otherwise say "no longer there")
+        if ($known -and -not $knownAlive) { try { Register-AetherApp $ArDir -RegName $RegName; $done += "HKCU:\Software\$RegName" } catch { } }
+    } catch { }
+    return $done
+}
+
+# Size of a folder in bytes (the shell's own count first: it takes a second for the ~55,000 files of an install)
+function Get-AetherFolderBytes([string]$dir) {
+    # (with a path over 260 characters inside, its Size is empty rather than an error: then counted file by file)
+    $n = $null; try { $n = (New-Object -ComObject Scripting.FileSystemObject).GetFolder($dir).Size } catch { }
+    if ($null -ne $n -and "$n" -ne '') { return [double]$n }
+    $s = (Get-ChildItem -LiteralPath $dir -Recurse -Force -File -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
+    return [double]$s
+}
+
+# The entry in Settings > Apps (HKCU: no admin) and the install folder for the next Setup (S11: it finds the install
+# and its disc). Uninstall runs ar\uninstall.ps1 -- guarded like the shortcut: when the folder is gone already, the
+# entry removes itself and says so (else it would stay in the list for good).
+function Register-AetherApp([string]$ArDir, [string]$RegName = 'AETHER-AR') {
+    $ArDir = [IO.Path]::GetFullPath($ArDir).TrimEnd('\')
+    $root = Split-Path -Parent $ArDir
+    $version = ''; try { $version = (Get-Content -LiteralPath (Join-Path $ArDir 'VERSION') -TotalCount 1 -ErrorAction Stop).Trim() } catch { }
+    $key = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\$RegName"
+    $un = Join-Path $ArDir 'uninstall.ps1'
+    $gone = "AETHER AR is no longer in $root (it was removed or moved), so there is nothing to uninstall there. Its entry is now removed from this list."
+    $cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command `"`$p=$(Aether-Quote $un); " +
+           "if (Test-Path -LiteralPath `$p) { & `$p } else { Remove-Item -LiteralPath $(Aether-Quote $key) -Recurse -ErrorAction SilentlyContinue; " +
+           "Add-Type -AssemblyName System.Windows.Forms; [void][System.Windows.Forms.MessageBox]::Show($(Aether-Quote $gone),'AETHER AR') }`""
+    $kb = [int][Math]::Min([int]::MaxValue, [Math]::Ceiling((Get-AetherFolderBytes $root) / 1KB))
+    if (-not (Test-Path -LiteralPath $key)) { New-Item -Path $key -Force | Out-Null }
+    $str = [ordered]@{ DisplayName = 'AETHER AR'; DisplayVersion = $version; Publisher = 'AETHER (unofficial fan mod)'
+                       DisplayIcon = (Join-Path $ArDir 'aether-ar.ico'); InstallLocation = $root; UninstallString = $cmd
+                       InstallDate = (Get-Date -Format 'yyyyMMdd') }
+    foreach ($n in $str.Keys) { New-ItemProperty -LiteralPath $key -Name $n -PropertyType String -Value $str[$n] -Force | Out-Null }
+    foreach ($n in 'NoModify', 'NoRepair') { New-ItemProperty -LiteralPath $key -Name $n -PropertyType DWord -Value 1 -Force | Out-Null }
+    New-ItemProperty -LiteralPath $key -Name EstimatedSize -PropertyType DWord -Value $kb -Force | Out-Null
+    $sw = "HKCU:\Software\$RegName"
+    if (-not (Test-Path -LiteralPath $sw)) { New-Item -Path $sw -Force | Out-Null }
+    New-ItemProperty -LiteralPath $sw -Name InstallDir -PropertyType String -Value $root -Force | Out-Null
+}
+
+# A tool the install put on this PC (its winget id): the uninstaller names it at the end ("it stays, other programs may
+# use it"). It is kept outside the install folder, which the uninstaller deletes. Never throws.
+function Add-AetherInstalledTool([string]$Id, [string]$RegName = 'AETHER-AR') {
+    if (-not $Id) { return }
+    try {
+        $sw = "HKCU:\Software\$RegName"
+        if (-not (Test-Path -LiteralPath $sw)) { New-Item -Path $sw -Force | Out-Null }
+        $have = @(); try { $have = @((Get-ItemProperty -LiteralPath $sw -Name InstalledTools -ErrorAction Stop).InstalledTools | Where-Object { $_ }) } catch { }
+        if ($have -notcontains $Id) { New-ItemProperty -LiteralPath $sw -Name InstalledTools -PropertyType MultiString -Value ([string[]]($have + $Id)) -Force | Out-Null }
+    } catch { }
+}
+
+# ---- The Link passthrough edge fix (1.0.14)
+# Testers saw a black, slightly offset "shadow" behind the fighters and behind the aiming ray; the developer's PC showed
+# none. It is Meta Horizon Link's: it sends the picture's transparency (alpha) with its default scheme "downscale" and
+# scales it up again in the headset about 1.5 % too tall, so every bright object gets a black band along one edge
+# (measured 14.10.: 11 px on average, 0 px with the fix). Link's own setting RemoteHeadset/AlphaPreprocessingScheme = 0
+# ("alphaAsIsInYplane", the alpha at full size) cures it. Link takes it from the USER environment variable below (not
+# from the registry -- tried), and only when its server OVRServer_x64 starts. The developer had set it by hand and the
+# mod never did: testers had the edge. Now the install and the window set it (per user: no admin), the window restarts
+# Link's server once so it is read (Restart-AetherLinkServer, with a word first), and the uninstaller puts back exactly
+# what was there. Only this one variable: Link's streaming ones (REMOTEHEADSET_HEVC / DBR / DBRMAX) are never touched.
+# What was there is noted once, in HKCU:\Software\<RegName> (the key the uninstaller reads before it removes it):
+#   LinkAlphaNoted   1 = noted (the first time AETHER AR turned the fix on)
+#   LinkAlphaHad     1 = the variable existed then, LinkAlphaPrev = its value (a '0' of the player's own stays for good)
+#   LinkAlphaSetAt   when AETHER AR last wrote it (UTC, round-trip text): an OVRServer_x64 started before has not read it
+#   LinkAlphaTried   the LinkAlphaSetAt a Link restart was made for: at most one restart per change
+$script:AetherLinkAlphaVar = 'REMOTEHEADSET_ALPHAPREPROCCESINGSCHEME'   # (Link's own spelling, "PREPROCCESING")
+$script:AetherLinkNoteNames = @('LinkAlphaNoted', 'LinkAlphaHad', 'LinkAlphaPrev', 'LinkAlphaSetAt', 'LinkAlphaTried')
+
+# Where the variable lives: '' = the user's real environment (HKCU\Environment, through .NET: Windows is told);
+# a test RegName (not 'AETHER-AR') = the stand-in key HKCU:\Software\<RegName>-Environment
+function Get-AetherEnvKey([string]$RegName) { if ($RegName -and $RegName -ne 'AETHER-AR') { return "HKCU:\Software\$RegName-Environment" }; return '' }
+function Get-AetherUserEnv([string]$Name, [string]$RegName = 'AETHER-AR') {
+    $k = Get-AetherEnvKey $RegName
+    if (-not $k) { return [Environment]::GetEnvironmentVariable($Name, 'User') }
+    try { return [string](Get-ItemProperty -LiteralPath $k -Name $Name -ErrorAction Stop).$Name } catch { return $null }
+}
+# ($Value $null or '' removes it -- untyped: a [string] parameter would turn $null into '')
+function Set-AetherUserEnv([string]$Name, $Value, [string]$RegName = 'AETHER-AR') {
+    $k = Get-AetherEnvKey $RegName
+    if (-not $k) { [Environment]::SetEnvironmentVariable($Name, $(if ([string]::IsNullOrEmpty($Value)) { $null } else { [string]$Value }), 'User'); return }
+    if ([string]::IsNullOrEmpty($Value)) { Remove-ItemProperty -LiteralPath $k -Name $Name -ErrorAction SilentlyContinue; return }
+    if (-not (Test-Path -LiteralPath $k)) { New-Item -Path $k -Force | Out-Null }
+    New-ItemProperty -LiteralPath $k -Name $Name -PropertyType String -Value ([string]$Value) -Force | Out-Null
+}
+function Get-AetherLinkNote([string]$RegName = 'AETHER-AR') {
+    try { $n = Get-ItemProperty -LiteralPath "HKCU:\Software\$RegName" -ErrorAction Stop } catch { return $null }
+    if ("$($n.LinkAlphaNoted)" -ne '1') { return $null }
+    return $n
+}
+function Set-AetherLinkNote([string]$RegName, [string]$Name, [string]$Type, $Value) {
+    $sw = "HKCU:\Software\$RegName"
+    if (-not (Test-Path -LiteralPath $sw)) { New-Item -Path $sw -Force | Out-Null }
+    New-ItemProperty -LiteralPath $sw -Name $Name -PropertyType $Type -Value $Value -Force | Out-Null
+}
+
+# On: the variable at '0' for this user; what was there noted first (once). $true when it wrote the variable (Link has
+# to restart to read it), $false when it was '0' already (nothing changed, nothing to restart). Throws when it cannot.
+function Enable-AetherLinkEdgeFix([string]$RegName = 'AETHER-AR') {
+    $name = $script:AetherLinkAlphaVar
+    $cur = Get-AetherUserEnv $name $RegName
+    if (-not (Get-AetherLinkNote $RegName)) {   # (noted in full before the variable is touched, "Noted" last)
+        $had = -not [string]::IsNullOrEmpty($cur)
+        if ($had) { Set-AetherLinkNote $RegName 'LinkAlphaPrev' String "$cur" }
+        else { Remove-ItemProperty -LiteralPath "HKCU:\Software\$RegName" -Name 'LinkAlphaPrev' -ErrorAction SilentlyContinue }
+        Set-AetherLinkNote $RegName 'LinkAlphaHad' DWord ([int]$had)
+        Set-AetherLinkNote $RegName 'LinkAlphaNoted' DWord 1
+    }
+    if ("$cur" -eq '0') { return $false }
+    Set-AetherUserEnv $name '0' $RegName
+    if ((Get-AetherUserEnv $name $RegName) -ne '0') { throw "the user setting $name could not be written" }
+    Set-AetherLinkNote $RegName 'LinkAlphaSetAt' String ([datetime]::UtcNow.ToString('o'))
+    return $true
+}
+
+# Off (Options), the same as the uninstaller's: the variable back to what the note says was there -- removed when there
+# was none, the old value when there was one. Only while it still holds AETHER AR's '0': a '0' of the player's own from
+# before stays, and so does a value set since (theirs). The note goes (turned on again, it is noted afresh). Returns
+# 'removed', 'restored', 'kept' or '' (nothing was noted).
+function Disable-AetherLinkEdgeFix([string]$RegName = 'AETHER-AR') {
+    $n = Get-AetherLinkNote $RegName
+    if (-not $n) { return '' }
+    $name = $script:AetherLinkAlphaVar
+    $did = 'kept'
+    if ((Get-AetherUserEnv $name $RegName) -eq '0') {
+        if ("$($n.LinkAlphaHad)" -ne '1') { Set-AetherUserEnv $name $null $RegName; $did = 'removed' }
+        elseif ("$($n.LinkAlphaPrev)" -ne '0') { Set-AetherUserEnv $name "$($n.LinkAlphaPrev)" $RegName; $did = 'restored' }
+    }
+    foreach ($v in $script:AetherLinkNoteNames) { Remove-ItemProperty -LiteralPath "HKCU:\Software\$RegName" -Name $v -ErrorAction SilentlyContinue }
+    return $did
+}
+
+# The state, for the window's line and its Start: On (the variable is '0'), Running (Link's server), Stale (it runs
+# since before AETHER AR wrote the variable: it has not read it), RestartDue (stale, and no restart made for this change
+# yet), plus the raw values for a report. A server whose start time cannot be read counts as not stale: nothing to
+# compare (it reads the variable at its next start anyway).
+function Get-AetherLinkEdge([string]$RegName = 'AETHER-AR', [string]$ProcessName = 'OVRServer_x64') {
+    $cur = Get-AetherUserEnv $script:AetherLinkAlphaVar $RegName
+    $n = Get-AetherLinkNote $RegName
+    $setAt = $null
+    if ($n -and $n.LinkAlphaSetAt) {
+        try { $setAt = [datetime]::Parse("$($n.LinkAlphaSetAt)", [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::RoundtripKind).ToUniversalTime() } catch { }
+    }
+    $tried = [bool]($setAt -and "$($n.LinkAlphaTried)" -eq "$($n.LinkAlphaSetAt)")
+    $srv = @(Get-Process $ProcessName -ErrorAction SilentlyContinue)
+    $started = $null
+    foreach ($p in $srv) { try { $t = $p.StartTime.ToUniversalTime(); if (-not $started -or $t -lt $started) { $started = $t } } catch { } }
+    $stale = [bool](($cur -eq '0') -and $setAt -and $started -and $started -lt $setAt)
+    return [pscustomobject]@{ Value = $cur; On = ($cur -eq '0'); Noted = [bool]$n; Running = [bool]$srv.Count; ServerStart = $started
+                              SetAt = $setAt; Stale = $stale; Tried = $tried; RestartDue = ($stale -and -not $tried) }
+}
+
+# Link's server restarted, so it reads the variable: OVRServer_x64 only. It runs under the player's own account, and
+# Meta's service (OVRService, SYSTEM) starts it again at once, with the user's new environment. Never the service,
+# never another process. A running Link session in the headset drops (the player turns Link on again there). The try is
+# noted first (LinkAlphaTried): at most one restart per change, whatever happens. Waits up to $TimeoutSec for the new
+# server, then $SettleSec more for it to come up ($Pump keeps a window alive meanwhile). Returns Back (the new server
+# runs), Stopped (the old one could be stopped) and Why (what went wrong, '' when it is back).
+function Restart-AetherLinkServer([string]$RegName = 'AETHER-AR', [string]$ProcessName = 'OVRServer_x64', [int]$TimeoutSec = 30, [int]$SettleSec = 5, [scriptblock]$Pump) {
+    $n = Get-AetherLinkNote $RegName
+    if ($n -and $n.LinkAlphaSetAt) { try { Set-AetherLinkNote $RegName 'LinkAlphaTried' String "$($n.LinkAlphaSetAt)" } catch { } }
+    $old = @(Get-Process $ProcessName -ErrorAction SilentlyContinue)
+    if (-not $old.Count) { return [pscustomobject]@{ Back = $true; Stopped = $false; Why = '' } }   # (not running: it reads it when it starts)
+    $ids = @($old | ForEach-Object { $_.Id })
+    foreach ($p in $old) {
+        try { Stop-Process -Id $p.Id -ErrorAction Stop }
+        catch { if (Get-Process -Id $p.Id -ErrorAction SilentlyContinue) { return [pscustomobject]@{ Back = $false; Stopped = $false; Why = $_.Exception.Message } } }   # (gone by itself meanwhile: fine)
+    }
+    $wait = { param([int]$ms) $end = [datetime]::UtcNow.AddMilliseconds($ms); do { if ($Pump) { & $Pump }; Start-Sleep -Milliseconds 100 } while ([datetime]::UtcNow -lt $end) }
+    $until = [datetime]::UtcNow.AddSeconds($TimeoutSec)
+    while ([datetime]::UtcNow -lt $until) {
+        & $wait 400
+        if (@(Get-Process $ProcessName -ErrorAction SilentlyContinue | Where-Object { $ids -notcontains $_.Id }).Count) {
+            & $wait ($SettleSec * 1000)
+            return [pscustomobject]@{ Back = $true; Stopped = $true; Why = '' }
+        }
+    }
+    return [pscustomobject]@{ Back = $false; Stopped = $true; Why = "it did not start again within $TimeoutSec seconds" }
+}
diff --git a/ar/start-ar.ps1 b/ar/start-ar.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..9619cca9672381b66bc4767393efb9013062a93a
--- /dev/null
+++ b/ar/start-ar.ps1
@@ -0,0 +1,209 @@
+# AETHER AR -- start the game in the headset (Meta Quest over Link / Air Link, passthrough).
+#   start-ar.ps1           the room mode: 20 cm fighters fight in your room, your walls and furniture block them
+#   start-ar.ps1 -Screen   the screen mode: the whole game on a floating screen (no room), e.g. for the story
+# Settings come from ar\config.json (written by install.ps1, changed in the launcher window): the ISO, adb, the mode,
+# the room source, boundary, quick start.
+# What it is doing goes to ar\status.txt (one line; the AETHER AR window shows it -- this script runs minimized), and
+# whatever needs the player goes into a message box, never only into this window (release audit 31.10.).
+param([switch]$Screen)
+$ErrorActionPreference = 'Continue'   # adb notes on stderr must not end the script
+$ar = $PSScriptRoot
+$root = Split-Path -Parent $ar
+$env:ADB_MDNS = '0'   # no mDNS in an adb server started here: no Windows Firewall question (see AetherAR.ps1)
+$statusFile = Join-Path $ar 'status.txt'
+# (not "closing this ends the game": the game is a window of its own -- release audit 31.10.)
+$Host.UI.RawUI.WindowTitle = 'AETHER AR -- start script (use Stop in the AETHER AR window)'
+function Status($m) { Write-Host "[start-ar] $m"; try { [IO.File]::WriteAllText($statusFile, $m) } catch { } }
+function Tell($m, $icon = 'Information') {
+    Status $m
+    Add-Type -AssemblyName System.Windows.Forms
+    $owner = New-Object System.Windows.Forms.Form -Property @{ TopMost = $true; ShowInTaskbar = $false }
+    [void][System.Windows.Forms.MessageBox]::Show($owner, $m, 'AETHER AR', 'OK', $icon)
+    $owner.Dispose()
+}
+
+# one start at a time: a second Start (or a second launcher window) would run two games on one headset and one save
+$mutex = New-Object System.Threading.Mutex($false, 'Local\AetherAR-start')
+$owned = $false
+# (abandoned = the start script before was killed by Stop / Restart: the lock is this one's now)
+try { $owned = $mutex.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $owned = $true }
+# said, not a silent exit (release audit 31.10.); the window keeps this line (it maps only its own stale lines to
+# "Not running")
+if (-not $owned) { Status 'AETHER AR is already starting or running in another window -- press Stop there (or close its message) first.'; exit 3 }
+
+$cfgPath = Join-Path $ar 'config.json'
+# (the AETHER AR window shows Install in this state -- Repair only once it is installed)
+if (-not (Test-Path $cfgPath)) { Tell "AETHER AR is not installed yet. Press Install in the AETHER AR window (or run 'Install AETHER AR.cmd' from the AETHER AR package again -- download the ZIP again if you deleted it)." 'Warning'; exit 1 }
+$cfg = Get-Content $cfgPath -Raw | ConvertFrom-Json
+function Opt($name, $default) { if ($cfg.PSObject.Properties.Name -contains $name -and $null -ne $cfg.$name -and "$($cfg.$name)" -ne '') { return $cfg.$name }; return $default }
+if (-not $Screen -and (Opt 'mode' 'room') -eq 'screen') { $Screen = $true }   # (an old config's 'portal' = the room mode)
+$quickStart = [bool](Opt 'quickStart' $true)
+$boundaryOff = [bool](Opt 'boundaryOff' $true)
+$useScan = (Opt 'roomSource' 'quest') -eq 'scan'
+$exeDir = Join-Path $root 'build\ps2xRuntime'
+$exe = Join-Path $exeDir 'ps2EntryRunner.exe'
+$elf = Join-Path $root 'games\bt3\work\SLUS_216.78'
+foreach ($f in @($exe, $elf)) { if (-not (Test-Path $f)) { Tell "The game is not built completely ($f is missing). Press Install in the AETHER AR window to build it again (or run 'Install AETHER AR.cmd' from the AETHER AR package again -- download the ZIP again if you deleted it)." 'Warning'; exit 1 } }
+# (-LiteralPath: [ ] in a file name are no wildcards -- release audit 31.10.)
+if (-not $cfg.iso -or -not (Test-Path -LiteralPath $cfg.iso -PathType Leaf)) { Tell "Your ISO is not at '$($cfg.iso)' any more. In the AETHER AR window press Change disc... and pick it (or plug its drive in), then press Start." 'Warning'; exit 1 }
+if ($useScan -and -not ($cfg.roomScan -and (Test-Path -LiteralPath $cfg.roomScan -PathType Leaf))) { Tell "The detailed room scan '$($cfg.roomScan)' is not there. Choose Room: Quest room in the AETHER AR window." 'Warning'; exit 1 }
+
+# adb (optional): wait for an awake headset in Link, pause the room boundary while the game runs.
+# A real adb.exe only: not in the temp folder, no file description (Google ships none; a dummy adb.exe -- ping.exe,
+# "TCP/IP Ping Command" -- has one). The same choice as the AETHER AR window's Find-Adb.
+function Is-RealAdb($p) {
+    if (-not $p -or -not (Test-Path -LiteralPath $p -PathType Leaf)) { return $false }
+    foreach ($tmp in @([IO.Path]::GetTempPath(), $env:TEMP)) { if ($tmp -and $p.StartsWith($tmp.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) { return $false } }
+    try { return -not [Diagnostics.FileVersionInfo]::GetVersionInfo($p).FileDescription } catch { return $false }
+}
+function Find-Adb {
+    # the adb server that already runs first (another version would restart it and cut off every other program using
+    # it); ours (config / ar\platform-tools) before any other
+    $own = @(@("$($cfg.adb)", (Join-Path $ar 'platform-tools\adb.exe')) | Where-Object { $_ })
+    $run = @(Get-Process adb -ErrorAction SilentlyContinue | Where-Object { $_.Path } | ForEach-Object { $_.Path } | Select-Object -Unique)
+    foreach ($p in $run) { if ($own -contains $p -and (Is-RealAdb $p)) { return $p } }
+    foreach ($p in $run) { if (Is-RealAdb $p) { return $p } }
+    foreach ($p in $own) { if (Is-RealAdb $p) { return $p } }
+    return $null
+}
+# every adb call hidden and with a time limit: its output, or $null when it did not answer (then killed). A hung adb
+# server or a stalled Wi-Fi connection held the start for good (01.11.)
+function Adb([string[]]$a, [int]$ms = 3000) {
+    $psi = New-Object System.Diagnostics.ProcessStartInfo($adb)
+    $psi.Arguments = (@($a | ForEach-Object { if ($_ -eq '' -or $_ -match '[\s"]') { '"' + ($_ -replace '"', '\"') + '"' } else { $_ } })) -join ' '
+    $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true; $psi.RedirectStandardOutput = $true; $psi.RedirectStandardError = $true
+    $p = $null
+    try {
+        $p = [System.Diagnostics.Process]::Start($psi)
+        $out = $p.StandardOutput.ReadToEndAsync(); $null = $p.StandardError.ReadToEndAsync()
+        if (-not $p.WaitForExit($ms)) { try { $p.Kill() } catch { }; Write-Host "[start-ar] adb $($a -join ' '): no answer in $ms ms"; return $null }
+        if (-not $out.Wait(1000)) { return '' }   # (a server it started that holds the pipe: never waited for)
+        return (@($out.Result -split "`r?`n") | Where-Object { $_ -ne '' }) -join "`n"
+    } catch { return '' } finally { if ($p) { $p.Dispose() } }
+}
+$adb = Find-Adb
+$haveAdb = [bool]$adb
+if ($haveAdb) {
+    $null = Adb @('start-server') 8000   # (starting the server takes a few seconds)
+    $all = Adb @('devices')
+    if ($null -eq $all) { Write-Host "[start-ar] adb does not answer -- going on without it"; $haveAdb = $false; $all = '' }
+    $devs = @(($all -split "`n") | Where-Object { $_ -match "`tdevice$" } | ForEach-Object { ($_ -split "`t")[0] })
+    # USB and Wi-Fi (adb tcpip) at once: one serial -- Wi-Fi first, it stays when the cable comes out
+    $wifi = $devs | Where-Object { $_ -match ':\d+$' } | Select-Object -First 1
+    if ($wifi) { $env:ANDROID_SERIAL = $wifi } elseif ($devs) { $env:ANDROID_SERIAL = @($devs)[0] }
+    if ($haveAdb -and -not $devs) { Write-Host "[start-ar] adb sees no headset (USB debugging off?) -- the game waits for the headset itself"; $haveAdb = $false }
+}
+# the boundary back on before anything else: left paused by an earlier run (its window closed), the room never loads
+if ($haveAdb) { $null = Adb @('shell', 'setprop debug.oculus.guardian_pause 0') }
+function Wait-Headset([int]$tries) {
+    if (-not $haveAdb) { return }
+    $said = $false
+    for ($i = 0; $i -lt $tries; $i++) {
+        $power = Adb @('shell', 'dumpsys power | grep mWakefulness=')
+        # the Link app on the headset: com.oculus.xrstreamingclient, since a Quest update (31.10.) com.meta.pclinkservice.server
+        $link = $(if ($null -ne $power) { Adb @('shell', 'pidof com.oculus.xrstreamingclient com.meta.pclinkservice.server') })
+        # (adb stopped answering: the game starts now and waits for the headset itself, with its own message)
+        if ($null -eq $power -or $null -eq $link) { $script:haveAdb = $false; return }
+        if (($power -match 'Awake') -and "$link".Trim()) { return }
+        if (-not $said) { Status 'Waiting for the headset: put it on and start Link in it (Quick Settings > Link, or Air Link). Still waiting with the headset on? Turn on the light -- the headset cannot track in the dark.'; $said = $true }
+        Start-Sleep 2
+    }
+    # (no word from adb for long: the game starts anyway and waits for the headset itself, with its own message)
+}
+Wait-Headset 180
+
+$vars = [ordered]@{
+    PS2X_ELF = $elf; PS2X_CD_IMAGE = $cfg.iso
+    PS2X_SEAMVK = '1'; PS2X_VK_NATIVE = '1'; PS2X_SEAMVK_SCALE = '3'
+    # Quest visual A/B: serialize GS kicks and CPU-decode smaller indexed textures together.
+    PS2X_ASYNC_KICK = '0'
+    PS2X_SEAMVK_GPUDECODE_MIN = '65536'
+    PS2X_AR_XR = '1'
+    PS2X_AUDIO_DEVICE = 'Oculus Virtual Audio'   # the game's sound into the headset
+}
+if ($quickStart) {   # no intro: 8x boot, START tapped through movie and title (on the first start it answers "create a
+                     # save file?" with Yes -- the game makes its own save), straight into the duel menu
+    $vars.PS2X_FORCE_SKIP = '600'; $vars.PS2X_AUTOTITLE = '1'; $vars.PS2X_TURBO = '8'; $vars.PS2X_MENU_JUMP = '38'; $vars.PS2X_MENU_AUTO = '1'
+}
+# the room: the headset's own room (Space Setup, over Link) unless the detailed scan is chosen (a developer option)
+if ($useScan) { $vars.PS2X_AR_SCAN = $cfg.roomScan; if ($cfg.roomWallScan -and (Test-Path -LiteralPath $cfg.roomWallScan -PathType Leaf)) { $vars.PS2X_AR_WALLSCAN = $cfg.roomWallScan } }
+else { $vars.PS2X_AR_SCAN = 'none' }
+if ($Screen) { $vars.PS2X_AR_SCREEN = '1' }
+foreach ($k in @('PS2X_AR_SCAN', 'PS2X_AR_WALLSCAN', 'PS2X_AR_UNITS_PER_M', 'PS2X_AR_SCREEN', 'PS2X_FORCE_SKIP', 'PS2X_AUTOTITLE', 'PS2X_TURBO', 'PS2X_MENU_JUMP', 'PS2X_MENU_AUTO')) { Remove-Item "Env:$k" -ErrorAction SilentlyContinue }
+Write-Host ("[start-ar] mode: {0}, room: {1}, quick start: {2}, boundary off: {3}" -f $(if ($Screen) { 'screen' } else { 'room' }), $(if ($vars.PS2X_AR_SCAN -ne 'none') { 'detailed scan' } else { 'Quest room' }), $quickStart, $boundaryOff)
+foreach ($k in $vars.Keys) { Set-Item "Env:$k" $vars[$k] }
+# the game's own PC window small (640 x 360, not 1280 x 720): it opened over the AETHER AR window and hid its status
+# line and Stop (audit 01.11.; the headset's picture does not depend on it). This process only, not in ar.env; a size
+# set by hand still wins.
+if (-not $env:PS2X_WINDOW_W) { $env:PS2X_WINDOW_W = '640' }
+if (-not $env:PS2X_WINDOW_H) { $env:PS2X_WINDOW_H = '360' }
+# the same for a start from the headset's Link app library (the runner reads savedata\ar.env)
+New-Item -ItemType Directory -Force (Join-Path $exeDir 'savedata') | Out-Null
+# -Encoding Default (the PC's ANSI code page), not ascii: the runner reads the bytes as they are (ifstream, _putenv_s)
+# and opens paths with narrow fopen, i.e. as ANSI -- non-ASCII profile paths used to be corrupted (31.10.)
+# (no byte-order mark: with Windows' "UTF-8 for worldwide language support" the Default encoding is UTF-8 WITH one, and
+# the runner then read "\xEF\xBB\xBFPS2X_ELF" -- review 31.10.)
+$envEnc = [Text.Encoding]::Default; if ($envEnc.CodePage -eq 65001) { $envEnc = New-Object Text.UTF8Encoding($false) }
+[IO.File]::WriteAllLines((Join-Path $exeDir 'savedata\ar.env'), [string[]]@($vars.Keys | ForEach-Object { "$_=$($vars[$_])" }), $envEnc)
+# this process only, not in $vars / ar.env: the game shows its own error box unless this PID is a live process, i.e.
+# unless this script is there to Tell it (a PID, not '1': a dead start script cannot tell anything)
+$env:AETHER_AR_LAUNCHER = "$PID"
+
+$flag = Join-Path $exeDir 'ar-restart.flag'; $rescan = Join-Path $exeDir 'ar-rescan.flag'; $ready = Join-Path $exeDir 'ar-layout.ready'
+$errFile = Join-Path $exeDir 'ar-error.txt'; $gameStatus = Join-Path $exeDir 'ar-status.txt'
+try {
+    for ($run = 1; $run -le 20; $run++) {
+        Remove-Item $flag, $rescan, $ready, $errFile, $gameStatus -ErrorAction SilentlyContinue
+        if ($run -gt 1) { Wait-Headset 300 }
+        Status 'The game is starting (the first start shows the memory card check and the logos for about 25 seconds).'
+        # not started (an antivirus / Smart App Control blocking the fresh exe): said. A blocked Start-Process throws, and
+        # inside this try it ended the whole loop without a word (release audit 31.10.) -- caught here; the finally still
+        # frees the lock and the boundary.
+        $p = $null; $why = ''
+        try { $p = Start-Process -FilePath $exe -WorkingDirectory $exeDir -PassThru -ArgumentList "`"$elf`"" -ErrorAction Stop } catch { $why = $_.Exception.Message }
+        if (-not $p) { Tell "Windows did not start the game ($exe): $why -- is it blocked by your antivirus? Allow it, then press Start." 'Warning'; exit 1 }
+        $null = $p.Handle   # (kept now: without it Windows PowerShell reports no exit code once the process is gone)
+        $lastGame = ''; $playing = $false; $t0 = Get-Date
+        while (-not $p.HasExited) {
+            Start-Sleep 1
+            # what the game says while it waits (for the headset): passed on to the window
+            if (Test-Path $gameStatus) {
+                $g = (Get-Content $gameStatus -Raw -ErrorAction SilentlyContinue)
+                if ($g -and $g -ne $lastGame) { $lastGame = $g; $playing = $false; Status $g.Trim() }
+            }
+            if ((Test-Path $ready) -and $haveAdb -and $boundaryOff) {
+                # the room is read (Space Setup located): the boundary may go now -- paused earlier, the room never loads
+                $null = Adb @('shell', 'setprop debug.oculus.guardian_pause 1')
+                Remove-Item $ready -ErrorAction SilentlyContinue
+                Write-Host "[start-ar] room boundary paused"
+            }
+            # running for 40 s without a stop, or the room read: it plays
+            if (-not $playing -and -not (Test-Path $errFile) -and ($lastGame -notlike 'Waiting*') -and ((Test-Path $ready) -or ((Get-Date) - $t0).TotalSeconds -gt 40)) { $playing = $true; Status 'Playing -- have fun. Press Stop in the AETHER AR window when you are done.' }
+            if ((Test-Path $flag) -or (Test-Path $rescan)) {
+                for ($i = 0; $i -lt 8 -and -not $p.HasExited; $i++) { Start-Sleep 1 }
+                if (-not $p.HasExited) { Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue; Start-Sleep 2 }
+            }
+        }
+        $p.Refresh(); $code = $p.ExitCode
+        if ($haveAdb) { $null = Adb @('shell', 'setprop debug.oculus.guardian_pause 0') }
+        if ($code -eq 44 -or (Test-Path $errFile)) {
+            # [arfail] the game stopped with something the player has to do (no headset, Link settings, no room)
+            $why = if (Test-Path $errFile) { (Get-Content $errFile -Raw).Trim() } else { 'The game could not reach the headset or the room.' }
+            Tell $why 'Warning'
+            exit 0
+        }
+        if (Test-Path $rescan) {
+            # the in-game "read the room again" (menu button held 3 s): the room is read at every start
+            Tell "To change the room: in the headset open Settings > Physical space > Space setup and update this room. Then press Start in the AETHER AR window -- the game reads it anew."
+            exit 0
+        }
+        if (Test-Path $flag) { Status "The headset session was lost -- starting the game again ($run)."; Start-Sleep 3; continue }
+        if ($code -eq 0) { Status 'The game has ended. Press Start to play again.'; exit 0 }
+        Tell "The game stopped unexpectedly (code $code). Press Start to play again. If it happens again, press Report a problem in the AETHER AR window and email the ZIP it saves on your desktop to contact@aether-xr.com." 'Warning'
+        exit 0
+    }
+    Tell 'The headset session was lost again and again -- the game stopped. Restart Link in the headset and the Meta Horizon Link app on this PC (formerly Meta Quest Link) -- or the headset itself --, then press Start.' 'Warning'
+} finally {
+    if ($haveAdb) { $null = Adb @('shell', 'setprop debug.oculus.guardian_pause 0') }
+    $mutex.ReleaseMutex()
+}
diff --git a/ar/uninstall.ps1 b/ar/uninstall.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..10db56941f2192b4c59df0a986c6033c29054623
--- /dev/null
+++ b/ar/uninstall.ps1
@@ -0,0 +1,277 @@
+# AETHER AR -- removes AETHER AR from this PC. Settings > Apps > AETHER AR > Uninstall runs it (no console: plain
+# Windows boxes). ar\install.ps1 registers it there (ar\shortcuts.ps1 Register-AetherApp).
+#   1. copies itself to the temp folder and runs from there (the folder it is in gets deleted),
+#   2. asks: remove <folder> (x GB)? -- and keep the memory card? (a copy to Documents\AETHER AR saves\<date>),
+#   3. stops this folder's AETHER AR window, start script and game (the Quest boundary goes back on), and this folder's
+#      own adb -- never an adb from anywhere else (Android Studio, Unity, SideQuest use theirs),
+#   4. removes the "AETHER AR" shortcuts that point here, the Settings > Apps entry (and puts the Link setting of the
+#      passthrough edge fix back to what was there before AETHER AR), Setup's work folder, then the folder (rd on the
+#      \\?\ path: git's read-only packs and paths over 260 characters go too),
+#   5. names the tools the install added (Git, Python, the build tools): they stay, other programs may use them.
+# Your disc image is never touched.
+#
+# Tests only: -TestDir <scratch folder> with -Root <a fake install inside it> keeps everything in that folder -- the
+# shortcuts it looks at, the saves, Setup's work folder -- uses the registry name -RegName (never the real one), answers
+# the boxes from $env:AETHER_UNINSTALL_ANSWERS ("Yes,No,...") and writes them to <TestDir>\boxes.txt, never runs adb.
+# -TestAdbName <name> (with -TestDir only): the stand-in for this folder's adb has another process name (fakeadb), so no
+# real AETHER AR window on the PC ever takes the stand-in for a running adb server.
+param([string]$Root, [switch]$FromTemp, [string]$TestDir, [string]$RegName = 'AETHER-AR', [string]$TestAdbName)
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Windows.Forms, System.Drawing
+[System.Windows.Forms.Application]::EnableVisualStyles()
+$title = 'Remove AETHER AR'
+if ($TestDir) { $TestDir = [IO.Path]::GetFullPath($TestDir).TrimEnd('\'); if ($RegName -eq 'AETHER-AR') { $RegName = 'AETHER-AR-TEST' } }
+$adbName = $(if ($TestDir -and $TestAdbName) { $TestAdbName } else { 'adb' })
+$tmpDir = $(if ($TestDir) { $TestDir } else { [IO.Path]::GetTempPath().TrimEnd('\') })
+$ulog = Join-Path $tmpDir 'AETHER-AR-uninstall.log'
+function Log([string]$m) { try { Add-Content -LiteralPath $ulog -Value ('{0:yyyy-MM-dd HH:mm:ss} {1}' -f (Get-Date), $m) -Encoding UTF8 } catch { } }
+function Same-Path([string]$a, [string]$b) {
+    if (-not $a -or -not $b) { return $false }
+    try { $a = [IO.Path]::GetFullPath($a).TrimEnd('\'); $b = [IO.Path]::GetFullPath($b).TrimEnd('\') } catch { }
+    return [string]::Equals($a, $b, [StringComparison]::OrdinalIgnoreCase)
+}
+function Under([string]$path, [string]$dir) { return $path -and $path.StartsWith($dir.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase) }
+
+$script:answers = @(); if ($TestDir) { $script:answers = @("$env:AETHER_UNINSTALL_ANSWERS" -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ }) }
+$script:owner = $null
+function Box([string]$m, [string]$buttons = 'OK', [string]$icon = 'Information', [string]$default = 'Button1') {
+    Log "box [$buttons]: $($m -replace "`r?`n", ' / ')"
+    if ($TestDir) {
+        $a = 'OK'
+        if ($buttons -ne 'OK') { $a = 'No'; if ($script:answers.Count) { $a = $script:answers[0]; $script:answers = @($script:answers | Select-Object -Skip 1) } }
+        try { Add-Content -LiteralPath (Join-Path $TestDir 'boxes.txt') -Value "[$buttons -> $a]`r`n$m`r`n" -Encoding UTF8 } catch { }
+        return $a
+    }
+    if (-not $script:owner) { $script:owner = New-Object System.Windows.Forms.Form -Property @{ TopMost = $true; ShowInTaskbar = $false } }   # (in front of Settings)
+    return [string][System.Windows.Forms.MessageBox]::Show($script:owner, $m, $title, $buttons, $icon, $default)
+}
+
+try {
+# ---- 1. run from the temp folder: nothing of this process stays open in the folder it deletes
+if (-not $FromTemp) {
+    $Root = Split-Path -Parent $PSScriptRoot
+    $copy = Join-Path $tmpDir ('AETHER-AR-uninstall-{0}.ps1' -f [guid]::NewGuid().ToString('N').Substring(0, 8))
+    Copy-Item -LiteralPath $PSCommandPath -Destination $copy -Force
+    $a = "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$copy`" -FromTemp -Root `"$Root`""
+    if ($TestDir) { $a += " -TestDir `"$TestDir`" -RegName `"$RegName`""; if ($TestAdbName) { $a += " -TestAdbName `"$TestAdbName`"" } }
+    # (minimized outside, hidden inside: Windows 11 then hands the console to no Windows Terminal window -- review 01.11.)
+    $p = Start-Process powershell.exe -WindowStyle Minimized -WorkingDirectory $tmpDir -ArgumentList $a -PassThru
+    if ($TestDir) { $p.WaitForExit() }
+    exit 0
+}
+Set-Location -LiteralPath $tmpDir; [Environment]::CurrentDirectory = $tmpDir
+Log "---- uninstall $Root (test: $([bool]$TestDir), entry: $RegName)"
+
+# ---- the folder: only one that is plainly an AETHER AR install (an rd /s /q on anything else would be a disaster)
+$bad = ''
+try { $Root = [IO.Path]::GetFullPath($Root).TrimEnd('\') } catch { $bad = 'not a folder path' }
+$ar = Join-Path $Root 'ar'
+if (-not $bad -and $Root -notmatch '^[A-Za-z]:\\[^\\]+') { $bad = 'not a folder on a drive' }
+if (-not $bad -and -not ((Test-Path -LiteralPath (Join-Path $ar 'VERSION')) -and (Test-Path -LiteralPath (Join-Path $ar 'AetherAR.ps1')))) { $bad = 'no ar\VERSION / ar\AetherAR.ps1 in it' }
+foreach ($sys in $env:SystemRoot, $env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:USERPROFILE, [Environment]::GetFolderPath('MyDocuments'), [Environment]::GetFolderPath('Desktop')) {
+    if (-not $bad -and (Same-Path $Root $sys)) { $bad = 'a system or user folder' }
+}
+if (-not $bad -and $TestDir -and -not (Under $Root $TestDir)) { $bad = 'a test run outside its test folder' }
+if ($bad) { Log "refused: $bad"; [void](Box "This is not an AETHER AR folder ($bad):`n$Root`n`nNothing was removed." 'OK' 'Error'); exit 1 }
+
+$version = ''; try { $version = (Get-Content -LiteralPath (Join-Path $ar 'VERSION') -TotalCount 1).Trim() } catch { }
+$iso = ''; try { $iso = [string](Get-Content -LiteralPath (Join-Path $ar 'config.json') -Raw | ConvertFrom-Json).iso } catch { }
+# (the shell's count is quick; with a path over 260 characters inside it is empty, not an error: then file by file)
+$n = $null; try { $n = (New-Object -ComObject Scripting.FileSystemObject).GetFolder($Root).Size } catch { }
+$bytes = $(if ($null -ne $n -and "$n" -ne '') { [double]$n } else { [double](Get-ChildItem -LiteralPath $Root -Recurse -Force -File -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum })
+$size = $(if ($bytes -ge 1GB) { '{0:N1} GB' -f ($bytes / 1GB) } else { '{0:N0} MB' -f [Math]::Max(1, $bytes / 1MB) })
+$icon = $null; try { $icon = New-Object System.Drawing.Icon((Join-Path $ar 'aether-ar.ico')) } catch { }   # (read into memory now: the file goes)
+function Mutex-Open([string]$n) { $m = $null; if ([System.Threading.Mutex]::TryOpenExisting($n, [ref]$m)) { $m.Dispose(); return $true }; return $false }
+
+# an install or update running right now (Setup or the window's Install): not under its feet
+if (Mutex-Open 'Local\AetherAR-install') {
+    [void](Box 'An AETHER AR install or update is running right now. Let it finish (or press Cancel in the Setup window), then remove AETHER AR.' 'OK' 'Warning'); exit 1
+}
+
+# ---- 2. ask
+$q = "Remove AETHER AR $version from this PC?`n`nThis deletes the folder $Root ($size): the game built from your disc, its tools and its settings.`n`nYour disc image is not touched$(if ($iso) { ":`n$iso" } else { '.' })"
+if ((Box $q 'YesNo' 'Question' 'Button2') -ne 'Yes') { Log 'not removed (No)'; exit 0 }
+$saves = Join-Path $Root 'games\bt3\savedata'
+$hasSaves = (Test-Path -LiteralPath $saves -PathType Container) -and [bool](Get-ChildItem -LiteralPath $saves -Recurse -Force -File -ErrorAction SilentlyContinue | Select-Object -First 1)
+$docs = $(if ($TestDir) { Join-Path $TestDir 'Documents' } else { [Environment]::GetFolderPath('MyDocuments') })
+$dest = Join-Path $docs ('AETHER AR saves\' + (Get-Date -Format 'yyyy-MM-dd'))
+if (Test-Path -LiteralPath $dest) { $dest += (Get-Date -Format '-HHmmss') }
+$keep = $false
+if ($hasSaves) {
+    $a = Box "Keep your memory card (your saves)?`n`nYes: a copy goes to`n$dest`n`nNo: it is deleted with the folder.`nCancel: remove nothing." 'YesNoCancel' 'Question' 'Button1'
+    if ($a -ne 'Yes' -and $a -ne 'No') { Log 'not removed (Cancel)'; exit 0 }
+    $keep = $a -eq 'Yes'
+}
+
+# a small window while it works (deleting ~55,000 files takes a minute)
+$pf = New-Object System.Windows.Forms.Form
+$pf.Text = 'AETHER AR'; $pf.ClientSize = New-Object System.Drawing.Size(440, 90); $pf.FormBorderStyle = 'FixedDialog'; $pf.ControlBox = $false
+$pf.StartPosition = 'CenterScreen'; $pf.TopMost = $true; $pf.BackColor = [System.Drawing.Color]::FromArgb(24, 26, 32); $pf.ForeColor = [System.Drawing.Color]::White
+if ($icon) { $pf.Icon = $icon }
+$pl = New-Object System.Windows.Forms.Label; $pl.Location = New-Object System.Drawing.Point(20, 20); $pl.Size = New-Object System.Drawing.Size(400, 50)
+$pl.Font = New-Object System.Drawing.Font('Segoe UI', 11); $pf.Controls.Add($pl)
+if ($TestDir) {   # (test windows on the second screen when there is one)
+    $scr2 = [System.Windows.Forms.Screen]::AllScreens | Where-Object { -not $_.Primary } | Select-Object -First 1
+    if ($scr2) { $pf.StartPosition = 'Manual'; $pf.Location = $scr2.WorkingArea.Location }
+}
+$pf.Show(); $script:owner = $pf
+function Status([string]$m) { Log $m; $pl.Text = $m; $pf.Refresh(); [System.Windows.Forms.Application]::DoEvents() }
+
+# ---- 3. stop what runs from this folder
+Status 'Closing AETHER AR ...'
+$arQ = $ar.Replace("'", "''")   # (the shortcut's -Command names the path in single quotes)
+function Runs-Script($p, [string]$name) {
+    $cl = "$($p.CommandLine)"; if (-not $cl -or $p.ProcessId -eq $PID -or $p.Name -notmatch '^(powershell|pwsh)\.exe$') { return $false }
+    foreach ($s in "$ar\$name", "$arQ\$name") { if ($cl.IndexOf($s, [StringComparison]::OrdinalIgnoreCase) -ge 0) { return $true } }
+    return $false
+}
+$all = @(Get-CimInstance Win32_Process -ErrorAction SilentlyContinue)
+$stopped = 0
+# the window first (its status tick would start adb again), then the start script that waits for the headset
+foreach ($name in 'AetherAR.ps1', 'start-ar.ps1') {
+    foreach ($p in @($all | Where-Object { Runs-Script $_ $name })) { Log "stopping $name (pid $($p.ProcessId))"; try { Stop-Process -Id $p.ProcessId -Force } catch { }; $stopped++ }
+}
+# the game: asked to close (it writes its save), then ended
+$game = @(Get-Process ps2EntryRunner -ErrorAction SilentlyContinue | Where-Object { Under $_.Path $Root })
+foreach ($p in $game) { Log "closing the game (pid $($p.Id))"; try { [void]$p.CloseMainWindow() } catch { } }
+for ($i = 0; $i -lt 8 -and @($game | Where-Object { Get-Process -Id $_.Id -ErrorAction SilentlyContinue }).Count; $i++) { Start-Sleep -Milliseconds 500 }
+foreach ($p in $game) { try { Stop-Process -Id $p.Id -Force -ErrorAction Stop } catch { } }
+$stopped += $game.Count
+# anything else running from the folder (a build's tools), except adb (below)
+foreach ($p in @($all | Where-Object { $_.ProcessId -ne $PID -and $_.Name -ne "$adbName.exe" -and (Under "$($_.ExecutablePath)" $Root) -and $_.Name -ne 'ps2EntryRunner.exe' })) {
+    Log "stopping $($p.Name) (pid $($p.ProcessId))"; try { Stop-Process -Id $p.ProcessId -Force } catch { }
+}
+# the Quest boundary back on, as the window's Stop does (the start script stopped above never runs its own reset): with
+# the adb that already runs, whichever it is -- a client of the same version never restarts it
+if ($stopped -and -not $TestDir) {
+    $srv = Get-Process adb -ErrorAction SilentlyContinue | Where-Object { $_.Path } | Select-Object -First 1
+    if ($srv) {
+        $eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+        try {
+            $devs = @((& $srv.Path devices 2>$null) | Where-Object { $_ -match "`tdevice$" } | ForEach-Object { ($_ -split "`t")[0] })
+            foreach ($s in $devs) { & $srv.Path -s $s shell setprop debug.oculus.guardian_pause 0 2>$null | Out-Null }
+            Log "boundary back on ($($devs.Count) headset(s))"
+        } catch { }
+        $ErrorActionPreference = $eap
+    }
+}
+# this folder's own adb (the window's status tick started it): its server ended, then the process if it is still there.
+# Only an adb.exe inside this folder -- any other one belongs to another program.
+foreach ($p in @(Get-Process $adbName -ErrorAction SilentlyContinue | Where-Object { Under $_.Path $Root })) {
+    Log "stopping this folder's adb ($($p.Path))"
+    if (-not $TestDir) {   # (a test never runs adb: its "adb" is a stand-in, only stopped)
+        $eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+        try { & $p.Path kill-server 2>$null | Out-Null } catch { }
+        $ErrorActionPreference = $eap
+    }
+    for ($i = 0; $i -lt 6 -and (Get-Process -Id $p.Id -ErrorAction SilentlyContinue); $i++) { Start-Sleep -Milliseconds 500 }
+    try { Stop-Process -Id $p.Id -Force -ErrorAction Stop } catch { }
+}
+
+# ---- the memory card, before anything is deleted (if it cannot be copied, nothing is removed)
+if ($keep) {
+    Status 'Copying your memory card ...'
+    try {
+        New-Item -ItemType Directory -Force -Path $dest | Out-Null
+        Get-ChildItem -LiteralPath $saves -Force | Copy-Item -Destination $dest -Recurse -Force
+        $n1 = @(Get-ChildItem -LiteralPath $saves -Recurse -Force -File).Count; $n2 = @(Get-ChildItem -LiteralPath $dest -Recurse -Force -File).Count
+        if ($n2 -lt $n1) { throw "only $n2 of $n1 files arrived" }
+        Log "memory card: $n1 file(s) -> $dest"
+    } catch {
+        $pf.Close()
+        [void](Box "Your memory card could not be copied to`n$dest`n($($_.Exception.Message)).`n`nNothing was removed. Copy the folder games\bt3\savedata in $Root yourself, then remove AETHER AR again." 'OK' 'Error')
+        exit 1
+    }
+}
+
+# ---- 4. shortcuts, entry, Setup's work folder, the folder
+Status 'Removing AETHER AR ...'
+$deskDir = $(if ($TestDir) { Join-Path $TestDir 'Desktop' } else { [Environment]::GetFolderPath('Desktop') })
+$progDir = $(if ($TestDir) { Join-Path $TestDir 'Programs' } else { [Environment]::GetFolderPath('Programs') })
+$sh = New-Object -ComObject WScript.Shell
+foreach ($lnk in (Join-Path $deskDir 'AETHER AR.lnk'), (Join-Path $progDir 'AETHER AR.lnk')) {
+    if (-not (Test-Path -LiteralPath $lnk -PathType Leaf)) { continue }
+    $args0 = ''; try { $args0 = "$($sh.CreateShortcut($lnk).Arguments)" } catch { }
+    $m = [regex]::Match($args0, "(?i)[A-Za-z]:\\.*?\\AetherAR\.ps1")
+    # (only one that starts THIS folder's window: another install's shortcut stays)
+    if ($m.Success -and (Same-Path (Split-Path -Parent $m.Value.Replace("''", "'")) $ar)) { Log "removing $lnk"; Remove-Item -LiteralPath $lnk -Force -ErrorAction SilentlyContinue }
+    else { Log "kept $lnk (points elsewhere)" }
+}
+$uk = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\$RegName"
+if (Test-Path -LiteralPath $uk) {
+    $loc = ''; try { $loc = [string](Get-ItemProperty -LiteralPath $uk -ErrorAction Stop).InstallLocation } catch { }
+    if (-not $loc -or (Same-Path $loc $Root)) { Log "removing $uk"; Remove-Item -LiteralPath $uk -Recurse -Force -ErrorAction SilentlyContinue }
+}
+$tools = @()
+# The Link passthrough edge fix (ar\shortcuts.ps1 Enable-AetherLinkEdgeFix): the user setting
+# REMOTEHEADSET_ALPHAPREPROCCESINGSCHEME back to what was there before AETHER AR set it, as noted in this key -- removed
+# when there was none, the old value when there was one. Only while it still holds AETHER AR's '0': a '0' of the
+# player's own from before stays for good, and so does a value they set since. Written out here like
+# Disable-AetherLinkEdgeFix (the uninstaller needs nothing from the folder it deletes). A test (-TestDir) uses the
+# stand-in key HKCU:\Software\<RegName>-Environment, never the real environment. Returns 'removed', 'restored' or ''.
+function Undo-LinkEdgeFix($sp) {
+    if (-not $sp -or "$($sp.LinkAlphaNoted)" -ne '1') { return '' }
+    $name = 'REMOTEHEADSET_ALPHAPREPROCCESINGSCHEME'
+    $ek = $(if ($RegName -ne 'AETHER-AR') { "HKCU:\Software\$RegName-Environment" } else { '' })
+    $cur = $(if ($ek) { try { [string](Get-ItemProperty -LiteralPath $ek -Name $name -ErrorAction Stop).$name } catch { $null } } else { [Environment]::GetEnvironmentVariable($name, 'User') })
+    if ("$cur" -ne '0') { Log "Link edge setting: '$cur' is not AETHER AR's -- left as it is"; return '' }
+    $old = $(if ("$($sp.LinkAlphaHad)" -eq '1') { "$($sp.LinkAlphaPrev)" } else { '' })
+    if ($old -eq '0') { Log "Link edge setting: the player's own '0' from before -- left as it is"; return '' }
+    if ($ek) {
+        if ($old) { New-ItemProperty -LiteralPath $ek -Name $name -PropertyType String -Value $old -Force | Out-Null } else { Remove-ItemProperty -LiteralPath $ek -Name $name -ErrorAction SilentlyContinue }
+    } else { [Environment]::SetEnvironmentVariable($name, $(if ($old) { $old } else { $null }), 'User') }
+    Log $(if ($old) { "Link edge setting: back to '$old'" } else { 'Link edge setting: removed (AETHER AR had added it)' })
+    return $(if ($old) { 'restored' } else { 'removed' })
+}
+$edgeUndone = ''
+$sk = "HKCU:\Software\$RegName"
+if (Test-Path -LiteralPath $sk) {
+    $sp = $null; try { $sp = Get-ItemProperty -LiteralPath $sk -ErrorAction Stop } catch { }
+    # (another install registered since: its key, the tools it needs and the Link edge fix it uses stay)
+    if (-not $sp -or -not $sp.InstallDir -or (Same-Path ([string]$sp.InstallDir) $Root)) {
+        if ($sp) { $tools = @($sp.InstalledTools | Where-Object { $_ }) }
+        # (before the key goes: the note is in it; a failure here is said at the end, the rest goes on)
+        try { $edgeUndone = Undo-LinkEdgeFix $sp } catch { $edgeUndone = "failed: $($_.Exception.Message)"; Log "Link edge setting: $edgeUndone" }
+        Log "removing $sk"; Remove-Item -LiteralPath $sk -Recurse -Force -ErrorAction SilentlyContinue
+    }
+}
+$work = $(if ($TestDir) { Join-Path $TestDir 'AETHER-AR-setup' } else { Join-Path $env:LOCALAPPDATA 'AETHER-AR-setup' })
+if ((Test-Path -LiteralPath $work) -and -not (Mutex-Open 'Local\AetherAR-setup-window')) { Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue }
+# the folder: rd on the \\?\ path (Remove-Item fails on git's read-only packs and on paths over 260 characters);
+# tried three times -- a process that was just stopped can hold a file for a moment
+for ($i = 0; $i -lt 3 -and (Test-Path -LiteralPath $Root); $i++) {
+    if ($i) { Start-Sleep -Seconds 2 }
+    $rd = Start-Process cmd.exe -ArgumentList "/d /c rd /s /q `"\\?\$Root`"" -WorkingDirectory $tmpDir -NoNewWindow -Wait -PassThru
+    Log "rd /s /q: exit $($rd.ExitCode)"
+}
+$left = Test-Path -LiteralPath $Root
+Log $(if ($left) { "NOT all removed: $Root" } else { "removed: $Root" })
+$pf.Close(); $script:owner = $null
+
+# ---- 5. what is left, said once
+$names = @{ 'Git.Git' = 'Git'; 'Python.Python.3.12' = 'Python 3.12'; 'Kitware.CMake' = 'CMake'; 'Ninja-build.Ninja' = 'Ninja'
+            'Microsoft.VisualStudio.2022.BuildTools' = 'Visual Studio Build Tools 2022 (about 8 GB)'
+            'Microsoft.VisualStudio.Component.VC.Llvm.Clang' = 'the C++ / Clang parts added to your Visual Studio (Visual Studio Installer > Modify)' }
+$out = @()
+if ($left) { $out += "AETHER AR is removed, but some files in $Root could not be deleted (still in use). Restart the PC, then delete that folder." }
+else { $out += 'AETHER AR is removed from this PC.' }
+if ($keep) { $out += "Your memory card is in:`n$dest`nTo use it again, copy what is in it into games\bt3\savedata of a new install." }
+if ($iso -and (Test-Path -LiteralPath $iso)) { $out += "Your disc image is still at:`n$iso" }
+if ($edgeUndone -eq 'removed') { $out += 'The Meta Horizon Link setting AETHER AR had added (the passthrough edge fix) is removed again. Link drops it the next time it starts.' }
+elseif ($edgeUndone -eq 'restored') { $out += 'The Meta Horizon Link setting AETHER AR had changed (the passthrough edge fix) is back to what it was before. Link uses it the next time it starts.' }
+elseif ($edgeUndone) { $out += "AETHER AR could not undo its Meta Horizon Link setting (the passthrough edge fix): $($edgeUndone -replace '^failed: ', ''). It does no harm to other programs." }
+if ($tools.Count) {
+    $out += "When it was installed, AETHER AR also put these tools on this PC:`n" + (($tools | ForEach-Object { '  - ' + $(if ($names[$_]) { $names[$_] } else { $_ }) }) -join "`n") +
+            "`nThey stay, because other programs may use them. If you do not need them, remove them in Settings > Apps."
+}
+[void](Box ($out -join "`n`n") 'OK' $(if ($left) { 'Warning' } else { 'Information' }))
+Log 'END'
+} catch {
+    Log "ERROR: $($_.Exception.Message) $($_.ScriptStackTrace)"
+    try { if ($pf) { $pf.Close() } } catch { }
+    $script:owner = $null
+    [void](Box "Removing AETHER AR stopped:`n`n$($_.Exception.Message)`n`n(Details: $ulog)" 'OK' 'Error')
+    Log 'END (error)'
+} finally {
+    if ($FromTemp) { Remove-Item -LiteralPath $PSCommandPath -Force -ErrorAction SilentlyContinue }   # (this temp copy)
+}
