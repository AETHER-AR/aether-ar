diff --git a/ps2xRuntime/tools/shaders_win.py b/ps2xRuntime/tools/shaders_win.py
new file mode 100644
index 0000000000000000000000000000000000000000..1caab55650fa7190e3c12b92ad0683cc028bf549
--- /dev/null
+++ b/ps2xRuntime/tools/shaders_win.py
@@ -0,0 +1,46 @@
+"""Compile one seamvk shader to its SPIR-V word array (.inc) on Windows, without glslc.
+
+Uses the glslangValidator shipped in Granite's fsr2 tools; that build has no GL_GOOGLE_include_directive, so the
+#include lines are inlined here first. tools/shaders.sh (glslc -O) stays the reference for every other shader.
+
+    python tools/shaders_win.py seam.vert vert seam.vert.inc
+"""
+import pathlib
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+SRC = ROOT / "src" / "lib" / "seamvk"
+GLSLANG = ROOT / "third_party" / "parallel-gs" / "Granite" / "third_party" / "fsr2" / "tools" / "sc" / "glslangValidator.exe"
+
+
+def inline(path: pathlib.Path) -> str:
+    out = []
+    for line in path.read_text().splitlines():
+        m = re.match(r'\s*#include\s+"([^"]+)"', line)
+        out.append(inline(path.parent / m.group(1)) if m else line)
+    return "\n".join(out)
+
+
+def main() -> int:
+    src, stage, dst = sys.argv[1], sys.argv[2], sys.argv[3]
+    defines = [a for a in sys.argv[4:] if a.startswith("-D")]   # variants: -DNOPERSP -DSTENCIL_EXPORT ...
+    with tempfile.TemporaryDirectory() as tmp:
+        flat = pathlib.Path(tmp) / f"shader.{stage}"
+        flat.write_text(inline(SRC / src) + "\n")
+        out = pathlib.Path(tmp) / "out.inc"
+        r = subprocess.run([str(GLSLANG), "-V", "-x", "-S", stage, *defines, str(flat), "-o", str(out)], capture_output=True, text=True)
+        if r.returncode != 0:
+            sys.stdout.write(r.stdout + r.stderr)
+            return r.returncode
+        words = re.findall(r"0x[0-9a-fA-F]{8}", out.read_text())
+    lines = [",".join(words[i:i + 4]) + "," for i in range(0, len(words), 4)]
+    (SRC / dst).write_text("\n".join(lines) + "\n")
+    print(f"{dst}: {len(words)} words")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
