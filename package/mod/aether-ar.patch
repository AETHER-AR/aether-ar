+            V3 gt = sub(gt0, gp); { const float l = std::sqrt(dot(gt, gt)); gt = { gt.x / l, gt.y / l, gt.z / l }; }
+            std::lock_guard<std::mutex> l(g_portalMx);
+            const float o[13] = { gp.x, gp.y, gp.z, g_portal.gn.x, g_portal.gn.y, g_portal.gn.z, gt.x, gt.y, gt.z, g_portal.u0 * sc, g_portal.u1 * sc, g_portal.h * sc, float(g_portal.gen) };
+            std::memcpy(g_portalOut, o, sizeof(o));
+        }
+        g_portalValid.store(v);
+    }
+    for (uint32_t i = 0; i < n; ++i)
+    {
+        const uint32_t c = cells + i * 64u;
+        wr32(rdram, c + 0x04u, g_room.cellMesh[i]);   // ground: the room's floors in this cell
+        const uint32_t obj = g_room.cellObjects[i];   // objects: only the room's walls (no arena rocks, buildings)
+        wr32(rdram, c + 0x14u, obj ? g_room.cellObjCount[i] : 0u);
+        if (obj) wr32(rdram, c + 0x18u, obj);
+    }
+    {   // the room object never stays destroyed: a crash may set its bit, the next frame clears it (and anything else
+        // the game wrote into the record)
+        uint32_t cur; std::memcpy(&cur, rdram + g_room.stateAddr, 4);
+        if (cur != g_room.stateRec[0])
+        {
+            static int s_n = 0;
+            if (s_n++ < 20) std::fprintf(stderr, "[arroom] room object state was 0x%x (a crash?) -> restored\n", cur);
+        }
+        std::memcpy(rdram + g_room.stateAddr, g_room.stateRec, sizeof(g_room.stateRec));
+    }
+    measureDrawn(rdram);        // [argap] where this frame drew them
+    constrainFighters(rdram);   // walls, monitor, PC: the room blocks like Mario's (the fighters not held at their sync)
+    g_roomActive = true; ++g_syncFrame;   // [arsync] next frame each fighter is held before its draw
+    g_arRoomCells.store(n, std::memory_order_relaxed);
+    {   // PS2X_AR_WATCHPOS=<hex>,<hex>..: log those xyz triples (fighter positions) every 15 frames
+        static std::vector<uint32_t> s_w = [](){ std::vector<uint32_t> v; if (const char *e = std::getenv("PS2X_AR_WATCHPOS")) for (const char *c = e; *c; ) { char *end; v.push_back(uint32_t(std::strtoul(c, &end, 16))); c = end; while (*c == ',') ++c; if (end == c && !*c) break; } return v; }();
+        static uint32_t s_n = 0;
+        static const uint32_t s_every = [](){ const char *v = std::getenv("PS2X_AR_WATCHEVERY"); return v && v[0] ? std::max(1u, (uint32_t)std::atoi(v)) : 15u; }();
+        if (!s_w.empty() && (s_n++ % s_every) == 0u)
+        {
+            std::fprintf(stderr, "[arroom] pos");
+            for (uint32_t a : s_w) { float f[3]; std::memcpy(f, rdram + (a & PS2_RAM_MASK), 12); std::fprintf(stderr, "  0x%x (%.2f %.2f %.2f)", a, f[0], f[1], f[2]); }
+            std::fprintf(stderr, "\n");
+        }
+    }
+}
