+    bool beginFrame()
+    {
+        if (!g.ok) return false;
+        pollEvents();
+            {   // A lost session is replaced after 2 s. A single idle (headset asleep / taken off) gets 30 s to resume.
+                // PS2X_AR_RECREATE=0 leaves everything to the runtime.
+            static auto s_idleSince = std::chrono::steady_clock::time_point{}, s_lastNew = std::chrono::steady_clock::time_point{};
+            static bool s_wasRunning = false;
+            static const bool s_off = [](){ const char *v = std::getenv("PS2X_AR_RECREATE"); return v && v[0] == '0'; }();
+            if (s_off) s_wasRunning = false;
+            const auto now = std::chrono::steady_clock::now();
+            const bool lost = g.sstate == XR_SESSION_STATE_LOSS_PENDING || g.sstate == XR_SESSION_STATE_EXITING;
+            if (g.running && !lost) { s_wasRunning = true; s_idleSince = {}; }
+            else if (!s_off && (s_wasRunning || lost))
+            {
+                if (s_idleSince == std::chrono::steady_clock::time_point{})
+                {
+                    s_idleSince = now;
+                }
+                const auto wait = lost ? std::chrono::seconds(2) : std::chrono::seconds(30);
+                const auto cooldown = std::chrono::seconds(12);
+                if (now - s_idleSince > wait && now - s_lastNew > cooldown)
+                { s_lastNew = now; s_idleSince = {}; s_wasRunning = false; recreateSession(); }
+            }
+            // a first session that never starts (review 31.10.: Link did not hand it over, the headset stayed black and
+            // nothing was ever retried): one new session after 90 s
+            static const auto s_first = now; static bool s_everRan = false, s_freshTried = false;
+            if (g.running) s_everRan = true;
+            else if (!s_off && !s_everRan && !s_freshTried && now - s_first > std::chrono::seconds(90))
+            { s_freshTried = true; s_lastNew = now; std::fprintf(stderr, "[arxr] the first session never started -- a new one\n"); recreateSession(); }
+            // [arfail] while there is no running session the window says so (start-ar.ps1 relays it, and holds back
+            // 'Playing'); back again: said too
+            static auto s_downSince = std::chrono::steady_clock::time_point{}; static bool s_saidDown = false;
+            if (g.running) { s_downSince = {}; if (s_saidDown) { s_saidDown = false; status("The headset is there -- starting."); } }
+            else
+            {
+                if (s_downSince == std::chrono::steady_clock::time_point{}) s_downSince = now;
+                if (!s_saidDown && now - s_downSince > std::chrono::seconds(3))
+                { s_saidDown = true; status("Waiting for the headset: put it on and start Link in it (Quick Settings > Link, or Air Link). Still waiting with the headset on? Turn on the light -- the headset cannot track in the dark."); }
+            }
+        }
+        if (!g.running) return false;
+        {   // [arfail] room mode needs the room. The read asks again by itself (an empty answer after 3 s, the room 4 times,
+            // the planes up to 8 times with ~10 s of locating each); when it is over with no room (no Space Setup, or Link
+            // does not pass it), or has run 3 minutes, the game says so and stops -- it went on quietly on the floating
+            // screen before (release audit 31.10.). The 3 minutes count only while the headset is worn and tracked, and
+            // start over with a new session (release review 31.10.: a headset taken off during the read, put back on
+            // later, ended the game at once).
+            static auto s_last = std::chrono::steady_clock::now();
