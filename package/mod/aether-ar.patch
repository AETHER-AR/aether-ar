+void arRoomRequestCentre(const float gameHit[3])
+{
+    std::lock_guard<std::mutex> l(g_placeMx);
+    g_placeAt = { gameHit[0], gameHit[1], gameHit[2] }; g_placePending = true;
+}
+
+// Nearest room triangle along a game-space ray (either side). *floor = 1 when it is a standable, upward surface.
+bool arRoomRaycast(const float o[3], const float d[3], float maxT, float hit[3], int *floor)
+{
+    std::lock_guard<std::mutex> l(g_placeMx);
+    if (!g_room.ready) return false;
+    const V3 O{ o[0], o[1], o[2] }, D{ d[0], d[1], d[2] };
+    float best = maxT; int bestTri = -1;
+    for (size_t t = 0; t < g_room.tris.size(); ++t)
+    {
+        const Tri &tr = g_room.tris[t];
+        if (tr.stage) continue;   // [arportal] the cut is picked on the room, not on the arena behind it
+        const V3 &a = g_room.verts[tr.i[0]], &b = g_room.verts[tr.i[1]], &c = g_room.verts[tr.i[2]];
+        const V3 e1 = sub(b, a), e2 = sub(c, a), pv = cross(D, e2);
+        const float det = dot(e1, pv);
+        if (std::fabs(det) < 1e-9f) continue;
+        const float inv = 1.0f / det; const V3 tv = sub(O, a);
+        const float u = dot(tv, pv) * inv; if (u < 0.0f || u > 1.0f) continue;
+        const V3 qv = cross(tv, e1);
+        const float v = dot(D, qv) * inv; if (v < 0.0f || u + v > 1.0f) continue;
+        const float tt = dot(e2, qv) * inv;
+        if (tt > 0.0f && tt < best) { best = tt; bestTri = int(t); }
+    }
+    if (bestTri < 0) return false;
+    for (int k = 0; k < 3; ++k) hit[k] = o[k] + d[k] * best;
+    if (floor) *floor = isFloor(g_room.tris[bestTri]) ? 1 : 0;
+    return true;
+}
+uint32_t arRoomGeneration() { return g_roomGen.load(); }
