+        Say-Box "The Meta Horizon Link app on this PC could not be restarted ($($r.Why)).`n`nThe game starts now. The black shadow behind the fighters goes away after the next restart of this PC." | Out-Null
+        return $true
+    }
+    Say-Box "The Meta Horizon Link app on this PC has not started again yet ($($r.Why)).`n`nOpen it (Start menu: Meta Horizon Link), wait until it shows your headset, then press Start again." | Out-Null
+    return $false
+}
