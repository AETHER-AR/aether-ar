+// [arxr] The AR headset output: OpenXR over Meta Quest Link, Vulkan through Granite, passthrough behind the fighters.
+//
+// Off unless PS2X_AR_XR=1. Then the native renderer's Vulkan instance and device are created by the OpenXR runtime
+// (XR_KHR_vulkan_enable2), the session runs on the renderer thread, and every game frame is drawn once per eye through
+// that eye's camera into the eye's swapchain image, with Quest passthrough composited behind it (XR_FB_passthrough).
+// Game space is tied to the room by the same mapping the room collision uses (ar_room_collision.cpp): game -> room
+// (the Mario scan's anchor-local frame) -> stage (the anchor located over Link by its UUID) -> eye.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+#if defined(PS2X_HAVE_ARXR)
+#include "context.hpp"
+#include "device.hpp"
+#include "image.hpp"
+
+namespace arxr
+{
+    bool wanted();                                   // PS2X_AR_XR=1
+    // before the Vulkan context: the XR instance and system; false = run without the headset
+    bool preVulkan();
+    Vulkan::InstanceFactory *instanceFactory();      // the Vulkan instance through xrCreateVulkanInstanceKHR
+    VkPhysicalDevice physicalDevice(VkInstance inst); // the GPU the runtime renders with
+    VkDevice createDevice(VkPhysicalDevice gpu, const VkDeviceCreateInfo *ci);   // through xrCreateVulkanDeviceKHR
+    // after the device: session, spaces, passthrough, swapchains (wrapped as Granite images)
+    bool postDevice(Vulkan::Device &dev);
+    // [arfail] the native renderer could not start on the runtime's GPU: the reason to the launcher, exit code 44
+    [[noreturn]] void failRenderer(const char *why);
+
+    // Per renderer frame. beginFrame waits for the runtime's frame slot and locates the eyes; it returns false when the
+    // session is not presenting (the desktop window keeps working). eyeVP: game space -> clip (x right, y DOWN, reverse-Z:
+    // z = near, w = distance), the AR camera's convention.
+    bool beginFrame();
+    bool eyeVP(int eye, float vp[4][4]);
+    Vulkan::ImageView *acquireEye(int eye, uint32_t &w, uint32_t &h);   // the eye's swapchain image (UNORM view), colour attachment
+    void releaseEye(int eye);
+    void endFrame();                                 // passthrough + the projection layer (source alpha)
+    // [armenu] the game's own screen as a floating quad (menus, character select) while no fight is in the room:
+    // render the composed frame into the returned view, submit, then releaseMenu() before endFrame
+    Vulkan::ImageView *acquireMenu(uint32_t w, uint32_t h, bool hud);   // hud: the fight's HUD panel (alpha-blended, higher, smaller)
+    void releaseMenu();
+    bool hudShownRecently();                         // [arhud] the fight's HUD panel was shown within the last 0.25 s
+    // [arplace] Choosing the spawn point: at start (and after a thumbstick click) a controller ray picks a spot on the
+    // scanned room; the trigger puts the arena centre there. placementGeometry fills a game-space triangle soup (ray +
+    // ring) and its premultiplied colour for this frame; 0 = nothing to draw (placement done).
+    size_t placementGeometry(float *xyz, size_t maxVerts, float rgba[4]);
+    // End the session and free the instance before the process goes: a process that exits with its XR swapchains alive
+    // hangs in the kernel (one thread left, unkillable). main.cpp ends with std::_Exit, so it calls this explicitly.
+    void shutdown();
+}
+#endif
+
+// From ar_room_collision.cpp: game space -> room space (metres, y up, the scan's anchor frame turned z-up -> y-up).
