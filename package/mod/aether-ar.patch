+    $q = { param($s) $s -replace "(['\u2018\u2019\u201A\u201B])", '$1$1' }   # (.NET regex escapes: this file stays ASCII)
+    $cmd = "& '$(& $q "$ar\install.ps1")' -Iso '$(& $q $iso.Text)' -Yes *> '$(& $q $installLog)'; exit `$LASTEXITCODE"
+    $script:installProc = Start-Process powershell -WindowStyle Hidden -PassThru -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', "`"$cmd`"")
+    $null = $script:installProc.Handle   # (kept now: else an install that ends before the next status tick has no exit code)
+    $script:installFailed = $false; $script:repairing = $repair; $log.Text = ''
