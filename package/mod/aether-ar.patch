+++ b/ar/release/Install AETHER AR.cmd	
@@ -0,0 +1,17 @@
+@echo off
+title AETHER AR - Setup
+rem AETHER AR -- double-click to install: opens the Setup window (the console closes at once). Needs your own
+rem Budokai Tenkaichi 3 (USA) ISO and an internet connection. (setup\install-aether-ar.ps1 is the same install without
+rem the window, for a terminal.)
+rem Started from inside the ZIP (Explorer copies only this file to a temp folder), the setup folder is not next to it.
+if not exist "%~dp0setup\setup-gui.ps1" (
+    echo.
+    echo   Please unpack the ZIP first: right-click AETHER-AR-*.zip ^> Extract All...
+    echo   Then double-click "Install AETHER AR.cmd" in the unpacked folder.
+    echo.
+    pause
+    exit /b 1
+)
+rem (/min: on Windows 11 a normal start hands the console to a Windows Terminal window that stays in the taskbar, and
+rem closing it closed Setup; minimized, powershell's own -WindowStyle Hidden then hides it for good)
+start "" /min powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%~dp0setup\setup-gui.ps1"
diff --git a/ar/release/READ ME FIRST.txt b/ar/release/READ ME FIRST.txt
new file mode 100644
index 0000000000000000000000000000000000000000..8e40ca2490b76791f7ddf62322af267e972e10b9
--- /dev/null
+++ b/ar/release/READ ME FIRST.txt	
@@ -0,0 +1,114 @@
+AETHER AR -- READ ME FIRST
+==========================
+
+Mixed reality for Dragon Ball Z: Budokai Tenkaichi 3 (PS2) on Meta Quest: the fighters fight in your real room,
+on your floor and your tables, and your walls and furniture block them.
+Unofficial fan mod. No game files are included: you need your own copy of the game as a disc image (ISO).
+
+
+WHAT YOU NEED
+-------------
+1. A Windows 10 or 11 PC with a gaming graphics card (NVIDIA / AMD, good enough for PC VR), an internet
+   connection, and about 20 GB free on C:.
+2. A Meta Quest 3 or 3S, with a Link cable (or Air Link over Wi-Fi).
+3. Your own Dragon Ball Z: Budokai Tenkaichi 3 disc image, USA version (SLUS-21678), as a plain .iso file.
+
+
+ONE-TIME SETUP (before you install)
+-----------------------------------
+A. On the PC: install the Meta Horizon Link app (formerly Meta Quest Link; meta.com/quest/setup) and
+   connect the headset once. Then, in the Link app:
+   - Settings > General > OpenXR Runtime: press "Set Meta Horizon Link as active".
+   - Settings > General > "Unknown sources": on (needed for apps not from the Meta store; harmless otherwise).
+   - Settings > Beta: turn ON "Developer runtime features", "Passthrough over Meta Horizon Link"
+     and "Spatial data over Meta Horizon Link".
+     Developer runtime features = enables Meta's PC mixed-reality features.
+     Passthrough = lets you see your real surroundings in the headset.
+     Spatial data = lets the mod read YOUR Quest's walls, floor and furniture.
+     No room file needs to be copied. Your room scan is not made public.
+B. In the headset: Settings > Physical space > Space setup. Set up the room you will play in:
+   the walls, and your desk / table and other furniture.
+
+
+INSTALL
+-------
+1. Right-click the ZIP > "Extract All...". (Do not start anything from inside the ZIP.)
+   Put your .iso in a folder you keep (e.g. Documents\BT3): AETHER AR reads it every time you play.
+2. In the extracted folder, double-click "Install AETHER AR.cmd". The AETHER AR Setup window opens.
+   If Windows warns you first, choose "Run" (or "More info" > "Run anyway").
+3. In the Setup window:
+   - drag your .iso file onto the window (or press "Choose the ISO..."): it is checked at once,
+   - leave the install folder as it is (C:\AETHER-AR),
+   - press Install. Windows will ask for permission a few times: click Yes.
+   You do not need to install the build tools yourself. Setup checks and installs missing Git, Python 3.10 or newer,
+   CMake, Ninja and the Visual Studio 2022 C++ / Clang tools, then builds the game from your disc. If Windows App
+   Installer (winget) is missing, Setup explains how to add it before you try again. Android platform-tools are
+   optional; without them, the game still runs, but headset status and automatic boundary control are unavailable.
+   The first install takes 30-60 minutes; the window shows each step. Keep it open until it says
+   "AETHER AR is installed".
+4. Press "Start AETHER AR".
+   In the AETHER AR desktop window, press Help: the first tab, "Quest setup - Start here",
+   repeats every headset and PC setting with a short explanation. Controls are in the second tab.
+   Keep your disc image where it is: AETHER AR reads it every time you play.
+   You can delete the ZIP and this Setup folder.
+
+
+START
+-----
+The desktop shortcut "AETHER AR", or type AETHER in the Start menu.
+To keep it in the taskbar: right-click it in Start > Pin to taskbar.
+No shortcut? Double-click "AETHER AR.cmd" in the install folder (C:\AETHER-AR).
+
+
+PLAY
+----
+1. In the AETHER AR window, press Start. Then put the headset on and turn on Link
+   (Quick Settings > Link). The game appears in the headset by itself (it waits up to 5 minutes).
+   The line under the Start button always says what is happening; if something is missing,
+   a message tells you exactly what to change.
+2. After about 25 seconds of logos: menus = left stick + A. B = back. (The trigger does not select.)
+3. The fight starts on your desk or table by itself -- look around for it. To move it: point a
+   controller at another spot (cyan ring = OK, red = not here) and pull the trigger.
+4. Pause = Menu button. To end: take the headset off and press Stop in the AETHER AR window.
+
+The first Start after installing may restart the Meta Horizon Link app on the PC once (a message
+says so first). That turns on Link's own fix for a black shadow behind the fighters and the aiming
+ray (a Link setting for your Windows user; the window shows it as "Link passthrough edge fix").
+If Link was on in the headset, turn it on again there.
+
+
+RECORDING ON QUEST
+------------------
+For the Quest's built-in camera recording, use Air Link. Start recording in Quest Home,
+then connect through Air Link and start AETHER AR. This was confirmed working on the test
+Quest 3; performance depends on your PC and Wi-Fi.
+
+Known issue: Quest recording over USB Link can cause severe lag or freezing, including
+in the Link menu without the mod running. Dark trails behind fighters have also been
+reported. USB recording is not fixed or validated in this release.
+
+If the camera menu or recording shortcut is unavailable inside Link, leave Link and stop
+recording in Quest Home. More: Help > Quest setup, or Controller guide > Quest recordings,
+in the AETHER AR desktop window.
+
+
+UPDATE
+------
+A new version comes as a new ZIP from whoever gave you AETHER AR: unpack it and run its
+"Install AETHER AR.cmd" -- Setup finds your install, keeps your memory card and settings, and updates it.
+
+
+REMOVE
+------
+Windows Settings > Apps > Installed apps > AETHER AR > Uninstall.
+It asks first whether to keep your memory card (a copy goes to Documents\AETHER AR saves).
+It puts the Link setting of the edge fix back as it was. Your disc image is not touched.
+
+
+MORE
+----
+README.md (open it with Notepad) has the controls and what to do if something does not work.
+If the install stops, the Setup window says why; fix that and press Try again.
+If you need help, send these files:
+- install-log.txt (in this folder, next to "Install AETHER AR.cmd"; the Setup window's "Open the log" shows it)
+- build\setup.log and build\ps2xRuntime\logs\bt3.log (in the install folder, by default C:\AETHER-AR)
diff --git a/ar/release/install-aether-ar.ps1 b/ar/release/install-aether-ar.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..e3791be7a99b2d91aaf64c12bad954f8ba995a80
--- /dev/null
+++ b/ar/release/install-aether-ar.ps1
@@ -0,0 +1,189 @@
+# AETHER AR -- the release installer ("Install AETHER AR.cmd" runs it).
+#
+# The package holds only the mod: its changes to BT3-Recomp as one patch (mod\aether-ar.patch -- the mod's complete
+# source, GPL-3.0), the BT3-Recomp version it is made for (mod\BASE), and these scripts. Nothing of the game. This
+#   1. asks for your own Budokai Tenkaichi 3 (USA) ISO and an install folder (default C:\AETHER-AR),
+#   2. fetches BT3-Recomp from GitHub at exactly that version, without its history (git; installed with winget if it
+#      is missing),
+#   3. puts the mod's changes on it,
+#   4. builds the game from your ISO on this PC (ar\install.ps1: Python, compiler, recompilation; 30-60 min),
+#   5. puts "AETHER AR" on the desktop and in the Start menu, adds it to Settings > Apps (Uninstall) and opens the
+#      launcher window.
+# Run on the same folder again to update to a newer package: the memory card (games\bt3\savedata) and the settings
+# (ar\config.json) are not part of the project and stay.
+#
+#   install-aether-ar.ps1 [-Iso <iso>] [-Dir <folder>] [-Yes] [-NoShortcuts] [-NoLaunch] [-NoTranscript]
+# (setup-gui.ps1, the Setup window "Install AETHER AR.cmd" opens, runs this with -Iso -Dir -Yes -NoLaunch -NoTranscript
+# and reads its output: the "[step] <id>" lines move its progress list, a "FAILED:" line is shown as the reason)
+param([string]$Iso, [string]$Dir, [switch]$Yes, [switch]$NoShortcuts, [switch]$NoLaunch, [switch]$NoTranscript)
+$ErrorActionPreference = 'Stop'
+$pkg = Split-Path -Parent $PSScriptRoot
+function Say($m) { Write-Host "[AETHER AR] $m" -ForegroundColor Cyan }
+function Step($id) { if ($env:AETHER_SETUP_STEPS -eq '1') { Write-Host "[step] $id" } }   # (only for the Setup window: check, git, fetch, mod, tools -- then ar\install.ps1's)
+function Ask($q) { if ($Yes) { return $true }; return (Read-Host "$q [y/N]") -match '^(y|j)' }
+# a tool this installer put on the PC (Git): the uninstaller (ar\uninstall.ps1) names it at the end -- it stays, other
+# programs may use it. (ar\shortcuts.ps1 Add-AetherInstalledTool does the same for the build tools; this runs before
+# that file is fetched.) Never fails the install.
+function Note-Tool([string]$id) {
+    try {
+        $k = 'HKCU:\Software\AETHER-AR'; if (-not (Test-Path -LiteralPath $k)) { New-Item -Path $k -Force | Out-Null }
+        $have = @(); try { $have = @((Get-ItemProperty -LiteralPath $k -Name InstalledTools -ErrorAction Stop).InstalledTools | Where-Object { $_ }) } catch { }
+        if ($have -notcontains $id) { New-ItemProperty -LiteralPath $k -Name InstalledTools -PropertyType MultiString -Value ([string[]]($have + $id)) -Force | Out-Null }
+    } catch { }
+}
+$log = Join-Path $pkg 'install-log.txt'
+# one installer at a time: a second double-click (the ISO window had opened behind the console, 31.10.) started a
+# second install into the same folder -- and its transcript overwrote the first one's log. Checked before the log.
+$installLock = New-Object System.Threading.Mutex($false, 'Local\AetherAR-install')
+$ownsLock = $false; try { $ownsLock = $installLock.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $ownsLock = $true }
+if (-not $ownsLock) { Write-Host "[AETHER AR] The installer is already running in another window -- finish it there (or close that window), then start this again." -ForegroundColor Yellow; exit 3 }
+# (-LiteralPath for the package's own files: unpacked to a folder with [ ] in its name they were taken as wildcards)
+# (-NoTranscript: the Setup window writes this log itself, from the output -- a transcript misses what native
+# programs print, and two writers would clash)
+if (-not $NoTranscript) { try { Start-Transcript -LiteralPath $log -Force | Out-Null } catch { } }
+
+try {
+    $base = @{}
+    $basePath = Join-Path $pkg 'mod\BASE'
+    if (-not (Test-Path -LiteralPath $basePath)) { throw "mod\BASE is missing -- the package is incomplete; download it again" }
+    Get-Content -LiteralPath $basePath | ForEach-Object { if ($_ -match '^\s*(\w+)\s*=\s*(\S+)\s*$') { $base[$matches[1]] = $matches[2] } }
+    foreach ($k in 'repo', 'commit', 'version') { if (-not $base[$k]) { throw "mod\BASE has no '$k' -- download the package again" } }
+    $patch = Join-Path $pkg 'mod\aether-ar.patch'
+    if (-not (Test-Path -LiteralPath $patch)) { throw "mod\aether-ar.patch is missing -- download the package again" }
+    $checkIso = Join-Path $PSScriptRoot 'check-iso.ps1'
+    if (-not (Test-Path -LiteralPath $checkIso)) { throw "setup\check-iso.ps1 is missing -- the package is incomplete; download it again" }
+    try { $Host.UI.RawUI.WindowTitle = "AETHER AR $($base.version) -- install" } catch { }
+    Say "AETHER AR $($base.version) -- unofficial bring-your-own-disc mixed-reality mod for Budokai Tenkaichi 3 (Meta Quest, Link / Air Link)"
+
+    # 1. The ISO and the folder (asked first: the rest runs on its own)
+    if (-not $Iso) {
+        # said first, and the window in front of everything: it opened behind the console, and "open a folder?" was all
+        # the player saw (31.10.)
+        Say "Step 1: choose your Budokai Tenkaichi 3 USA disc image (the .iso file) in the window that opens now."
+        Add-Type -AssemblyName System.Windows.Forms
+        $dlg = New-Object System.Windows.Forms.OpenFileDialog
+        $dlg.Title = 'AETHER AR: choose your Budokai Tenkaichi 3 USA disc image (.iso)'
+        $dlg.Filter = 'PS2 disc image (*.iso)|*.iso|All files (*.*)|*.*'
+        $downloads = Join-Path ([Environment]::GetFolderPath('UserProfile')) 'Downloads'
+        if (Test-Path -LiteralPath $downloads) { $dlg.InitialDirectory = $downloads }
+        $front = New-Object System.Windows.Forms.Form -Property @{ TopMost = $true; ShowInTaskbar = $false }
+        try { $answer = $dlg.ShowDialog($front) } finally { $front.Dispose() }
+        if ($answer -ne 'OK') { throw "no ISO chosen -- start the installer again and choose your Budokai Tenkaichi 3 USA .iso file" }
+        $Iso = $dlg.FileName
+    }
+    # (-LiteralPath: [ ] in the file name are no wildcards; ProviderPath: a \\NAS\ path tar can open -- release audit 31.10.)
+    if (-not (Test-Path -LiteralPath $Iso -PathType Leaf)) { throw "ISO not found: $Iso" }
+    $Iso = (Resolve-Path -LiteralPath $Iso).ProviderPath
+    # the disc checked now, before the folder, git and the build: in ar\install.ps1 alone a wrong disc was found only
+    # after git, the download and the patch (release audit 31.10.)
+    Step 'check'
+    & $checkIso -Iso $Iso -Work (Join-Path $pkg 'iso-check')
+    Say "ISO: $Iso (Budokai Tenkaichi 3 USA, SLUS-21678 -- checked)"
+    if (-not $Dir) {
+        $default = 'C:\AETHER-AR'
+        if ($Yes) { $Dir = $default }
+        else { $in = Read-Host "Install folder (Enter = $default)"; $Dir = $(if ($in.Trim()) { $in.Trim().Trim('"') } else { $default }) }
+    }
+    $Dir = [IO.Path]::GetFullPath($Dir)
+    # no spaces (the build tools are only proven without), no [ ] (PowerShell reads them as wildcards: the scripts that
+    # run from this folder would not find their own files -- 31.10.), and a short path (Windows' 260-character limit)
+    if ($Dir -match '[\s\[\]]') { throw "please choose a folder without spaces or [ ] in its path, e.g. C:\AETHER-AR" }
+    if ($Dir.Length -gt 40) { throw "please choose a shorter folder path (at most 40 characters), e.g. C:\AETHER-AR" }
+    if ($Dir -notmatch '^[A-Za-z]:\\') { throw "please choose a folder on a drive of this PC (e.g. C:\AETHER-AR), not a network path" }
+    $drive = $Dir.Substring(0, 1)
+    # the drive must be there and local: a mapped network drive (Z: = \\server\share) passed the rule above (31.10.)
+    $psd = Get-PSDrive -Name $drive -PSProvider FileSystem -ErrorAction SilentlyContinue
+    if (-not $psd) { throw "there is no drive $($drive): on this PC -- choose a folder such as C:\AETHER-AR" }
+    if ("$($psd.DisplayRoot)" -like '\\*') { throw "$($drive): is a network drive ($($psd.DisplayRoot)) -- choose a folder on a local drive (e.g. C:\AETHER-AR)" }
+    # (a drive Windows reports no volume for -- subst, network -- is not checked: its "No MSFT_Volume objects found" is no
+    # CimException and ended the install raw, 31.10.)
+    $fs = $null; try { $fs = (Get-Volume -DriveLetter $drive -ErrorAction Stop).FileSystemType } catch { }
+    if ($null -ne $fs -and $fs -notin @('NTFS', 'ReFS')) { throw "$($drive): is a $fs drive -- the build needs an NTFS drive (e.g. C:)" }
+    $fresh = -not (Test-Path (Join-Path $Dir '.git'))
+    $free = $psd.Free / 1GB
+    if ($fresh -and $free -lt 10) { throw ("only {0:N1} GB free on {1}: -- the install needs about 10 GB" -f $free, $drive) }
+    Say "folder: $Dir"
+
+    # 2. git
+    if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
+        Step 'git'
+        Say "Git is needed to fetch BT3-Recomp."
+        if (-not (Ask "Install Git with winget?")) { throw "Git missing -- install it from git-scm.com and run this again" }
+        # (a note on stderr is no error: under this transcript Windows PowerShell 5.1 turns every stderr line into one,
+        # and 'Stop' ended the install at the first warning -- 31.10.; whether git is there is checked below)
+        if (-not (Get-Command winget.exe -ErrorAction SilentlyContinue)) { throw "Windows' package installer 'winget' is missing. Install 'App Installer' from the Microsoft Store (or Git from git-scm.com), then run this again." }
+        $old = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+        & winget.exe install -e --id Git.Git --accept-package-agreements --accept-source-agreements --silent
+        $wc = $LASTEXITCODE; $ErrorActionPreference = $old
+        $env:PATH = [Environment]::GetEnvironmentVariable('PATH', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('PATH', 'User')
+        foreach ($p in "$env:ProgramFiles\Git\cmd", "$env:LOCALAPPDATA\Programs\Git\cmd") { if ((Test-Path $p) -and (($env:PATH -split ';') -notcontains $p)) { $env:PATH = "$p;$env:PATH" } }
+        if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
+            # winget's exit code says why (it was ignored: every failure read "installed but not found yet", 31.10.)
+            if ($wc -eq 0) { throw "Git was installed but is not found yet -- close this window and run the installer again" }
+            $hex = '0x{0:X8}' -f [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$wc), 0)
+            if ($hex -in '0x8A15002B', '0x8A150061') { throw "winget says Git is already installed ($hex), but this installer cannot find it -- add it to PATH or reinstall it (from git-scm.com), then run this again" }
+            throw "winget could not install Git (code $hex) -- did you allow the Windows prompt? Update 'App Installer' in the Microsoft Store, or install Git from git-scm.com, then run this again"
+        }
+        if ($wc -eq 0) { Note-Tool 'Git.Git' }
+    }
+    # git writes its progress to stderr: not an error here, the exit code says that. (Not named "Git": PowerShell
+    # names ignore case, and a function "Git" calling "git" called itself until the call depth overflowed.)
+    function Run-Git {
+        $old = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+        & git.exe -c core.longpaths=true @args
+        $code = $LASTEXITCODE; $ErrorActionPreference = $old
+        if ($code -ne 0) { throw "git $($args -join ' ') failed (exit $code)" }
+    }
+
+    # 3. BT3-Recomp at the mod's version -- that one commit, without the history (--depth 1; GitHub hands out a commit by
+    #    its id): a full clone kept ~1 GB of history in .git that the player never uses. The submodules likewise.
+    Step 'fetch'
+    if ($fresh) {
+        if ((Test-Path $Dir) -and (Get-ChildItem $Dir -Force | Select-Object -First 1)) { throw "$Dir is not empty -- choose a new or empty folder" }
+        Say "fetching BT3-Recomp $($base.commit.Substring(0, 7)) from GitHub ..."
+        Run-Git init -q $Dir
+        Run-Git -C $Dir remote add origin $base.repo
+        Run-Git -C $Dir fetch --depth 1 origin $base.commit
+    } else {
+        $old = $ErrorActionPreference; $ErrorActionPreference = 'Continue'   # (two checks: their stderr is no error)
+        $url = (& git.exe -C $Dir remote get-url origin 2>$null)
+        & git.exe -C $Dir cat-file -e "$($base.commit)^{commit}" 2>$null
+        $haveBase = $LASTEXITCODE -eq 0; $ErrorActionPreference = $old
+        if ($url -ne $base.repo) { throw "$Dir holds another git project ($url) -- choose another folder" }
+        Say "updating the install in $Dir (memory card and settings stay)"
+        if (-not $haveBase) { Run-Git -C $Dir fetch --depth 1 origin $base.commit }   # (a full install from before 1.0.9 too)
+    }
+    Run-Git -C $Dir config core.longpaths true
+    Run-Git -C $Dir checkout -q -f --detach $base.commit
+    Run-Git -C $Dir reset -q --hard $base.commit   # (an update: the previous version's changes go)
+    Run-Git -C $Dir submodule update --init --recursive --force --depth 1
+
+    # 4. The mod (into the index first, then the files: the files come out with this PC's line endings, like git's own)
+    Step 'mod'
+    Say "putting the mod on it ..."
+    Run-Git -C $Dir apply --check --cached --binary $patch
+    Run-Git -C $Dir apply --cached --binary --whitespace=nowarn $patch
+    Run-Git -C $Dir checkout -f -- .
+    if (-not (Test-Path (Join-Path $Dir 'ar\install.ps1'))) { throw "the mod's files are not in $Dir after the patch" }
+
+    # 5. The build from the ISO (ar\install.ps1 asks before each install, unless -Yes; the build's own log is
+    #    build\setup.log)
+    $ia = @{ Iso = $Iso }; if ($Yes) { $ia.Yes = $true }; if ($NoShortcuts) { $ia.NoShortcuts = $true }
+    Step 'tools'   # (ar\install.ps1 says it too; said here as well, so the list moves on even with an older one)
+    & (Join-Path $Dir 'ar\install.ps1') @ia
+    Say "AETHER AR $($base.version) is installed in $Dir."
+    Step 'done'
+    if (-not $NoLaunch) {
+        # (minimized outside, hidden inside: Start-Process -WindowStyle Hidden hides the WinForms window too, and a normal
+        # start leaves a Windows Terminal window in the taskbar on Windows 11 -- review 01.11.)
+        Start-Process powershell -WindowStyle Minimized -ArgumentList "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$(Join-Path $Dir 'ar\AetherAR.ps1')`""
+        Say "the AETHER AR window opens now (later: the desktop shortcut 'AETHER AR')."
+    }
+    try { Stop-Transcript | Out-Null } catch { }
+    exit 0
+} catch {
+    Write-Host "[AETHER AR] FAILED: $($_.Exception.Message)" -ForegroundColor Red
+    Write-Host "[AETHER AR] the log: $log (and, once the build has started, build\setup.log in the install folder)" -ForegroundColor Red
+    try { Stop-Transcript | Out-Null } catch { }
+    exit 1
+}
diff --git a/ar/release/setup-gui.ps1 b/ar/release/setup-gui.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..3bbd65c7741c52f0e84725c096880eb0ba7133dc
--- /dev/null
+++ b/ar/release/setup-gui.ps1
@@ -0,0 +1,565 @@
+# AETHER AR -- the Setup window. "Install AETHER AR.cmd" opens it (no console): choose the disc and folder, press
+# Install, and follow the plain step list without needing to use a terminal.
+# The work itself is setup\install-aether-ar.ps1 (-Iso -Dir -Yes -NoLaunch -NoTranscript), run hidden with its output
+# redirected to a work file; this window reads that file: "[step] <id>" lines move the list, "FAILED: <why>" is the
+# reason. install-log.txt (next to the .cmd) is written by this window: everything but the compilers' warning flood
+# (19 MB of it in a full build -- build\setup.log in the install folder keeps all of that).
+#
+# QA only (inert otherwise): AETHER_SETUP_SNAPSHOT=<folder> renders every page to PNGs and closes;
+# AETHER_SETUP_AUTO=1 with AETHER_SETUP_ISO / AETHER_SETUP_DIR installs without clicks and writes the outcome to
+# AETHER_SETUP_RESULT; AETHER_SETUP_SHOTS=<folder> saves the window once a minute; AETHER_SETUP_NOSHORTCUTS=1;
+# AETHER_SETUP_KNOWN=<folder> stands in for the install Windows knows (HKCU:\Software\AETHER-AR InstallDir).
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Windows.Forms, System.Drawing
+[System.Windows.Forms.Application]::EnableVisualStyles()
+function Say-Box($m, $icon = 'Warning') { [System.Windows.Forms.MessageBox]::Show($m, 'AETHER AR Setup', 'OK', $icon) | Out-Null }
+$here = $PSScriptRoot; $pkg = Split-Path -Parent $here
+$installer = Join-Path $here 'install-aether-ar.ps1'; $checkIso = Join-Path $here 'check-iso.ps1'
+$log = Join-Path $pkg 'install-log.txt'
+# the installer's raw output goes to a folder with no [ ] in its path (Start-Process -Redirect* takes wildcards: a
+# package unpacked to "...\AETHER-AR [1]\" could not start the install at all -- review 01.11.)
+$work = Join-Path $env:LOCALAPPDATA 'AETHER-AR-setup'
+$raw = Join-Path $work 'output.txt'; $errLog = Join-Path $work 'errors.txt'
+
+try {   # (anything that goes wrong before the window shows: said, and written next to the .cmd -- not a silent nothing)
+# any error inside a click or a timer: a plain box and a line in the log, never .NET's "Unhandled exception" dialog
+[System.Windows.Forms.Application]::SetUnhandledExceptionMode('CatchException')
+[System.Windows.Forms.Application]::add_ThreadException({ param($s, $e)
+    try { Log-Write "SETUP WINDOW ERROR: $($e.Exception.Message)" } catch { }
+    Say-Box "Something went wrong in the Setup window:`n`n$($e.Exception.Message)`n`nIf it happens again, send install-log.txt (next to ""Install AETHER AR.cmd"")." 'Error' })
+
+# one Setup window at a time (the install itself has its own lock in install-aether-ar.ps1)
+$guiLock = New-Object System.Threading.Mutex($false, 'Local\AetherAR-setup-window')
+$own = $false; try { $own = $guiLock.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $own = $true }
+if (-not $own) { Say-Box 'AETHER AR Setup is already open (look in the taskbar).' 'Information'; exit 3 }
+foreach ($p in $installer, $checkIso, (Join-Path $pkg 'mod\aether-ar.patch'), (Join-Path $pkg 'mod\BASE')) {
+    if (-not (Test-Path -LiteralPath $p)) { Say-Box "The package is incomplete ($([IO.Path]::GetFileName($p)) is missing). Download the ZIP again and unpack all of it (right-click > Extract All)." 'Error'; exit 1 }
+}
+New-Item -ItemType Directory -Force -Path $work | Out-Null
+$version = ''
+foreach ($l in (Get-Content -LiteralPath (Join-Path $pkg 'mod\BASE'))) { if ($l -match '^\s*version\s*=\s*(\S+)') { $version = $matches[1] } }
+# the PC stays awake while it installs (30-60 minutes; it slept half-way before -- review 01.11.)
+try { Add-Type -Namespace AetherAR -Name Power -MemberDefinition '[DllImport("kernel32.dll")] public static extern uint SetThreadExecutionState(uint esFlags);' } catch { }
+function Keep-Awake($on) { try { [void][AetherAR.Power]::SetThreadExecutionState($(if ($on) { [uint32]2147483649 } else { [uint32]2147483648 })) } catch { } }
+
+# ---- look (the AETHER AR window's colours)
+$orange = [System.Drawing.Color]::FromArgb(255, 140, 0); $dark = [System.Drawing.Color]::FromArgb(24, 26, 32)
+$panel = [System.Drawing.Color]::FromArgb(36, 39, 48); $silver = [System.Drawing.Color]::FromArgb(170, 176, 188)
+$green = [System.Drawing.Color]::FromArgb(90, 210, 130); $red = [System.Drawing.Color]::FromArgb(255, 110, 110)
+$white = [System.Drawing.Color]::White; $dim = [System.Drawing.Color]::FromArgb(95, 100, 112)
+$sym = @{ ok = [string][char]0x2713; bad = [string][char]0x2717; now = [string][char]0x25CF; wait = [string][char]0x25CB }
+function Font($size, $bold = $false, $name = 'Segoe UI') { New-Object System.Drawing.Font($name, $size, $(if ($bold) { [System.Drawing.FontStyle]::Bold } else { [System.Drawing.FontStyle]::Regular })) }
+function Nice([string]$s) { $s.Replace(' -- ', " $([char]0x2013) ") }   # (the scripts' ASCII "--" as a real dash on screen)
+# a message from the installers, as the window says it: a capital first letter, and no "run this again" (here it is a button)
+function Gui-Text([string]$m) {
+    $m = "$m".Trim(); if (-not $m) { return $m }
+    $m = $m.Replace(', then run this again', ', then press Try again').Replace(' and run this again', ' and press Try again').Replace(' then run this again', ' then press Try again').Replace('run the installer again', 'press Try again')
+    Nice ($m.Substring(0, 1).ToUpper() + $m.Substring(1))
+}
+function Label($parent, $text, $x, $y, $w, $h, $size = 10, $bold = $false, $color = $white) {
+    $l = New-Object System.Windows.Forms.Label; $l.Text = Nice $text; $l.Location = New-Object System.Drawing.Point($x, $y)
+    $l.Size = New-Object System.Drawing.Size($w, $h); $l.Font = Font $size $bold; $l.ForeColor = $color; $l.BackColor = [System.Drawing.Color]::Transparent
+    $parent.Controls.Add($l); return $l
+}
+function Button($parent, $text, $x, $y, $w, $h, $accent = $false) {
+    $b = New-Object System.Windows.Forms.Button; $b.Text = $text; $b.Location = New-Object System.Drawing.Point($x, $y)
+    $b.Size = New-Object System.Drawing.Size($w, $h); $b.FlatStyle = 'Flat'; $b.FlatAppearance.BorderColor = $orange; $b.Cursor = 'Hand'
+    $b.Font = Font $(if ($accent) { 12 } else { 10 }) $accent
+    $b.BackColor = $(if ($accent) { $orange } else { $panel }); $b.ForeColor = $(if ($accent) { [System.Drawing.Color]::Black } else { $white })
+    $parent.Controls.Add($b); return $b
+}
+function Set-Accent($b, $on) {   # (a disabled flat button keeps its colour: greyed by hand)
+    $b.Enabled = $on; $b.BackColor = $(if ($on) { $orange } else { $panel }); $b.ForeColor = $(if ($on) { [System.Drawing.Color]::Black } else { $dim })
+    $b.FlatAppearance.BorderColor = $(if ($on) { $orange } else { $dim })
+}
+
+$f = New-Object System.Windows.Forms.Form
+# 628 high inside: fits a 1080p screen at 150 % (about 680 usable) without scrolling
+$f.Text = "AETHER AR $version Setup".Replace('  ', ' '); $f.ClientSize = New-Object System.Drawing.Size(760, 628)
+$f.StartPosition = 'CenterScreen'; $f.BackColor = $dark; $f.ForeColor = $white; $f.FormBorderStyle = 'FixedSingle'
+$f.MaximizeBox = $false; $f.Font = Font 10
+try { $f.Icon = New-Object System.Drawing.Icon((Join-Path $here 'aether-ar.ico')) } catch { }   # (AETHER AR's own mark; an older package without it keeps the plain one)
+# header (all pages)
+Label $f 'AETHER AR' 26 12 210 44 24 $true $orange | Out-Null
+Label $f "Setup  v$version" 236 28 200 24 10 $false $silver | Out-Null
+Label $f 'Dragon Ball Z: Budokai Tenkaichi 3 in your real room, on Meta Quest' 28 56 700 22 10 $false $silver | Out-Null
+$rule = New-Object System.Windows.Forms.Panel; $rule.Location = New-Object System.Drawing.Point(28, 84); $rule.Size = New-Object System.Drawing.Size(704, 2); $rule.BackColor = $orange; $f.Controls.Add($rule)
+function Page { $p = New-Object System.Windows.Forms.Panel; $p.Location = New-Object System.Drawing.Point(0, 88); $p.Size = New-Object System.Drawing.Size(760, 540); $p.BackColor = $dark; $p.Visible = $false; $f.Controls.Add($p); return $p }
+$pgSetup = Page; $pgRun = Page; $pgDone = Page; $pgFail = Page
+function Show-Page($p) { foreach ($q in $pgSetup, $pgRun, $pgDone, $pgFail) { $q.Visible = ($q -eq $p) }; $p.BringToFront() }
+
+# ================= page 1: disc, folder, install
+Label $pgSetup '1   Your game disc' 28 12 400 26 13 $true | Out-Null
+$drop = New-Object System.Windows.Forms.Panel; $drop.Location = New-Object System.Drawing.Point(28, 44); $drop.Size = New-Object System.Drawing.Size(704, 92); $drop.BackColor = $panel
+$pgSetup.Controls.Add($drop)
+$drop.Add_Paint({ param($s, $e)
