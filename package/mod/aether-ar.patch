+    // ARP1 -> room space (metres, y up). Anchor-local up is +z in Mario's file unless PS2X_AR_ANCHOR_UP=y.
+    bool loadScan(const char *path, std::vector<V3> &pts)
+    {
+        std::ifstream in(path, std::ios::binary);
+        if (!in.good()) { std::fprintf(stderr, "[arroom] cannot open %s\n", path); return false; }
+        int32_t magic = 0, version = 0, len = 0, count = 0;
+        in.read(reinterpret_cast<char *>(&magic), 4); in.read(reinterpret_cast<char *>(&version), 4); in.read(reinterpret_cast<char *>(&len), 4);
+        if (magic != 0x31505241 || version != 1 || len <= 0 || len > 64) { std::fprintf(stderr, "[arroom] %s is not an ARP1 scan\n", path); return false; }
+        std::string anchor(size_t(len), '\0'); in.read(anchor.data(), len);
+        in.read(reinterpret_cast<char *>(&count), 4);
+        if (count <= 0 || count > 4000000) return false;
+        pts.resize(size_t(count) * 3);
+        in.read(reinterpret_cast<char *>(pts.data()), std::streamsize(pts.size() * sizeof(V3)));
+        if (!in) { std::fprintf(stderr, "[arroom] %s is truncated\n", path); return false; }
+        const char *up = std::getenv("PS2X_AR_ANCHOR_UP");
+        if (!(up && up[0] == 'y'))
+            for (V3 &p : pts) p = { p.x, p.z, -p.y };   // anchor +z up -> room +y up (a rotation: winding kept)
+        std::fprintf(stderr, "[arroom] scan %s: anchor %s, %d triangles\n", path, anchor.c_str(), count);
+        g_room.anchor = anchor;
+        return true;
+    }
