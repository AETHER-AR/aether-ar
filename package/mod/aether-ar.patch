+        {   // [arhold] the PC's now in XrTime. The room's anchors and planes are located at the ROOM TIME = now minus a margin
+            // that Link's anchor cache holds (asked for at the predicted display time they came back head-coupled, 01.11.).
+            // PS2X_AR_ANCHOR_AGE=<s> (tests): the margin, 0..2 s; 0 = the predicted display time (the old way).
+            static const XrDuration s_age = [](){ const char *v = std::getenv("PS2X_AR_ANCHOR_AGE"); double s = v && v[0] ? std::atof(v) : 0.3; s = std::max(0.0, std::min(2.0, s)); return XrDuration(s * 1e9); }();
+            long long qpc = 0; XrTime now = 0; XrResult cr = XR_ERROR_FUNCTION_UNSUPPORTED;
