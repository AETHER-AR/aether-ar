diff --git a/ps2xRuntime/src/lib/seamvk/areye.frag b/ps2xRuntime/src/lib/seamvk/areye.frag
new file mode 100644
index 0000000000000000000000000000000000000000..46161b45e61afd25bf457eaa76b0c2735c24f934
--- /dev/null
+++ b/ps2xRuntime/src/lib/seamvk/areye.frag
@@ -0,0 +1,30 @@
+#version 450
+// [arxr] The scene target into an eye's swapchain image, with the coverage alpha the compositor needs to show
+// passthrough around the fighters.
+//   taps.w = 1 (the eye): coverage from DEPTH -- the scene buffer starts every eye cleared with the room occluder's
+//   depth alone (uOcc holds a copy of exactly that); wherever the scene depth is nearer afterwards, a fighter was
+//   drawn there in front of the real room: solid, whatever colour it is (black hair stays). Additive effects write
+//   no depth: their light counts through the brightness term and their black texture squares stay invisible.
+//   taps.w = 0 (the HUD panel): the game's stored alpha, plus brightness.
+// Premultiplied, as the compositor expects by default.
+layout(push_constant) uniform PCP { vec4 src; vec4 dst; vec4 alpha; vec4 taps; } pc;
+layout(set = 0, binding = 0) uniform sampler2D uTex;
+layout(set = 0, binding = 1) uniform sampler2D uDepth;   // the scene's depth (reverse-Z: nearer = larger)
+layout(set = 0, binding = 2) uniform sampler2D uOcc;     // the occluder-only depth of the same eye
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 outColor;
+void main()
+{
+    vec4 c = texture(uTex, vUv);
+    if (pc.alpha.z > 0.5) { outColor = c; return; }   // [arportal] a finished (premultiplied) eye image, as it is
+    float a;
+    if (pc.taps.w > 0.5)
+    {
+        float ds = texture(uDepth, vUv).r, dz = texture(uOcc, vUv).r;
+        a = ds > dz + 1e-7 ? 1.0 : 0.0;
+    }
+    else a = smoothstep(0.0, 0.03, c.a);
+    a = max(a, clamp(max(c.r, max(c.g, c.b)) * 1.5, 0.0, 1.0));
+    if (pc.alpha.y > 0.5) a = 1.0;   // [arportal] the player stands in the world: all of it, the cut redraws the room's part
+    outColor = vec4(c.rgb * a, a);
+}
