index 0000000000000000000000000000000000000000..abaf1b720d0e5fd334e64afd54ed58b70b7dfb49
--- /dev/null
+++ b/ar/install.ps1
@@ -0,0 +1,325 @@
+# AETHER AR -- one-click install (Windows). An unofficial mixed-reality mod.
+#
+# Bring your own disc: nothing of the game is shipped. This script asks for YOUR copy of
+# Budokai Tenkaichi 3 (USA, SLUS-21678) as an ISO, checks it, and builds the AR edition from it on
+# this PC (games\bt3\setup.py: dependencies, recompilation, runner). Then it fetches Android platform-tools (adb, to
+# talk to the Quest), turns on Link's passthrough edge fix for this user (no black shadow behind the fighters), puts
+# "AETHER AR" on the desktop and in the Start menu, and adds it to Settings > Apps (Uninstall runs ar\uninstall.ps1).
+#
+#   powershell -File ar\install.ps1 -Iso D:\bt3.iso [-Yes] [-NoShortcuts] [-NoAdb]
+#   (in a developer checkout also ar\Install-AetherAR.cmd, double-click; the release package leaves it out)
+param([string]$Iso, [switch]$Yes, [switch]$NoShortcuts, [switch]$NoAdb)
+$ErrorActionPreference = 'Stop'
+# a throw ended this script before the launcher's "*> install.log" got its message: the window said "install failed --
+# see the log" over a log without the reason. Said here first, then passed on (break): the exit code stays 1 and the
+# release installer's catch still gets it (release audit 31.10.)
+trap { Write-Host "[install] FAILED: $($_.Exception.Message)" -ForegroundColor Red; break }
+$ar = $PSScriptRoot
+$root = Split-Path -Parent $ar
+# its place in Windows -- shortcuts, the Settings > Apps entry, the record of the tools it installs: ar\shortcuts.ps1
+$shortcutsPs1 = Join-Path $ar 'shortcuts.ps1'
+if (-not (Test-Path -LiteralPath $shortcutsPs1)) { throw "ar\shortcuts.ps1 is missing -- the install is incomplete; download the package again" }
+. $shortcutsPs1
+function Say($m) { Write-Host "[install] $m" -ForegroundColor Cyan }
+function Step($id) { if ($env:AETHER_SETUP_STEPS -eq '1') { Write-Host "[step] $id" } }   # (only for the package's Setup window: tools, build, finish)
+function Ask($q) { if ($Yes) { return $true }; return (Read-Host "$q [y/N]") -match '^(y|j)' }
+# winget (and python, below) write notes and warnings to stderr. Under the package installer's transcript Windows
+# PowerShell 5.1 turns every stderr line into an error, and with 'Stop' the build's first warning ended the install
+# after the game was already built ("lavapipe not found", fresh install 31.10.). Their exit codes decide instead.
+function Run-Winget {
+    # an older Windows 10 can be without winget ('App Installer'): said plainly, not as "the term winget.exe is not recognized"
+    if (-not (Get-Command winget.exe -ErrorAction SilentlyContinue)) { throw "Windows' package installer 'winget' is missing. Install 'App Installer' from the Microsoft Store (or update Windows), then run this installer again." }
+    # (Write-Host, not Out-Host: it reaches the launcher's install.log under *> too -- winget's reason for a failure with it)
+    $old = $ErrorActionPreference; $ErrorActionPreference = 'Continue'; & winget.exe @args 2>&1 | ForEach-Object { Write-Host "$_" }
+    $code = $LASTEXITCODE; $ErrorActionPreference = $old
+    # installed now (0; "already installed" is another code): noted for the uninstaller, which names it at the end --
+    # the tool stays on the PC, other programs may use it
+    $i = [array]::IndexOf([object[]]$args, '--id')
+    if ($code -eq 0 -and $args -contains 'install' -and $i -ge 0 -and $i + 1 -lt $args.Count) { Add-AetherInstalledTool "$($args[$i + 1])" }
+    return $code   # (the callers say what it means when the tool is still missing: it was ignored before, 31.10.)
+}
+# what to say when a tool is still not found after winget ran (its exit code as winget prints it: 0x8A15...)
+function Winget-Missing($code, $tool, $url, $fix = '') {
+    if ($code -eq 0) { return "$tool was installed but is not found yet -- close this window and run the installer again" }
+    $hex = '0x{0:X8}' -f [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$code), 0)
+    # 'no applicable upgrade' / 'already installed': there, but not where this installer looks
+    if (-not $fix) { $fix = "add it to PATH or reinstall it (from $url)" }
+    if ($hex -in '0x8A15002B', '0x8A150061') { return "winget says $tool is already installed ($hex), but this installer cannot find it -- $fix, then run this again" }
+    return "winget could not install $tool (code $hex) -- did you allow the Windows prompt? Update 'App Installer' in the Microsoft Store, or install $tool from $url, then run this again"
+}
+
+Say "AETHER AR -- unofficial bring-your-own-ISO mixed-reality build of Budokai Tenkaichi 3 for Meta Quest (PC VR over Link / Air Link)"
+# one install at a time (the AETHER AR window's Install and the package's installer share the lock; the package's
+# installer calls this script in its own process, which already holds it)
+$installLock = New-Object System.Threading.Mutex($false, 'Local\AetherAR-install')
+$ownsLock = $false; try { $ownsLock = $installLock.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $ownsLock = $true }
+if (-not $ownsLock) { throw "an AETHER AR install is already running in another window -- let it finish (or close it), then try again" }
+
+# 0. The ISO (your own copy) -- chosen and checked FIRST: a European / Japanese disc, a CHD / CSO / BIN or a modified
+#    dump was only found after the whole toolchain was installed, as a raw tar error (release audit 31.10.)
+if (-not $Iso) {
+    # said first, and the window in front of everything: it opened behind the console (31.10.)
+    Say "Step 1: choose your Budokai Tenkaichi 3 USA disc image (the .iso file) in the window that opens now."
+    Add-Type -AssemblyName System.Windows.Forms
+    $dlg = New-Object System.Windows.Forms.OpenFileDialog
+    $dlg.Title = 'AETHER AR: choose your Budokai Tenkaichi 3 USA disc image (.iso)'
+    $dlg.Filter = 'PS2 disc image (*.iso)|*.iso|All files (*.*)|*.*'
+    $downloads = Join-Path ([Environment]::GetFolderPath('UserProfile')) 'Downloads'
+    if (Test-Path -LiteralPath $downloads) { $dlg.InitialDirectory = $downloads }
+    $front = New-Object System.Windows.Forms.Form -Property @{ TopMost = $true; ShowInTaskbar = $false }
+    try { $answer = $dlg.ShowDialog($front) } finally { $front.Dispose() }
+    if ($answer -ne 'OK') { throw "no ISO chosen -- start the installer again and choose your Budokai Tenkaichi 3 USA .iso file" }
+    $Iso = $dlg.FileName
+}
+# (-LiteralPath: the [ ] in "Dragon Ball Z [SLUS-21678].iso" are no wildcards; ProviderPath: a \\NAS\ path without
+# PowerShell's "FileSystem::" prefix, which tar cannot open -- release audit 31.10.)
+if (-not (Test-Path -LiteralPath $Iso -PathType Leaf)) { throw "ISO not found: $Iso" }
+$Iso = (Resolve-Path -LiteralPath $Iso).ProviderPath
+# the check itself is ar\check-iso.ps1: the release installer runs it too, before git and the build
+$checkIso = Join-Path $ar 'check-iso.ps1'
+if (-not (Test-Path -LiteralPath $checkIso)) { throw "ar\check-iso.ps1 is missing -- the install is incomplete; download the package again" }
+& $checkIso -Iso $Iso -Work (Join-Path $root 'build\iso-check')
+Say "ISO: $Iso (Budokai Tenkaichi 3 USA, SLUS-21678 -- checked)"
+
+# The build needs an NTFS (or ReFS) drive: on exFAT / FAT the fetched libraries cannot be unpacked ("Can't restore
+# time") -- said now, not after half an hour of building
+# (a drive Windows reports no volume for -- subst, network -- is not checked: its "No MSFT_Volume objects found" is no
+# CimException and ended the install raw, 31.10.)
+# A network folder (\\server\share, or a mapped drive Z: = \\server\share) is refused plainly: the build is only proven
+# on a local drive, and Get-PSDrive '\' failed raw (31.10.)
+$rootDrive = $(if ($root -match '^[A-Za-z]:\\') { Get-PSDrive -Name $root.Substring(0, 1) -PSProvider FileSystem -ErrorAction SilentlyContinue })
+if (-not $rootDrive -or "$($rootDrive.DisplayRoot)" -like '\\*') { throw "this folder ($root) is on a network drive -- copy it to a local drive (e.g. C:\AETHER-AR) and run the installer there" }
+$fs = $null; try { $fs = (Get-Volume -DriveLetter ($root.Substring(0, 1)) -ErrorAction Stop).FileSystemType } catch { }
+if ($null -ne $fs -and $fs -notin @('NTFS', 'ReFS')) { throw "this folder is on a $fs drive -- move it to an NTFS drive (e.g. C:\DBAR) and run the installer there" }
+$free = $rootDrive.Free / 1GB
+if ($free -lt 6) { throw ("only {0:N1} GB free on this drive -- the build needs about 6 GB" -f $free) }
+
+Step 'tools'
+# 1. Python (setup.py drives everything else, including the compiler toolchain). Found by its full path, not by PATH:
+#    a PC without Python often has the Microsoft Store's stand-in python.exe on PATH (it answers on stderr and opens
+#    the Store), and the python.org installer that winget runs does not add itself to PATH unless told to.
+function Find-Python {
+    $cands = @()
+    $c = Get-Command python -ErrorAction SilentlyContinue; if ($c -and $c.Source -notlike '*\WindowsApps\*') { $cands += $c.Source }
+    $eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+    if (Get-Command py -ErrorAction SilentlyContinue) { $cands += @(& py -3 -c "import sys; print(sys.executable)" 2>$null) }
+    $ErrorActionPreference = $eap
+    foreach ($d in "$env:LOCALAPPDATA\Programs\Python", "$env:ProgramFiles", "${env:ProgramFiles(x86)}") {
+        # newest first by the number (as text Python39 came before Python312 -- release audit 31.10.)
+        $cands += @(Get-ChildItem $d -Directory -Filter 'Python3*' -ErrorAction SilentlyContinue | Sort-Object { [int]([regex]::Match($_.Name, '^Python3(\d+)').Groups[1].Value) } -Descending | ForEach-Object { Join-Path $_.FullName 'python.exe' })
+    }
+    foreach ($p in $cands) {
+        if (-not $p -or -not (Test-Path $p)) { continue }
+        $eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+        $v = (& $p --version 2>&1) -join ' '
+        $ErrorActionPreference = $eap
+        if ($v -match 'Python 3\.(1[0-9])') { return $p }   # (3.10+ only: 3.8 / 3.9 were taken too)
+    }
+    return $null
+}
+$python = Find-Python
+if (-not $python) {
+    Say "Python 3.10+ is needed."
+    if (-not (Ask "Install Python 3.12 with winget?")) { throw "Python missing -- install it from python.org and run this again" }
+    $wc = Run-Winget install -e --id Python.Python.3.12 --accept-package-agreements --accept-source-agreements --silent   # (--silent: no Python setup window popping up)
+    $env:PATH = [Environment]::GetEnvironmentVariable('PATH', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('PATH', 'User')
+    $python = Find-Python
+    if (-not $python) { throw (Winget-Missing $wc 'Python 3.12' 'python.org/downloads') }
+}
+# setup.py starts python / pip itself too: this one first on PATH for this run
+$pyDir = Split-Path $python
+$env:PATH = "$pyDir;$pyDir\Scripts;$env:PATH"
+Say "python: $python"
+
+# 1b. CMake + Ninja on PATH before the build starts. setup.py's own winget step cannot refresh its PATH afterwards,
+#     and a Visual Studio without its CMake component has neither (a clean PC failed exactly there).
+function Find-Tool($name, $extra) {
+    $c = Get-Command $name -ErrorAction SilentlyContinue; if ($c) { return Split-Path $c.Source }
+    $vsw = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe"
+    if (Test-Path $vsw) {
+        foreach ($vs in (& $vsw -all -products * -property installationPath)) {
+            $d = Get-ChildItem "$vs\Common7\IDE\CommonExtensions\Microsoft\CMake" -Recurse -Filter "$name.exe" -ErrorAction SilentlyContinue | Select-Object -First 1
+            if ($d) { return $d.DirectoryName }
+        }
+    }
+    foreach ($p in $extra) { $d = Get-ChildItem $p -Recurse -Filter "$name.exe" -ErrorAction SilentlyContinue | Select-Object -First 1; if ($d) { return $d.DirectoryName } }
+    return $null
+}
+$wingetDirs = @("$env:ProgramFiles\CMake\bin", "$env:LOCALAPPDATA\Microsoft\WinGet\Links", "$env:LOCALAPPDATA\Microsoft\WinGet\Packages")
+foreach ($t in @(@{ n = 'cmake'; id = 'Kitware.CMake'; url = 'cmake.org/download' }, @{ n = 'ninja'; id = 'Ninja-build.Ninja'; url = 'github.com/ninja-build/ninja/releases' })) {
+    $dir = Find-Tool $t.n $wingetDirs
+    if (-not $dir) {
+        if (-not (Ask "$($t.n) is needed for the build. Install it with winget?")) { throw "$($t.n) missing -- install it ('winget install $($t.id)') and run this again" }
+        $wc = Run-Winget install -e --id $t.id --accept-package-agreements --accept-source-agreements --silent
+        $dir = Find-Tool $t.n $wingetDirs
+        if (-not $dir) { throw (Winget-Missing $wc $t.n $t.url) }
+    }
+    if (($env:PATH -split ';') -notcontains $dir) { $env:PATH = "$dir;$env:PATH" }
+    Say "$($t.n): $dir"
+}
+
+# 1c. The compiler: the build needs Visual Studio 2022 (or its Build Tools) WITH the C++ tools and the Clang
+#     toolset. setup.py takes any installed Visual Studio as enough, so a PC whose Visual Studio lacks Clang failed
+#     with "clang-cl not found" (this PC, 20.10.) -- and with only an older Visual Studio it would not install the
+#     2022 one either. So it is settled here: the missing parts added to a Visual Studio 2022, or the 2022 Build
+#     Tools installed when there is none.
+$vsAdd = @('Microsoft.VisualStudio.Component.VC.Tools.x86.x64', 'Microsoft.VisualStudio.Component.VC.Llvm.Clang',
+           'Microsoft.VisualStudio.Component.VC.Llvm.ClangToolset', 'Microsoft.VisualStudio.Component.VC.CMake.Project',
+           'Microsoft.VisualStudio.Component.Windows11SDK.22621')
+$vswhere = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe"
+function VS-Ready { if (-not (Test-Path $vswhere)) { return $null }; return @(& $vswhere -products * -version '[17.0,' -requires $vsAdd[0] $vsAdd[1] $vsAdd[2] -property installationPath)[0] }
+$ready = VS-Ready
+if (-not $ready) {
+    $vs = $(if (Test-Path $vswhere) { @(& $vswhere -products * -version '[17.0,' -property installationPath)[0] })
+    # what goes to the Windows drive: the Visual Studio parts, plus the game build's ~6 GB when this folder is on it too
+    # (the default C:\AETHER-AR -- the check below only counted Visual Studio, release audit 31.10.)
+    $sysFree = (Get-PSDrive ($env:SystemDrive.Substring(0, 1))).Free / 1GB
+    $buildHere = $(if ($root.Substring(0, 1) -eq $env:SystemDrive.Substring(0, 1)) { 6 } else { 0 })
+    function Build-Note($n) { if ($buildHere) { ", plus about $buildHere GB for the game build in this folder ($n GB in all)" } else { '' } }
+    if ($vs) {
+        Say "Visual Studio ($vs) is missing the C++ / Clang parts the build needs."
+        $need = 4 + $buildHere
+        if ($sysFree -lt $need) { throw ("only {0:N1} GB free on {1} -- the Visual Studio C++ / Clang parts need about 4 GB there{2}. Free some space, then run this again" -f $sysFree, $env:SystemDrive, (Build-Note $need)) }
+        if (-not (Ask "Add them with the Visual Studio Installer (a few GB, Windows asks for permission)?")) { throw "the C++ / Clang parts of Visual Studio are missing -- add 'C++ Clang tools for Windows' in the Visual Studio Installer and run this again" }
+        $vsArgs = @('modify', '--installPath', "`"$vs`"", '--quiet', '--norestart', '--nocache') + ($vsAdd | ForEach-Object { @('--add', $_) })
+        # (a declined Windows prompt throws "The operation was canceled by the user": said what to do, 31.10.)
+        try { $p = Start-Process "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\setup.exe" -ArgumentList $vsArgs -Verb RunAs -Wait -PassThru }
+        catch { throw "the Visual Studio Installer did not start ($($_.Exception.Message)) -- allow the Windows prompt, or add 'C++ Clang tools for Windows' in the Visual Studio Installer by hand, then run this again" }
+        if ($p.ExitCode -notin @(0, 3010)) { throw "the Visual Studio Installer stopped with code $($p.ExitCode) -- add 'C++ Clang tools for Windows' by hand and run this again" }
+        Add-AetherInstalledTool 'Microsoft.VisualStudio.Component.VC.Llvm.Clang'   # (for the uninstaller's list, like Run-Winget)
+        $wc = $null
+    } else {
+        Say "The build needs the Visual Studio 2022 Build Tools (the C++ compiler with Clang, free from Microsoft)."
+        # they land on the Windows drive (about 8 GB) whatever folder the game goes to: checked now, not mid-install
+        $need = 12 + $buildHere
+        if ($sysFree -lt $need) { throw ("only {0:N1} GB free on {1} -- the Visual Studio Build Tools need about 12 GB there{2}. Free some space, then run this again" -f $sysFree, $env:SystemDrive, (Build-Note $need)) }
+        if (-not (Ask "Install them with winget (a few GB, Windows asks for permission)?")) { throw "Visual Studio 2022 Build Tools missing -- install them with the C++ and Clang parts and run this again" }
+        $wc = Run-Winget install -e --id Microsoft.VisualStudio.2022.BuildTools --accept-package-agreements --accept-source-agreements --override ("--quiet --wait --norestart --nocache " + (($vsAdd | ForEach-Object { "--add $_" }) -join ' '))
+    }
+    $ready = VS-Ready
+    if (-not $ready -and $wc) { throw (Winget-Missing $wc 'the Visual Studio 2022 Build Tools (with the C++ and Clang parts)' 'visualstudio.microsoft.com/visual-cpp-build-tools' "open the Visual Studio Installer, choose Modify on the Build Tools and add 'Desktop development with C++' plus 'C++ Clang tools for Windows' (or repair them there)") }
+    if (-not $ready) { throw "Visual Studio 2022 with the C++ / Clang parts is still not there -- install 'Desktop development with C++' plus 'C++ Clang tools for Windows' and run this again" }
+}
+Say "compiler: $ready"
+
+# 2. (the ISO is chosen and checked at the very start, see above)
+
+# 3. Build: dependencies (asks before each install), recompilation from the ISO, the runner
+# -y --non-interactive always: setup.py's own welcome ('this is not the end-user installer -- press Enter') stopped a
+# double-click install half-way (release audit 31.10.); the player agreed to the installs in this installer already
+$argv = @("$root\games\bt3\setup.py", $Iso, '--install-deps', '--no-package', '--no-desktop-copy', '-y', '--non-interactive')
+Step 'build'
+Say "building -- the first run takes a while (30-60 minutes on a typical PC)"
+# On drives that record no file owner (exFAT / FAT external drives) git refuses the libraries CMake fetches
+# ("dubious ownership"). Trusted for this build process only -- nothing is written to the user's git config.
+$env:GIT_CONFIG_COUNT = '1'; $env:GIT_CONFIG_KEY_0 = 'safe.directory'; $env:GIT_CONFIG_VALUE_0 = '*'
+$eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'   # (its warnings are no error: see Run-Winget)
+& $python @argv
+$code = $LASTEXITCODE; $ErrorActionPreference = $eap
+if ($code -ne 0) { throw "the build failed (see build\setup.log)" }
+$exe = Join-Path $root 'build\ps2xRuntime\ps2EntryRunner.exe'
+if (-not (Test-Path $exe)) { throw "the build finished but $exe is missing" }
+Step 'finish'
+
+# 3b. The memory card: the runner reads it from games\bt3\savedata (beside work\, where the ELF is). No save is
+#     shipped or copied in: on the first start the game asks to create its save and writes it there itself (quick
+#     start answers Yes). An existing card -- a reinstall -- is left as it is.
+New-Item -ItemType Directory -Force (Join-Path $root 'games\bt3\savedata') | Out-Null
+
+# 4. adb (Android platform-tools from Google): the launcher waits for the headset, wakes Link and turns the room
+#    boundary off with it. Optional: without it the game still runs, the launcher just cannot do those things.
+$adb = Join-Path $ar 'platform-tools\adb.exe'
+# an adb that already runs (Android Studio, Unity, SideQuest) is used as it is: a second adb of another version
+# would restart the server and cut those programs off
+$running = Get-Process adb -ErrorAction SilentlyContinue | Where-Object { $_.Path } | Select-Object -First 1
+if ($running) { $adb = $running.Path; Say "adb: using the one already running ($adb)" }
+if (-not $NoAdb -and -not (Test-Path $adb)) {
+    if (Ask "Download Android platform-tools (adb) from Google (about 7 MB)?") {
+        $zip = Join-Path $env:TEMP 'platform-tools-latest-windows.zip'
+        try {   # (optional: a network hiccup here must not fail the finished build -- release audit 31.10.)
+            Invoke-WebRequest 'https://dl.google.com/android/repository/platform-tools-latest-windows.zip' -OutFile $zip -UseBasicParsing
+            Expand-Archive $zip -DestinationPath $ar -Force
+            Remove-Item $zip
+        } catch { Say "adb could not be downloaded ($($_.Exception.Message)) -- the game runs without it; run the installer again later for the boundary / headset status" }
+    }
+}
+
+# 5. Settings the launcher reads (a reinstall keeps the ones already chosen, only the ISO and adb are renewed)
+$cfgPath = Join-Path $ar 'config.json'
+$cfg = [ordered]@{ iso = $Iso; adb = $(if (Test-Path $adb) { $adb } else { '' }); roomScan = ''; roomWallScan = '' }
+if (Test-Path $cfgPath) {
+    try {
+        $old = Get-Content $cfgPath -Raw | ConvertFrom-Json
+        foreach ($p in $old.PSObject.Properties) { if (-not $cfg.Contains($p.Name) -or ($p.Name -like 'room*Scan' -and $p.Value)) { $cfg[$p.Name] = $p.Value } }
+    } catch { }
+}
+$cfg | ConvertTo-Json | Set-Content -Encoding UTF8 $cfgPath
+Say "settings written to ar\config.json"
+
+# 5a. The Link passthrough edge fix (ar\shortcuts.ps1 Enable-AetherLinkEdgeFix): testers saw a black, slightly offset
+#     shadow behind the fighters and the aiming ray -- Meta Horizon Link scales the picture's transparency up again in
+#     the headset ~1.5 % too tall. Link's own setting for it is a user environment variable (no admin); what was there
+#     before is noted for the uninstaller. Link reads it at its next start: the AETHER AR window restarts Link once at
+#     Start, with a box that says so first. Turned off in the window's Options (config linkEdgeFix = false), an update
+#     leaves it off. Also under -NoShortcuts: the variable is the same for every install of this user.
+if ($cfg.Contains('linkEdgeFix') -and $cfg['linkEdgeFix'] -eq $false) { Say "Link passthrough edge fix: off in the AETHER AR window's Options -- left as it is" }
+else {
+    try {
+        $wrote = Enable-AetherLinkEdgeFix
+        if ($wrote) { Say "Link passthrough edge fix: on (REMOTEHEADSET_ALPHAPREPROCCESINGSCHEME=0 for this user; Link reads it at its next start -- the AETHER AR window restarts Link once when you press Start)" }
+        else { Say "Link passthrough edge fix: already on for this user (REMOTEHEADSET_ALPHAPREPROCCESINGSCHEME=0)" }
+    } catch { Say "Link passthrough edge fix could not be set ($($_.Exception.Message)) -- the AETHER AR window tries again and shows it" }
+}
+
+# 5b. A short "start here" at the top of the folder: the folder is BT3-Recomp's developer tree, and a player who opens
+#     it should find how to start, where the disc is, how to update and how to remove it (CRLF: Notepad on an older
+#     Windows 10 wants it)
+$remove = $(if ($NoShortcuts) { "  Right-click ar\uninstall.ps1 in this folder > Run with PowerShell." }
+             else { "  Windows Settings > Apps > Installed apps > AETHER AR > Uninstall.`n  It asks first whether to keep your memory card." })
+$here = @"
+AETHER AR - START HERE
+======================
+
+START
+  The desktop shortcut "AETHER AR", or type AETHER in the Start menu.
+  To keep it in the taskbar: right-click it in Start > Pin to taskbar.
+  No shortcut? Double-click "AETHER AR.cmd" in this folder.
+
+PLAY
+  1. Press Start in the AETHER AR window, then put the headset on and turn on Link
+     (Quick Settings > Link). The game appears in the headset by itself.
+  2. Menus: left stick + A. B = back.
+  3. The fight starts on your desk or table by itself -- look around for it.
+     To move it: point a controller at another spot and pull the trigger.
+  4. To end: take the headset off and press Stop in the AETHER AR window.
+  More (controls, if something does not work): the Help button in the AETHER AR window.
+
+YOUR DISC IMAGE
+  $Iso
+  Keep it where it is: AETHER AR reads it every time you play.
+
+UPDATE
+  A new version comes as a new ZIP from whoever gave you AETHER AR. Unpack it and run its
+  "Install AETHER AR.cmd" -- Setup finds this install, keeps your memory card and settings,
+  and updates it.
+
+REMOVE
+$remove
+
+Your memory card (saves) is in games\bt3\savedata in this folder.
+"@
+try { [IO.File]::WriteAllText((Join-Path $root 'AETHER AR - START HERE.txt'), ($here -replace "`r?`n", "`r`n")) } catch { Say "could not write 'AETHER AR - START HERE.txt' ($($_.Exception.Message))" }
+
+# 6. Its place in Windows (ar\shortcuts.ps1): "AETHER AR" on the desktop and in the Start menu (type AETHER), with its
+#    own icon and a guard that says so when the folder was moved, and the entry in Settings > Apps that removes it
+#    (ar\uninstall.ps1). Not for a test install (-NoShortcuts): it would take the player's entries over.
+if (-not $NoShortcuts) {
+    $made = @(Set-AetherShortcuts $ar)
+    $where = @()
+    if ($made -contains (Join-Path ([Environment]::GetFolderPath('Desktop')) 'AETHER AR.lnk')) { $where += 'on the desktop' }
+    if ($made -contains (Join-Path ([Environment]::GetFolderPath('Programs')) 'AETHER AR.lnk')) { $where += 'in the Start menu' }
+    if ($where.Count) { Say "shortcut 'AETHER AR' $($where -join ' and ')" } else { Say "the shortcuts could not be written -- start AETHER AR with 'AETHER AR.cmd' in $root" }
+    try { Register-AetherApp $ar; Say "Settings > Apps: 'AETHER AR' (Uninstall removes it)" }
+    catch { Say "the entry in Settings > Apps could not be written ($($_.Exception.Message)) -- ar\uninstall.ps1 removes AETHER AR too" }
+}
+Say "done. Open 'AETHER AR' (desktop or Start menu) and press Start, then put the headset on and turn on Link."
diff --git a/ar/make-icon.ps1 b/ar/make-icon.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..d02e51a0bf5def561625f49199af70d5d643c76e
--- /dev/null
+++ b/ar/make-icon.ps1
@@ -0,0 +1,114 @@
+# AETHER AR -- draws the app icon, ar\aether-ar.ico: a dark disc with a blue ring and the AETHER ligature "Æ" (blue
+# 30,144,255 on the launcher's dark 24,26,32. No game or Bandai artwork in
+# it. The .ico is committed; this script is how it was made (run it again only to change the mark):
+#   powershell -File ar\make-icon.ps1 [-Out <file.ico>] [-Preview <file.png>]
+# Every frame (16, 32, 48, 256 px) is a 32-bit DIB with alpha, none is PNG: .NET Framework's System.Drawing.Icon (the
+# windows' title-bar icon in Windows PowerShell 5.1) throws on a PNG frame, the shell reads both.
+param([string]$Out = (Join-Path $PSScriptRoot 'aether-ar.ico'), [string]$Preview)
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Drawing
+$blue = [System.Drawing.Color]::FromArgb(30, 144, 255)
+$dark = [System.Drawing.Color]::FromArgb(24, 26, 32)
+
+function Draw-Mark([int]$s) {
+    $bmp = New-Object System.Drawing.Bitmap($s, $s, [System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
+    $g = [System.Drawing.Graphics]::FromImage($bmp)
+    $g.SmoothingMode = 'AntiAlias'; $g.PixelOffsetMode = 'HighQuality'; $g.CompositingQuality = 'HighQuality'
+    $g.Clear([System.Drawing.Color]::Transparent)
+    # the ring: thicker on its own at the small sizes, so it still reads as a ring at 16 px
+    $t = [Math]::Max(1.6, $s * 0.085)
+    $inset = $t / 2 + 0.5
+    $d = $s - 2 * $inset
+    $brush = New-Object System.Drawing.SolidBrush($dark)
+    $g.FillEllipse($brush, [single]$inset, [single]$inset, [single]$d, [single]$d); $brush.Dispose()
+    $pen = New-Object System.Drawing.Pen($blue, [single]$t)
+    $g.DrawEllipse($pen, [single]$inset, [single]$inset, [single]$d, [single]$d); $pen.Dispose()
+    # "Æ" (one glyph, so it can be larger than the two letters were): its outline, scaled to a cap height and centred
+    # on its real extent (not the font's line box)
+    $path = New-Object System.Drawing.Drawing2D.GraphicsPath
+    $fam = New-Object System.Drawing.FontFamily('Segoe UI')
+    $path.AddString([string][char]0x00C6, $fam, [int][System.Drawing.FontStyle]::Bold, 100, (New-Object System.Drawing.PointF(0, 0)), [System.Drawing.StringFormat]::GenericTypographic)
+    $b = $path.GetBounds()
+    # (at 16 px the glyph's width is the limit: wider, it touched the ring)
+    $capH = $s * $(if ($s -le 16) { 0.44 } elseif ($s -le 32) { 0.42 } else { 0.40 })
+    $k = [Math]::Min($capH / $b.Height, ($s * $(if ($s -le 16) { 0.54 } else { 0.62 })) / $b.Width)
+    $m = New-Object System.Drawing.Drawing2D.Matrix
+    $m.Translate([single](($s - $b.Width * $k) / 2), [single](($s - $b.Height * $k) / 2))
+    $m.Scale([single]$k, [single]$k)
+    $m.Translate([single](-$b.X), [single](-$b.Y))
+    $path.Transform($m)
+    $tb = New-Object System.Drawing.SolidBrush($blue)
+    $g.FillPath($tb, $path); $tb.Dispose(); $path.Dispose(); $m.Dispose(); $fam.Dispose()
+    $g.Dispose()
+    return $bmp
+}
+
+# one icon image: BITMAPINFOHEADER (height doubled), the BGRA rows bottom-up, then the 1-bit AND mask (1 = transparent)
+function Dib-Bytes($bmp) {
+    $w = $bmp.Width; $h = $bmp.Height
+    $rect = New-Object System.Drawing.Rectangle(0, 0, $w, $h)
+    $data = $bmp.LockBits($rect, 'ReadOnly', [System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
+    $px = New-Object byte[] ($data.Stride * $h)
+    [System.Runtime.InteropServices.Marshal]::Copy($data.Scan0, $px, 0, $px.Length)
+    $stride = $data.Stride; $bmp.UnlockBits($data)
+    $maskRow = [int]([Math]::Ceiling($w / 32.0) * 4)
+    $ms = New-Object System.IO.MemoryStream
+    $bw = New-Object System.IO.BinaryWriter($ms)
+    $bw.Write([int]40); $bw.Write([int]$w); $bw.Write([int]($h * 2)); $bw.Write([int16]1); $bw.Write([int16]32)
+    $bw.Write([int]0); $bw.Write([int]($w * $h * 4 + $maskRow * $h)); $bw.Write([int]0); $bw.Write([int]0); $bw.Write([int]0); $bw.Write([int]0)
+    for ($y = $h - 1; $y -ge 0; $y--) { $bw.Write($px, $y * $stride, $w * 4) }
+    for ($y = $h - 1; $y -ge 0; $y--) {
+        $row = New-Object byte[] $maskRow
+        for ($x = 0; $x -lt $w; $x++) { if ($px[$y * $stride + $x * 4 + 3] -eq 0) { $row[$x -shr 3] = $row[$x -shr 3] -bor (0x80 -shr ($x -band 7)) } }
+        $bw.Write($row)
+    }
+    $bw.Flush(); $bytes = $ms.ToArray(); $bw.Dispose()
+    return ,$bytes
+}
+
+$sizes = 16, 32, 48, 256
+$imgs = @(); $bmps = @()
+foreach ($s in $sizes) { $bm = Draw-Mark $s; $bmps += $bm; $imgs += ,(Dib-Bytes $bm) }
+$fs = [System.IO.File]::Create($Out)
+$w = New-Object System.IO.BinaryWriter($fs)
+$w.Write([int16]0); $w.Write([int16]1); $w.Write([int16]$sizes.Count)
+$off = 6 + 16 * $sizes.Count
+for ($i = 0; $i -lt $sizes.Count; $i++) {
+    $s = $sizes[$i]; $e = [byte]$(if ($s -ge 256) { 0 } else { $s })
+    $w.Write($e); $w.Write($e); $w.Write([byte]0); $w.Write([byte]0); $w.Write([int16]1); $w.Write([int16]32)
+    $w.Write([int]$imgs[$i].Length); $w.Write([int]$off); $off += $imgs[$i].Length
+}
+foreach ($b in $imgs) { $w.Write($b) }
+$w.Dispose()
+
+# the checks that matter: .NET Framework loads it (the windows set it with New-Object System.Drawing.Icon), and
+# Windows' own loader finds every frame at its size (.NET Framework cannot pick the 256 one: it reads its size byte 0
+# as 0, not 256)
+$ic = New-Object System.Drawing.Icon($Out); $ic.Dispose()
+Add-Type -Namespace AetherIcon -Name U -MemberDefinition '[DllImport("user32.dll", CharSet = CharSet.Unicode)] public static extern IntPtr LoadImage(IntPtr hinst, string name, uint type, int cx, int cy, uint load); [DllImport("user32.dll")] public static extern bool DestroyIcon(IntPtr h);'
+function Load-Frame([int]$s) {   # (IMAGE_ICON, LR_LOADFROMFILE)
+    $h = [AetherIcon.U]::LoadImage([IntPtr]::Zero, $Out, 1, $s, $s, 0x10)
+    if ($h -eq [IntPtr]::Zero) { throw "Windows could not load the $s px frame" }
+    $i = [System.Drawing.Icon]::FromHandle($h); $bm = $i.ToBitmap(); [void][AetherIcon.U]::DestroyIcon($h)
+    if ($bm.Width -ne $s) { throw "the $s px frame came back as $($bm.Width) px" }
+    return $bm
+}
+foreach ($s in $sizes) { (Load-Frame $s).Dispose() }
+"icon: $Out ({0:N0} bytes; frames {1})" -f (Get-Item -LiteralPath $Out).Length, ($sizes -join '/')
+
+if ($Preview) {   # every frame as Windows loads it from the file, at its own size, on a light and a dark strip
+    $pv = New-Object System.Drawing.Bitmap(400, 560)
+    $g = [System.Drawing.Graphics]::FromImage($pv)
+    $g.Clear([System.Drawing.Color]::FromArgb(240, 240, 240))
+    $g.FillRectangle((New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(32, 32, 32))), 0, 280, 400, 280)
+    $frames = @(foreach ($s in $sizes) { Load-Frame $s })
+    foreach ($band in 0, 280) {
+        $x = 12
+        for ($i = 0; $i -lt 3; $i++) { $g.DrawImageUnscaled($frames[$i], $x, $band + 12); $x += $frames[$i].Width + 12 }
+        $g.DrawImageUnscaled($frames[3], 136, $band + 12)
+    }
+    $g.Dispose(); $pv.Save($Preview, [System.Drawing.Imaging.ImageFormat]::Png); $pv.Dispose()
+    foreach ($fr in $frames) { $fr.Dispose() }
+    "preview: $Preview"
+}
+foreach ($bm in $bmps) { $bm.Dispose() }
