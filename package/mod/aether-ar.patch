+        g.views[0] = { XR_TYPE_VIEW }; g.views[1] = { XR_TYPE_VIEW };
+        const XrResult viewsResult = xrLocateViews(g.session, &li, &vs, 2, &n, g.views);
+        g.viewsValid = XR_SUCCEEDED(viewsResult) && n == 2 &&
+                       (vs.viewStateFlags & XR_VIEW_STATE_POSITION_VALID_BIT) &&
+                       (vs.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT);
